import { KeyZone, LayerRow, MeterChannel, OutputBus, MeasurementState } from "../display/types.slint";
import { AudioFixtures } from "AudioFixtures.slint";

export struct PadFixture {
    note: int, name: string, mapped: bool, missing: bool, selected: bool,
    layers: int, alternates: int, choke-group: int, choked: bool,
    activity: float, velocity: float,
}

// Catalog-only examples. Measurements are deliberate snapshots, never live IO.
export global DisplayFixtures {
    in property <[PadFixture]> pads: [
        { note:36, name:"Kick", mapped:true, missing:false, selected:true, layers:2, alternates:3, choke-group:0, choked:false, activity:0.6, velocity:0.86 },
