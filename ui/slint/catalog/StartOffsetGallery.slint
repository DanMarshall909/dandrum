import { Tokens } from "../theme.slint";
import { Panel } from "../layout/Panel.slint";
import { WaveformPanel } from "../display/WaveformPanel.slint";
import { Slider } from "../controls/Slider.slint";
import { AudioFixtures } from "AudioFixtures.slint";

export component StartOffsetGallery inherits Panel {
    in property <string> state: "default";
    callback event(string);
    private property <float> offset: 0.25;
    title: "START OFFSET AND MODULATION"; summary: "Region-relative offset · Supplied depth";
    preferred-height: 278px; vertical-stretch: 0;
    VerticalLayout {
        spacing: 8px;
        WaveformPanel {
            height: 168px; state: "ready"; label: "advanced-break.wav";
            peaks: AudioFixtures.peaks; region-start: 0.2; region-end: 0.8;
            start-offset-visible: true; start-offset: root.offset;
            start-modulation-enabled: true; start-modulation-depth: 0.35;
            start-modulation-tint: Tokens.dd-mod-a; host-automated: root.state == "host";
            show-display-toggle: false;
        }
        HorizontalLayout {
            spacing: 20px;
            Slider {
                length: 240px; label: "START OFFSET"; minimum: 0; maximum: 1; step: 0.01; default-value: 0;
                value <=> root.offset; enabled: root.state != "disabled"; read-only: root.state == "prepared";
                host-automated: root.state == "host";
                changed(value) => { root.event("Start offset → " + round(value * 100) + "% of region"); }
            }
            Text { text: "The rail ends at the region bound. Sliced views use their prepared slice flags."; color: Tokens.text-tertiary; font-family: Tokens.font-ui; font-size: 11px; wrap: word-wrap; }
        }
    }
}
