import { Tokens } from "../theme.slint";
import { ScopePoint } from "types.slint";

export component Scope inherits Rectangle {
    in property <[ScopePoint]> points;
    in property <string> state: "waiting";
    in property <string> label: "Waveform";
    in property <color> tint: Tokens.dd-paper-1;
    background: Tokens.dd-ink-0; clip: true; min-height: 60px;
    for value in [-0.5,0,0.5] : Rectangle { y: (1 - value) * parent.height / 2; width: 100%; height: 1px; background: Tokens.dd-line-1; }
    for point[index] in root.points : Path {
        visible: root.state == "ready" && index > 0;
        width: root.width; height: root.height; viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.tint; stroke-width: 1.5px;
        MoveTo { x: root.points[max(0,index - 1)].position.clamp(0,1) * root.width / 1px; y: (1 - root.points[max(0,index - 1)].value.clamp(-1,1)) * root.height / 2px; }
        LineTo { x: point.position.clamp(0,1) * root.width / 1px; y: (1 - point.value.clamp(-1,1)) * root.height / 2px; }
    }
    if root.state != "ready" || root.points.length == 0 : Text {
        width: 100%; height: 100%; text: "\{root.label} · \{root.state}";
        color: Tokens.dd-paper-3; font-family: Tokens.font-ui; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
    }
}
