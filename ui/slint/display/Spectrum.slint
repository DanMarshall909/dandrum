import { Tokens } from "../theme.slint";
import { SpectrumPoint } from "types.slint";

export component Spectrum inherits Rectangle {
    in property <[SpectrumPoint]> points;
    in property <float> floor-db: -120;
    in property <float> ceiling-db: 0;
    in property <string> state: "waiting";
    in property <string> low-frequency-label;
    in property <string> high-frequency-label;
    background: Tokens.dd-ink-0; clip: true; min-height: 60px;
    for index in 4 : Rectangle { y: index * parent.height / 4; width: 100%; height: 1px; background: Tokens.dd-line-1; }
    for point[index] in root.points : Path {
        visible: root.state == "ready" && index > 0;
        width: root.width; height: root.height; viewbox-width: root.width / 1px; viewbox-height: root.height / 1px; stroke: Tokens.dd-vermilion; stroke-width: 1.5px;
        MoveTo { x: root.points[max(0,index - 1)].position.clamp(0,1) * root.width / 1px; y: (1 - ((root.points[max(0,index - 1)].decibels - root.floor-db) / max(0.001,root.ceiling-db - root.floor-db)).clamp(0,1)) * root.height / 1px; }
        LineTo { x: point.position.clamp(0,1) * root.width / 1px; y: (1 - ((point.decibels - root.floor-db) / max(0.001,root.ceiling-db - root.floor-db)).clamp(0,1)) * root.height / 1px; }
    }
    if root.state != "ready" || root.points.length == 0 : Text {
        width: 100%; height: 100%; text: "Spectrum · \{root.state}";
        color: Tokens.dd-paper-3; font-family: Tokens.font-ui; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
    }
    if root.state == "ready" : Text { x: 5px; y: parent.height - 18px; text: root.low-frequency-label; color: Tokens.dd-paper-3; font-family: Tokens.font-value; font-size: 11px; }
    if root.state == "ready" : Text { x: parent.width - self.width - 5px; y: parent.height - 18px; text: root.high-frequency-label; color: Tokens.dd-paper-3; font-family: Tokens.font-value; font-size: 11px; }
}
