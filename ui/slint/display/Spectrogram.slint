import { Tokens } from "../theme.slint";
import { SpectralCell } from "types.slint";
import { SpectralPalette } from "SpectralPalette.slint";

export component Spectrogram inherits Rectangle {
    in property <[SpectralCell]> cells;
    in property <float> floor-db: -120;
    in property <float> ceiling-db: 0;
    in property <string> state: "unavailable";
    in property <string> low-frequency-label;
    in property <string> high-frequency-label;
    background: Tokens.dd-ink-0; clip: true;
    for cell in root.cells : Rectangle {
        visible: root.state == "ready";
        x: cell.x.clamp(0,1) * root.width;
        y: (1 - (cell.y + cell.height).clamp(0,1)) * root.height;
        width: max(1px, cell.width.clamp(0,1) * root.width + 0.25px);
        height: max(1px, cell.height.clamp(0,1) * root.height + 0.25px);
        background: SpectralPalette.color-for((cell.decibels - root.floor-db) / max(0.001,root.ceiling-db - root.floor-db));
    }
    if root.state != "ready" || root.cells.length == 0 : Text {
        text: root.state == "loading" ? "Preparing spectrum…" : root.state == "waiting" ? "Waiting for spectral data" : root.state == "gap" ? "Spectral history gap" : root.state == "error" ? "Spectral analysis failed" : "Spectral data unavailable";
        font-family: Tokens.font-ui; font-size: 13px; color: root.state == "error" ? Tokens.dd-error : Tokens.dd-paper-3;
        horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%;
    }
    if root.state == "ready" : Text { x: 5px; y: 4px; text: root.high-frequency-label; color: Tokens.dd-paper-3; font-family: Tokens.font-value; font-size: 11px; }
    if root.state == "ready" : Text { x: 5px; y: parent.height - 18px; text: root.low-frequency-label; color: Tokens.dd-paper-3; font-family: Tokens.font-value; font-size: 11px; }
}
