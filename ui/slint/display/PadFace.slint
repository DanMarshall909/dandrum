import { Tokens } from "../theme.slint";

export component PadFace inherits Rectangle {
    in property <bool> selected;
    in property <bool> mapped;
    in property <bool> hovered;
    in property <bool> pressed;
    in property <bool> disabled;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.selected ? Tokens.dd-vermilion : Tokens.dd-line-2;
    background: !root.mapped ? Tokens.dd-ink-2 : root.disabled ? Tokens.dd-ink-3
        : root.pressed ? Tokens.dd-ink-6 : root.hovered ? Tokens.dd-pad-hover : Tokens.dd-ink-4;
    if root.selected : Rectangle {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
        border-radius: 2px; border-width: 1px; border-color: Tokens.dd-vermilion;
    }
    if !root.mapped : Rectangle {
        x: 7px; y: parent.height - 8px; width: parent.width - 14px; height: 1px;
        for index in 6 : Rectangle {
            x: index * parent.width / 6; width: parent.width / 12; height: 1px;
            background: Tokens.dd-line-2;
        }
    }
}
