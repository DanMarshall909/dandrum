import { Tokens } from "../theme.slint";
import { WaveBucket } from "types.slint";

export component WaveformTrace inherits Rectangle {
    in property <[WaveBucket]> peaks;
    in property <float> region-start;
    in property <float> region-end: 1;
    clip: true;
    Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: Tokens.dd-line-1; }
    for bucket[index] in root.peaks : Rectangle {
        property <float> position: (index + 0.5) / max(1, root.peaks.length);
        x: index / max(1, root.peaks.length) * root.width;
        y: (1 - bucket.maximum.clamp(-1,1)) * root.height / 2;
        width: max(1px, root.width / max(1, root.peaks.length) + 0.25px);
        height: max(1px, (bucket.maximum.clamp(-1,1) - bucket.minimum.clamp(-1,1)) * root.height / 2);
        background: self.position >= root.region-start && self.position <= root.region-end
            ? Tokens.color-waveform-region : Tokens.color-waveform.with-alpha(0.28);
    }
}
