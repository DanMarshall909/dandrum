import { Tokens } from "../theme.slint";
import { FocusRing } from "../foundation/FocusRing.slint";
import { PadFace } from "PadFace.slint";
import { PadActivity } from "PadActivity.slint";
import { VelocityBar } from "VelocityBar.slint";
import { LayerTicks } from "LayerTicks.slint";
import { AlternateDots } from "AlternateDots.slint";

export component PadCell inherits FocusScope {
    in property <int> note: 60;
    in property <string> name;
    in property <bool> mapped;
    in property <bool> selected;
    in property <float> activity;
    in property <float> velocity;
    in property <int> layers;
    in property <int> active-layer: -1;
    in property <int> alternates;
    in property <int> active-alternate: -1;
    in property <int> choke-group;
    in property <bool> choked;
    in property <bool> missing;
    in property <bool> compact;
    in property <length> size: root.compact ? 52px : 76px;
    in property <string> generation;
    private property <bool> held;
    private property <int> held-note: -1;
    callback triggered(int, int);
    callback released(int);
    callback selected-note(int);
    width: max(44px,root.size);
    height: max(44px,root.size);
    accessible-role: button;
    accessible-label: "\{root.name == "" ? "Empty pad" : root.name}, MIDI \{root.note}";
    accessible-description: root.missing ? "Sample unavailable" : root.mapped ? "Top of pad plays louder. Space or Enter auditions." : "Empty; selectable and silent";
    accessible-enabled: root.enabled;
    accessible-action-default => { root.press(0.8); root.release-note(); }
    public function press(velocity: float) {
        if !root.enabled { return; }
        root.selected-note(root.note);
        if root.mapped && !root.missing && !root.held {
            root.held = true;
            root.held-note = root.note;
            root.triggered(root.note, round(velocity.clamp(0, 1) * 126) + 1);
        }
    }
    public function release-note() {
        if root.held { let note = root.held-note; root.held = false; root.held-note = -1; root.released(note); }
    }
    changed enabled => { if !root.enabled { root.release-note(); } }
    changed visible => { if !root.visible { root.release-note(); } }
    changed generation => { root.release-note(); }
    changed mapped => { if !root.mapped { root.release-note(); } }
    focus-lost(reason) => { root.release-note(); }
    key-pressed(event) => {
        if event.text == " " || event.text == Key.Return { root.press(0.8); return accept; }
        if event.text == Key.Escape { root.release-note(); return accept; }
        return reject;
    }
    key-released(event) => {
        if event.text == " " || event.text == Key.Return { root.release-note(); return accept; }
        return reject;
    }
    PadFace { width: 100%; height: 100%; selected: root.selected; mapped: root.mapped; hovered: input.has-hover; pressed: root.held; disabled: !root.enabled; }
    PadActivity { width: 100%; height: 100%; level: root.activity; }
    Text {
        x: 7px; y: 5px; width: parent.width - 14px; height: 14px;
        text: "\{root.note}"; font-family: Tokens.font-value; font-size: 11px;
        color: root.enabled ? Tokens.dd-paper-2 : Tokens.dd-paper-4;
    }
    if root.choke-group > 0 : Text {
        x: parent.width - 24px; y: 5px; width: 18px; height: 14px;
        text: "G\{root.choke-group}"; font-family: Tokens.font-value; font-size: 11px;
        color: root.choked ? Tokens.dd-paper-1 : Tokens.dd-paper-3;
        horizontal-alignment: right;
    }
    title := Text {
        x: 7px; y: root.compact ? 20px : 25px; width: parent.width - 14px;
        height: root.compact ? 14px : 25px; wrap: word-wrap; overflow: elide;
        text: root.missing ? "Missing" : root.mapped ? root.name : "Empty";
        font-family: Tokens.font-ui; font-size: root.compact ? 11px : 13px; font-weight: 600;
        color: root.missing ? Tokens.dd-error : !root.mapped || !root.enabled ? Tokens.dd-paper-4 : Tokens.dd-paper-1;
    }
    if root.choked : Rectangle {
        x: title.x; y: title.y + 8px; width: title.width; height: 1px; background: Tokens.dd-paper-2;
    }
    if root.mapped : VelocityBar { x: 7px; y: parent.height - 15px; width: parent.width - 14px; value: root.velocity; }
    if root.mapped : LayerTicks { x: 7px; y: parent.height - 8px; width: (parent.width - 14px) / 2; count: root.layers; active-index: root.active-layer; }
    if root.mapped : AlternateDots { x: parent.width / 2; y: parent.height - 8px; width: (parent.width - 14px) / 2; count: root.alternates; active-index: root.active-alternate; }
    FocusRing { width: 100%; height: 100%; active: root.has-focus; }
    input := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.focus(); root.press(1 - self.mouse-y / max(1px, self.height));
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.release-note(); }
        }
    }
}
