import { Tokens } from "../theme.slint";

export component FadeOverlay inherits Rectangle {
    in property <float> region-start;
    in property <float> region-end: 1;
    // Fade lengths are fractions of the region, not the entire asset.
    in property <float> fade-in;
    in property <float> fade-out;
    private property <float> left: root.region-start.clamp(0,1);
    private property <float> right: root.region-end.clamp(root.left,1);
    if root.fade-in > 0 : Path {
        width: 100%; height: 100%; viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        fill: Tokens.dd-ink-0.with-alpha(0.55);
        MoveTo { x: root.left * root.width / 1px; y: 0; }
        LineTo { x: root.left * root.width / 1px; y: root.height / 1px; }
        LineTo { x: (root.left + root.fade-in.clamp(0,1) * (root.right - root.left)) * root.width / 1px; y: 0; }
        Close {}
    }
    if root.fade-in > 0 : Path {
        width: 100%; height: 100%; viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: Tokens.dd-paper-1; stroke-width: 1.5px;
        MoveTo { x: root.left * root.width / 1px; y: root.height / 1px; }
        LineTo { x: (root.left + root.fade-in.clamp(0,1) * (root.right - root.left)) * root.width / 1px; y: 0; }
    }
    if root.fade-out > 0 : Path {
        width: 100%; height: 100%; viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        fill: Tokens.dd-ink-0.with-alpha(0.55);
        MoveTo { x: root.right * root.width / 1px; y: 0; }
        LineTo { x: root.right * root.width / 1px; y: root.height / 1px; }
        LineTo { x: (root.right - root.fade-out.clamp(0,1) * (root.right - root.left)) * root.width / 1px; y: 0; }
        Close {}
    }
    if root.fade-out > 0 : Path {
        width: 100%; height: 100%; viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: Tokens.dd-paper-1; stroke-width: 1.5px;
        MoveTo { x: root.right * root.width / 1px; y: root.height / 1px; }
        LineTo { x: (root.right - root.fade-out.clamp(0,1) * (root.right - root.left)) * root.width / 1px; y: 0; }
    }
}
