import { Tokens } from "../theme.slint";
import { OutputBus } from "types.slint";
import { OutputBusRow } from "OutputBusRow.slint";
import { ScrollViewport } from "../layout/ScrollViewport.slint";

export component OutputBusses inherits Rectangle {
    in property <[OutputBus]> busses;
    in property <string> generation;
    in property <string> title: "Output buses";
    in property <bool> compact: root.width < 470px;
    callback selected(string);
    // Only the host may acknowledge the channel/generation/ticket and publish
    // the resulting measurement; clicking never clears a local clip latch.
    callback reset-clip(string,string,string,string);
    min-height: 70px; preferred-height: 200px; preferred-width: 420px; horizontal-stretch: 1;
    Text { x: 0px; y: 0px; height: 20px; width: 100%; text: root.title; font-family: Tokens.font-ui; font-size: 13px; font-weight: 600; color: Tokens.dd-paper-2; }
    if root.busses.length == 0 : Text {
        x: 0px; y: 24px; width: max(0px,parent.width - 8px); height: max(0px,parent.height - 24px);
        text: "Output metadata unavailable"; font-family: Tokens.font-ui; font-size: 12px; color: Tokens.dd-paper-3;
        horizontal-alignment: center; vertical-alignment: center;
    }
    scroll := ScrollViewport {
        x: 0px; y: 24px; width: parent.width; height: max(0px,parent.height - 24px);
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            x: 0px; y: 0px; width: max(0px,scroll.width - 8px); spacing: 4px;
            for bus in root.busses : OutputBusRow {
                bus: bus; generation: root.generation; compact: root.compact;
                selected(id) => { root.selected(id); }
                reset-clip(bus,channel,generation,ticket) => { root.reset-clip(bus,channel,generation,ticket); }
            }
        }
    }
}
