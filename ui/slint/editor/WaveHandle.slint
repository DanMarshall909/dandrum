import { Tokens } from "../theme.slint";
import { GesturePhases } from "ParameterConstants.slint";
import { EditorTheme } from "Theme.slint";
export component WaveHandle inherits FocusScope {
    in property <string> field;
    in property <string> label;
    in property <float> position;
    in property <length> plot-width;
    in property <length> plot-height;
    in property <color> tint: EditorTheme.paper-2;
    in property <bool> top;
    private property <float> initial;
    private property <length> anchor;
    private property <bool> dragging;
    callback gesture(string, int, float);
    width: Tokens.editor-display-wave-handle-width; height: root.top ? root.plot-height : Tokens.editor-display-wave-handle-hit-height; y: root.top ? 0px : root.plot-height - Tokens.editor-display-wave-handle-hit-height;
    accessible-role: slider; accessible-label: root.label; accessible-value: root.position; accessible-value-minimum: 0; accessible-value-maximum: 1;
    focus-on-tab-navigation: true; focus-on-click: true;
    focus-lost(reason) => { root.finish(true); }
    function finish(cancel: bool) { if root.dragging { root.dragging = false; root.gesture(root.field, cancel ? GesturePhases.cancel : GesturePhases.commit, cancel ? root.initial : root.position); } }
    key-pressed(event) => {
        if event.text == Key.Escape { root.finish(true); return accept; }
        if event.text == Key.LeftArrow || event.text == Key.RightArrow {
            root.gesture(root.field, GesturePhases.begin, root.position);
            root.gesture(root.field, GesturePhases.update, (root.position + (event.text == Key.LeftArrow ? -Tokens.editor-display-wave-keyboard-step : Tokens.editor-display-wave-keyboard-step)).clamp(0,1));
            root.gesture(root.field, GesturePhases.commit, root.position); return accept;
        }
        return reject;
    }
    Rectangle { x: Tokens.editor-display-wave-handle-line-offset; width: 1px; height: parent.height; background: root.tint; }
    Rectangle { x: Tokens.space-1; y: root.top ? 0px : parent.height - Tokens.editor-display-wave-handle-flag-height; width: Tokens.editor-display-wave-handle-flag-width; height: Tokens.editor-display-wave-handle-flag-height; border-radius: 1px; background: root.tint; }
    touch := TouchArea { y: root.top ? 0px : parent.height - Tokens.editor-display-wave-handle-hit-height; height: root.top ? parent.height : Tokens.editor-display-wave-handle-hit-height; mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.focus(); root.initial = root.position; root.anchor = self.absolute-position.x + self.mouse-x; root.dragging = true; root.gesture(root.field, GesturePhases.begin, root.position); }
            else if event.kind == PointerEventKind.up { root.finish(false); }
            else if event.kind == PointerEventKind.cancel { root.finish(true); }
        }
        moved => { if root.dragging && abs(root.plot-width) > 0px { root.gesture(root.field, GesturePhases.update, (root.initial + (self.absolute-position.x + self.mouse-x - root.anchor) / root.plot-width).clamp(0,1)); } }
    }
}
