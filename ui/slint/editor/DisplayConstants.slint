export global DisplayStates {
    out property <string> empty: Tokens.editor-display-state-empty;
    out property <string> loading: Tokens.editor-display-state-loading;
    out property <string> missing: Tokens.editor-display-state-missing;
    out property <string> unsupported: Tokens.editor-display-state-unsupported;
}

export global DisplayModes {
    out property <string> wave: Tokens.editor-display-mode-wave;
    out property <string> spectral: Tokens.editor-display-mode-spectral;
    out property <string> lp: Tokens.editor-display-mode-lp;
    out property <string> hp: Tokens.editor-display-mode-hp;
    out property <string> bp: Tokens.editor-display-mode-bp;
    out property <string> notch: Tokens.editor-display-mode-notch;
