export global WaveFields {
    out property <string> region-start: Tokens.editor-display-field-region-start;
    out property <string> region-end: Tokens.editor-display-field-region-end;
    out property <string> fade-in: Tokens.editor-display-field-fade-in;
    out property <string> fade-out: Tokens.editor-display-field-fade-out;
    out property <string> loop-start: Tokens.editor-display-field-loop-start;
    out property <string> loop-end: Tokens.editor-display-field-loop-end;
    out property <string> loop-crossfade: Tokens.editor-display-field-loop-crossfade;
}

// Array positions are a stable ADSR data contract, independent of visual theming.
export global EnvelopeStages {
    out property <int> attack: 0;
    out property <int> decay: 1;
    out property <int> sustain: 2;
    out property <int> release: 3;
}
