import { Tokens } from "../theme.slint";
// Shared musical protocol, rendering calibration and guide display defaults.
// Geometry and text are generated from the cross-renderer token authority.
export global MusicalConstants {
    out property <int> notes-per-octave: Tokens.editor-musical-notes-per-octave;
    out property <int> white-per-octave: Tokens.editor-musical-white-per-octave;
    out property <int> black-per-octave: Tokens.editor-musical-black-per-octave;
    out property <int> midi-minimum: Tokens.editor-musical-midi-minimum;
    out property <int> midi-maximum: Tokens.editor-musical-midi-maximum;
    out property <int> velocity-minimum: Tokens.editor-musical-velocity-minimum;
    out property <int> velocity-maximum: Tokens.editor-musical-velocity-maximum;
    out property <int> audition-velocity: Tokens.editor-musical-audition-velocity;
    out property <int> key-velocity-floor: Tokens.editor-musical-key-velocity-floor;
    out property <int> key-velocity-span: Tokens.editor-musical-key-velocity-span;
    out property <int> octave-label-offset: Tokens.editor-musical-octave-label-offset;
    out property <int> mapped-low: Tokens.editor-musical-mapped-low;
    out property <int> mapped-high: Tokens.editor-musical-mapped-high;
    out property <int> overview-high: Tokens.editor-musical-overview-high;
    out property <int> overview-note-count: Tokens.editor-musical-overview-note-count;
    out property <int> base-note: Tokens.editor-musical-base-note;
    out property <int> white-key-count: Tokens.editor-musical-white-key-count;
    out property <int> black-key-count: Tokens.editor-musical-black-key-count;
    out property <int> sounding-capacity: Tokens.editor-musical-sounding-capacity;
    out property <int> pc-key-count: Tokens.editor-musical-pc-key-count;
    out property <int> default-key-width: Tokens.editor-musical-default-key-width;
    out property <int> fit-key-width-minimum: Tokens.editor-musical-fit-key-width-minimum;
    out property <int> key-width-minimum: Tokens.editor-musical-key-width-minimum;
    out property <int> key-width-maximum: Tokens.editor-musical-key-width-maximum;
    out property <int> key-zoom-step: Tokens.editor-musical-key-zoom-step;
    out property <int> pad-minimum-size: Tokens.editor-musical-pad-minimum-size;
    out property <int> pad-maximum-size: Tokens.editor-musical-pad-maximum-size;
    out property <int> pad-zoom-minimum: Tokens.editor-musical-pad-zoom-minimum;
    out property <int> pad-zoom-maximum: Tokens.editor-musical-pad-zoom-maximum;
    out property <int> pad-zoom-step: Tokens.editor-musical-pad-zoom-step;
    out property <int> pad-visible-count: Tokens.editor-musical-pad-visible-count;
    out property <int> pad-minimum-rows: Tokens.editor-musical-pad-minimum-rows;
    out property <int> pad-compact-threshold: Tokens.editor-musical-pad-compact-threshold;
    out property <float> black-key-offset: Tokens.editor-musical-black-key-offset;
    out property <float> black-key-width: Tokens.editor-musical-black-key-width;
    out property <float> black-key-height: Tokens.editor-musical-black-key-height;
    out property <float> pad-audition-strength: Tokens.editor-musical-pad-audition-strength;
    out property <float> pad-pointer-bias: Tokens.editor-musical-pad-pointer-bias;
}

export global PitchNames {
    out property <[string]> names: ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"];
    out property <[int]> white-notes: [0, 2, 4, 5, 7, 9, 11];
    out property <[int]> black-notes: [1, 3, 6, 8, 10];
    out property <[int]> white-indices: [0, 0, 1, 1, 2, 3, 3, 4, 4, 5, 5, 6];
    out property <[string]> pc-labels: ["A", "W", "S", "E", "D", "F", "T", "G", "Y", "H", "U", "J", "K"];
    out property <[int]> velocity-grid: [
        Tokens.editor-display-velocity-low-label,
        Tokens.editor-display-velocity-middle-label,
        Tokens.editor-display-velocity-high-label
    ];
    out property <[int]> overview-velocity-labels: [
        MusicalConstants.velocity-maximum,
        Tokens.editor-display-velocity-high-label,
        Tokens.editor-display-velocity-middle-label,
        Tokens.editor-display-velocity-low-label,
        MusicalConstants.velocity-minimum
    ];
    out property <[string]> envelope-handles: ["attack", "decay", "sustain", "release"];
}

export global Ranges {
    out property <float> percentage: Tokens.editor-display-percent-scale;
    out property <float> epsilon: Tokens.editor-display-epsilon;
    out property <float> time-decimals: Tokens.editor-display-time-decimal-scale;
}

