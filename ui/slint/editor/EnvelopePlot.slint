import { Tokens } from "../theme.slint";
import { PitchNames, GraphMetrics, EnvelopeStages } from "DisplayConstants.slint";
import { GesturePhases } from "ParameterConstants.slint";
import { EditorTheme } from "Theme.slint";
import { PlotParameter } from "types.slint";
// Generic ADSR coordinates; callbacks leave IDs, related edits and Undo to the host.
export component EditorEnvelopePlot inherits Rectangle {
 in property <bool> enabled: true;
 in property <[PlotParameter]> parameters;
 in property <float> attack-scale: GraphMetrics.envelope-attack-scale;
 in property <float> decay-scale: GraphMetrics.envelope-decay-scale;
 in property <float> release-scale: GraphMetrics.envelope-release-scale;
 in property <float> note-off-position: GraphMetrics.envelope-note-off-position;
 out property <bool> dragging: root.active >= 0;
 out property <bool> interactive: root.enabled && root.parameters.length >= GraphMetrics.envelope-handle-count;
 callback gesture(int,int,float) -> bool;
 callback related-preview(int,float);
 in property <string> title;
 private property <float> attack: root.parameters[EnvelopeStages.attack].value/max(1,root.attack-scale);
 private property <float> decay: root.parameters[EnvelopeStages.decay].value/max(1,root.decay-scale);
 private property <float> sustain: root.parameters[EnvelopeStages.sustain].value;
 private property <float> release: root.parameters[EnvelopeStages.release].value/max(1,root.release-scale);
 private property <float> off: root.note-off-position;
 private property <int> active: -1;
 private property <bool> modified;
 background: EditorTheme.ink-0; border-width: Tokens.stroke-hairline; border-color: EditorTheme.line-1; border-radius: Tokens.radius-1;
 public pure function handle-x(index:int) -> float { return index == EnvelopeStages.attack ? root.attack : index == EnvelopeStages.decay ? min(root.off - GraphMetrics.envelope-sustain-gap,root.attack+root.decay) : index == EnvelopeStages.sustain ? root.off : min(1,root.off+root.release); }
 public pure function handle-y(index:int) -> float { return index == EnvelopeStages.attack ? 0 : index == EnvelopeStages.release ? 1 : 1 - root.sustain; }
 public function start(index:int) -> bool {
  if !root.interactive || index < 0 || index >= GraphMetrics.envelope-handle-count || root.dragging { return false; }
  root.modified=false;
  if root.gesture(index,GesturePhases.begin,root.parameters[index].value) { root.active=index; return true; }
  return false;
 }
 public function update(index:int,x:float,y:float) {
  if !root.interactive || root.active != index { return; }
  root.modified=true;
  if index == EnvelopeStages.attack { root.gesture(index,GesturePhases.update,x.clamp(GraphMetrics.envelope-attack-minimum,GraphMetrics.envelope-attack-maximum)*root.attack-scale); }
  else if index == EnvelopeStages.decay {
   root.gesture(index,GesturePhases.update,(x - root.attack).clamp(GraphMetrics.envelope-segment-minimum,max(GraphMetrics.envelope-segment-minimum,root.off - GraphMetrics.envelope-sustain-gap - root.attack))*root.decay-scale);
   root.related-preview(EnvelopeStages.sustain,(1 - y).clamp(0,1));
  } else if index == EnvelopeStages.sustain { root.gesture(index,GesturePhases.update,(1 - y).clamp(0,1)); }
  else { root.gesture(index,GesturePhases.update,(x - root.off).clamp(GraphMetrics.envelope-segment-minimum,1 - root.off)*root.release-scale); }
 }
 public function finish(index:int,cancel:bool) {
  if root.active == index { root.active=-1; root.gesture(index,cancel || !root.modified ? GesturePhases.cancel : GesturePhases.commit,root.parameters[index].value); }
 }
 changed enabled => { if !root.enabled && root.dragging { root.finish(root.active,true); } }
 Path { x: Tokens.space-4; y: Tokens.space-3; width: parent.width - Tokens.space-6; height: parent.height - Tokens.space-5; fill: EditorTheme.paper-1.with-alpha(GraphMetrics.curve-fill-alpha);
  viewbox-x: 0; viewbox-y: 0; viewbox-width: self.width/1px; viewbox-height: self.height/1px;
  MoveTo { x: 0; y: parent.height/1px; }
  LineTo { x: root.handle-x(EnvelopeStages.attack)*parent.width/1px; y: 0; }
  LineTo { x: root.handle-x(EnvelopeStages.decay)*parent.width/1px; y: root.handle-y(EnvelopeStages.decay)*parent.height/1px; }
  LineTo { x: root.off*parent.width/1px; y: root.handle-y(EnvelopeStages.sustain)*parent.height/1px; }
  LineTo { x: root.handle-x(EnvelopeStages.release)*parent.width/1px; y: parent.height/1px; }
  Close { }
 }
 Path { x: Tokens.space-4; y: Tokens.space-3; width: parent.width - Tokens.space-6; height: parent.height - Tokens.space-5; fill: transparent; stroke: EditorTheme.paper-1; stroke-width: Tokens.stroke-control;
  viewbox-x: 0; viewbox-y: 0; viewbox-width: self.width/1px; viewbox-height: self.height/1px;
  MoveTo { x: 0; y: parent.height/1px; }
  LineTo { x: root.handle-x(EnvelopeStages.attack)*parent.width/1px; y: 0; }
  LineTo { x: root.handle-x(EnvelopeStages.decay)*parent.width/1px; y: root.handle-y(EnvelopeStages.decay)*parent.height/1px; }
  LineTo { x: root.off*parent.width/1px; y: root.handle-y(EnvelopeStages.sustain)*parent.height/1px; }
  LineTo { x: root.handle-x(EnvelopeStages.release)*parent.width/1px; y: parent.height/1px; }
 }
 Rectangle { x: Tokens.space-4+root.off*(parent.width - Tokens.space-6); y: Tokens.space-3; width: 1px; height: parent.height - Tokens.space-5; background: EditorTheme.line-3; }
 for name[i] in PitchNames.envelope-handles : FocusScope {
  x: Tokens.space-4+root.handle-x(i)*(parent.width - Tokens.space-6) - Tokens.editor-display-envelope-handle-half; y: Tokens.space-3+root.handle-y(i)*(parent.height - Tokens.space-5) - Tokens.editor-display-envelope-handle-half; width: Tokens.editor-display-envelope-handle-size; height: Tokens.editor-display-envelope-handle-size;
  enabled: root.interactive; focus-on-tab-navigation: root.interactive; accessible-enabled: root.interactive; accessible-role: slider; accessible-label: root.title+" "+name+Tokens.editor-display-envelope-handle-suffix;
  accessible-value: root.parameters[i].value; accessible-value-minimum: root.parameters[i].minimum; accessible-value-maximum: root.parameters[i].maximum;
  focus-lost(reason) => { if reason == FocusReason.window-activation { root.finish(i,true); } }
  key-pressed(event) => {
   if event.text == Key.Escape { root.finish(i,true); return accept; }
   if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow {
    if root.start(i) {
     root.modified=true; let p=root.parameters[i];
     root.gesture(i,GesturePhases.update,(p.value+((event.text == Key.UpArrow || event.text == Key.RightArrow) ? p.step : -p.step)).clamp(p.minimum,p.maximum));
     root.finish(i,false);
    }
    return accept;
   }
   return reject;
  }
  Rectangle { border-radius: Tokens.radius-3; background: EditorTheme.ink-5; border-width: Tokens.stroke-hairline; border-color: parent.has-focus ? EditorTheme.accent : EditorTheme.paper-1; }
  TouchArea { mouse-cursor: grab; enabled: root.interactive;
   pointer-event(event) => {
    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.interactive { parent.focus(); root.start(i); }
    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.finish(i,false); }
    if event.kind == PointerEventKind.cancel { root.finish(i,true); }
   }
   moved => { if self.pressed { root.update(i,(parent.x+self.mouse-x - Tokens.space-4)/max(1px,root.width - Tokens.space-6),(parent.y+self.mouse-y - Tokens.space-3)/max(1px,root.height - Tokens.space-5)); } }
  }
 }
}

