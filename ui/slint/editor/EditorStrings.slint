import { Tokens } from "../theme.slint";
export global EditorStrings {
    out property <string> space: Tokens.editor-strings-space;
    out property <string> detail-separator: Tokens.editor-strings-detail-separator;
    out property <string> value-separator: Tokens.editor-strings-value-separator;
    out property <string> open-prefix: Tokens.editor-strings-open-prefix;
    out property <string> closed-prefix: Tokens.editor-strings-closed-prefix;
    out property <string> collapsed-suffix: Tokens.editor-strings-collapsed-suffix;
    out property <string> expanded-suffix: Tokens.editor-strings-expanded-suffix;
    out property <string> apply-text: Tokens.editor-strings-apply-text;
    out property <string> apply-prefix: Tokens.editor-strings-apply-prefix;
    out property <string> color-suffix: Tokens.editor-strings-color-suffix;
    out property <string> custom-color-suffix: Tokens.editor-strings-custom-color-suffix;
}
