import { Tokens } from "../tokens.slint";
export global ParameterActions {
    out property <string> modulation: Tokens.editor-control-action-modulation;
    out property <string> midi-learn: Tokens.editor-control-action-midi-learn;
    out property <string> macro-map: Tokens.editor-control-action-macro-map;
    out property <string> add-route: Tokens.editor-control-action-add-route;
