    out property <string> modulation-value-spacing: Tokens.editor-control-modulation-value-spacing;
    out property <string> more-assignments-prefix: Tokens.editor-control-more-assignments-prefix;
    public pure function modulation-label(name: string) -> string { return Tokens.editor-control-label-modulation-prefix + name; }
    public pure function midi-label(name: string) -> string { return Tokens.editor-control-label-midi-prefix + name; }
    public pure function map-label(name: string) -> string { return Tokens.editor-control-label-map-prefix + name + Tokens.editor-control-label-map-suffix; }
    public pure function reset-label(name: string) -> string { return Tokens.editor-control-label-reset-prefix + name + Tokens.editor-control-label-reset-suffix; }
    public pure function type-label(name: string) -> string { return Tokens.editor-control-label-type-prefix + name + Tokens.editor-control-label-value-suffix; }
    public pure function edit-label(name: string) -> string { return Tokens.editor-control-label-edit-prefix + name + Tokens.editor-control-label-value-suffix; }
    public pure function add-route-label(name: string) -> string { return Tokens.editor-control-label-add-route-prefix + name; }
    public pure function edit-route-label(name: string) -> string { return Tokens.editor-control-label-edit-route-prefix + name; }
    public pure function invert-route-label(name: string) -> string { return Tokens.editor-control-label-invert-route-prefix + name; }
    public pure function bypass-route-label(name: string) -> string { return Tokens.editor-control-label-bypass-route-prefix + name; }
    public pure function remove-route-label(name: string) -> string { return Tokens.editor-control-label-remove-route-prefix + name; }
}

