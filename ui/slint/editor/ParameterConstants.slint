    out property <string> invert-route: Tokens.editor-control-action-invert-route;
    out property <string> bypass-route: Tokens.editor-control-action-bypass-route;
    out property <string> remove-route: Tokens.editor-control-action-remove-route;
    out property <string> macro: Tokens.editor-control-action-macro;
}

