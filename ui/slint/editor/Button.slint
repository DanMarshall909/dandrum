import { Tokens } from "../theme.slint";
import { EditorTheme } from "Theme.slint";
import { EditorIcon } from "Icon.slint";
import { ActionArea } from "../controls/ActionArea.slint";
export component EditorButton inherits ActionArea {
    in property <string> text;
    in property <string> icon;
    in property <string> resolved-icon: root.icon;
    label: root.text;
    activate-on-press: true;
    in property <bool> selected;
    in property <bool> primary;
    in property <bool> ghost;
    in property <bool> compact;
    // SegmentedControl is neutral; ordinary selected actions retain accent styling.
    in property <bool> neutral-selection: false;
    in property <bool> caps: false;
    callback clicked();
    width: max(root.compact ? Tokens.editor-button-compact-size : Tokens.editor-button-minimum-width, label.preferred-width + (root.compact ? Tokens.editor-button-compact-label-padding : Tokens.editor-button-icon-label-advance) + (root.icon != "" && root.text != "" ? Tokens.editor-button-icon-label-advance : 0px)); height: root.compact ? Tokens.editor-button-compact-size : Tokens.editor-button-height;
    accessible-checked: root.selected;
    focus-on-tab-navigation: root.enabled; focus-on-click: root.enabled;
    activated => { root.clicked(); }
    // Explicit soft rings keep the guide's primary glow in software rendering,
