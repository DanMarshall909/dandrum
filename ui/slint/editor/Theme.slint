// Dynamic editor semantic roles. ThemeBinding applies the complete native palette.
import { Tokens } from "../theme.slint";

export global EditorTheme {
    in-out property <length> type-small: Tokens.editor-type-small;
    in-out property <length> type-caption: Tokens.editor-type-caption;
    in-out property <length> type-body: Tokens.editor-type-body;
    in-out property <length> type-control: Tokens.editor-type-control;
    in-out property <length> type-heading: Tokens.editor-type-heading;
    in-out property <image> window-lighting;
    in-out property <bool> soft: true;
    in-out property <bool> light: false;
    in-out property <bool> brushed: false;
    in-out property <color> accent: Tokens.editor-theme-default-accent;
    in-out property <color> accent-hi: Tokens.editor-theme-default-accent-hi;
    in-out property <color> accent-lo: Tokens.editor-theme-default-accent-lo;
    in-out property <color> accent-wash: Tokens.editor-theme-default-accent-wash;
    in-out property <color> secondary: Tokens.editor-theme-default-secondary;
    in-out property <color> secondary-wash: Tokens.editor-theme-default-secondary-wash;
    in-out property <color> host: Tokens.dd-host;
    in-out property <color> host-wash: Tokens.editor-theme-default-host-wash;
    in-out property <color> mod-a: Tokens.dd-mod-a;
    in-out property <color> mod-b: Tokens.dd-mod-b;
    in-out property <color> mod-c: Tokens.dd-mod-c;
    in-out property <color> mod-d: Tokens.dd-mod-d;
    public pure function mod-color(slot: int) -> color {
        return slot <= 0 ? EditorTheme.paper-3 : slot == 1 ? EditorTheme.mod-a : slot == 2 ? EditorTheme.mod-b : slot == 3 ? EditorTheme.mod-c : EditorTheme.mod-d;
    }
    in-out property <color> mod-wash: Tokens.editor-theme-default-mod-wash;
    in-out property <color> ok: Tokens.dd-ok;
    in-out property <color> warn: Tokens.dd-warn;
    in-out property <color> error: Tokens.dd-error;
    in-out property <color> ok-wash: Tokens.editor-theme-default-ok-wash;
    in-out property <color> warn-wash: Tokens.editor-theme-default-warn-wash;
    in-out property <color> error-wash: Tokens.editor-theme-default-error-wash;
    in-out property <color> cap: Tokens.editor-theme-default-cap;
    in-out property <color> cap-hover: Tokens.editor-theme-default-cap-hover;
    in-out property <color> cap-press: Tokens.editor-theme-default-cap-press;
    in-out property <color> pad: Tokens.editor-theme-default-pad;
    in-out property <color> pad-hover: Tokens.editor-theme-default-pad-hover;
    in-out property <color> text-on-accent: Tokens.text-on-accent;
    in-out property <color> scrim: rgba(0,0,0,Tokens.editor-theme-scrim-opacity);
    in-out property <color> waveform: Tokens.editor-theme-default-waveform;
    in-out property <color> waveform-region: Tokens.editor-theme-default-waveform-region;
    in-out property <color> surface-window: Tokens.editor-theme-default-surface-window;
    in-out property <color> surface-panel: Tokens.editor-theme-default-surface-panel;
    in-out property <color> surface-panel-header: Tokens.editor-theme-default-surface-panel-header;
    in-out property <color> surface-well: Tokens.editor-theme-default-surface-well;
    in-out property <color> surface-control: Tokens.editor-theme-default-surface-control;
    in-out property <color> surface-control-hover: Tokens.editor-theme-default-surface-control-hover;
    in-out property <color> surface-control-pressed: Tokens.editor-theme-default-surface-control-pressed;
    in-out property <color> surface-menu: Tokens.editor-theme-default-surface-menu;
    in-out property <color> surface-prepared: Tokens.editor-theme-default-surface-prepared;
    in-out property <color> text-primary: Tokens.editor-theme-default-text-primary;
    in-out property <color> text-secondary: Tokens.editor-theme-default-text-secondary;
    in-out property <color> text-tertiary: Tokens.editor-theme-default-text-tertiary;
    in-out property <color> text-disabled: Tokens.editor-theme-default-text-disabled;
    in-out property <color> border-hairline: Tokens.editor-theme-default-border-hairline;
    in-out property <color> border-control: Tokens.editor-theme-default-border-control;
    in-out property <color> border-strong: Tokens.editor-theme-default-border-strong;
    in-out property <color> color-selected: Tokens.editor-theme-default-color-selected;
    in-out property <color> color-action: Tokens.editor-theme-default-color-action;
    in-out property <color> color-focus: Tokens.editor-theme-default-color-focus;
    in-out property <color> color-value: Tokens.editor-theme-default-color-value;
    in-out property <color> color-track: Tokens.editor-theme-default-color-track;
    in-out property <color> color-cursor: Tokens.editor-theme-default-color-cursor;
    in-out property <color> ink-0: Tokens.editor-theme-default-ink-0;
    in-out property <color> ink-1: Tokens.editor-theme-default-ink-1;
    in-out property <color> ink-2: Tokens.editor-theme-default-ink-2;
    in-out property <color> ink-3: Tokens.editor-theme-default-ink-3;
    in-out property <color> ink-4: Tokens.editor-theme-default-ink-4;
    in-out property <color> ink-5: Tokens.editor-theme-default-ink-5;
    in-out property <color> ink-6: Tokens.editor-theme-default-ink-6;
    in-out property <color> line-1: Tokens.editor-theme-default-line-1;
    in-out property <color> line-2: Tokens.editor-theme-default-line-2;
    in-out property <color> line-3: Tokens.editor-theme-default-line-3;
    in-out property <color> paper-1: Tokens.editor-theme-default-paper-1;
    in-out property <color> paper-2: Tokens.editor-theme-default-paper-2;
    in-out property <color> paper-3: Tokens.editor-theme-default-paper-3;
    in-out property <color> paper-4: Tokens.editor-theme-default-paper-4;
    out property <color> value: EditorTheme.color-value;
    out property <color> color-waveform: EditorTheme.waveform;
    out property <color> color-waveform-region: EditorTheme.waveform-region;
    out property <string> font-ui: Tokens.font-ui;
    out property <string> font-display: Tokens.font-display;
    out property <string> font-value: Tokens.font-value;
    out property <brush> raised-overlay: EditorTheme.soft ? @linear-gradient(Tokens.editor-theme-raised-overlay-angle * 1deg, Tokens.editor-theme-raised-overlay-stop-1 0%, Tokens.editor-theme-raised-overlay-stop-2 Tokens.editor-theme-raised-overlay-position-2, Tokens.editor-theme-raised-overlay-stop-3 100%) : transparent;
    out property <brush> well-overlay: EditorTheme.soft ? @linear-gradient(Tokens.editor-theme-well-overlay-angle * 1deg, Tokens.editor-theme-well-overlay-stop-1 0%, Tokens.editor-theme-well-overlay-stop-2 Tokens.editor-theme-well-overlay-position-2, Tokens.editor-theme-well-overlay-stop-3 100%) : transparent;
    out property <brush> accent-overlay: EditorTheme.soft ? @linear-gradient(Tokens.editor-theme-accent-overlay-angle * 1deg, Tokens.editor-theme-accent-overlay-stop-1 0%, Tokens.editor-theme-accent-overlay-stop-2 100%) : transparent;
    out property <brush> bevel: @linear-gradient(Tokens.editor-theme-bevel-angle * 1deg, Tokens.editor-theme-bevel-stop-1 0%, Tokens.editor-theme-bevel-stop-2 Tokens.editor-theme-bevel-position-2, Tokens.editor-theme-bevel-stop-3 100%);
    out property <brush> well-lip: @linear-gradient(Tokens.editor-theme-well-lip-angle * 1deg, Tokens.editor-theme-well-lip-stop-1 0%, Tokens.editor-theme-well-lip-stop-2 100%);
    out property <brush> brushed-light: @linear-gradient(Tokens.editor-theme-brushed-light-angle * 1deg, Tokens.editor-theme-brushed-light-stop-1 0%, Tokens.editor-theme-brushed-light-stop-2 Tokens.editor-theme-brushed-light-position-2, Tokens.editor-theme-brushed-light-stop-3 Tokens.editor-theme-brushed-light-position-3, Tokens.editor-theme-brushed-light-stop-4 Tokens.editor-theme-brushed-light-position-4, Tokens.editor-theme-brushed-light-stop-5 100%);
}
