import { Tokens } from "../tokens.slint";
// Device input only, shared by knobs, sliders, and numeric scrubbing.
export component RangeGesture inherits TouchArea {
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum: 1;
    in property <bool> vertical: true;
    in property <bool> jump-on-click;
    in property <length> pixels-per-range: Tokens.editor-control-gesture-range-pixels;
    in property <float> fine-scale: Tokens.editor-control-guide-fine-scale;
    in property <bool> edit-on-single-click: true;
    in property <bool> reset-on-double-click: true;
    in property <bool> reset-on-middle-or-alt;
    in property <bool> cancel-on-interruption;
    in-out property <bool> fine;
    out property <bool> dragging;
    out property <bool> moved-far;
    private property <length> anchor-position;
    private property <float> anchor-value;
    callback started();
    callback updated(float);
    callback ended();
    callback cancelled();
    callback reset-requested();
    callback edit-requested();
    callback wheeled(float, bool);
    callback context-requested(length, length);
    mouse-cursor: root.enabled ? (root.vertical ? ns-resize : ew-resize) : default;
    pure function position() -> length { return root.vertical ? -root.mouse-y : root.mouse-x; }
    pointer-event(event) => {
        root.fine = event.modifiers.shift;
        if event.kind == PointerEventKind.down && root.enabled && root.reset-on-middle-or-alt && (event.button == PointerEventButton.middle || event.modifiers.alt) {
            root.reset-requested();
        } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left && root.enabled {
            root.anchor-position = root.position(); root.anchor-value = root.value; root.moved-far = false; root.dragging = true;
            root.started();
            if root.jump-on-click {
                let ratio = root.vertical ? 1 - (self.mouse-y - Tokens.editor-control-gesture-track-inset) / max(1px, self.height - 2*Tokens.editor-control-gesture-track-inset) : (self.mouse-x - Tokens.editor-control-gesture-track-inset) / max(1px, self.width - 2*Tokens.editor-control-gesture-track-inset);
                root.anchor-value = root.minimum + ratio.clamp(0, 1) * (root.maximum - root.minimum);
                root.updated(root.anchor-value);
            }
        } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.enabled { root.context-requested(self.mouse-x, self.mouse-y); }
            if root.dragging { root.dragging = false; if event.kind == PointerEventKind.cancel && root.cancel-on-interruption { root.cancelled(); } else { root.ended(); } }
        }
    }
    moved => {
        if root.dragging && root.enabled {
            let delta = root.position() - root.anchor-position;
            if abs(delta) > Tokens.editor-control-gesture-click-slop { root.moved-far = true; }
            root.updated(root.anchor-value + delta / max(1px, root.pixels-per-range) * (root.maximum - root.minimum) * (root.fine ? root.fine-scale : 1));
        }
    }
    clicked => { if root.edit-on-single-click && !root.moved-far && root.enabled { root.edit-requested(); } }
    double-clicked => { if root.enabled { if root.reset-on-double-click { root.reset-requested(); } else if !root.moved-far { root.edit-requested(); } } }
    scroll-event(event) => {
        if !root.enabled { return reject; }
        let delta = event.delta-y != 0px ? event.delta-y : event.delta-x;
        if delta != 0px { root.wheeled(delta > 0px ? 1 : -1, event.modifiers.shift); }
        return accept;
    }
    changed enabled => { if !root.enabled && root.dragging { root.dragging = false; if root.cancel-on-interruption { root.cancelled(); } else { root.ended(); } } }
}
