import { Tokens } from "../theme.slint";
export component RotaryMarker inherits Rectangle {
    in property <float> value;
    in property <length> radius: Tokens.editor-control-rotary-arc-radius;
    in property <length> diameter: Tokens.editor-control-rotary-marker-diameter;
    in property <bool> hollow;
    in property <color> tint;
    in property <color> backing: transparent;
    Rectangle {
        x: parent.width / 2 + root.radius * cos((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.value.clamp(0, 1)) * 1deg) - self.width / 2;
        y: parent.height / 2 + root.radius * sin((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.value.clamp(0, 1)) * 1deg) - self.height / 2;
        width: root.diameter;
        height: root.diameter;
        border-radius: self.width / 2;
        background: root.hollow ? root.backing : root.tint;
        border-color: root.tint;
        border-width: root.hollow ? Tokens.editor-control-rotary-marker-border : 0px;
    }
}
