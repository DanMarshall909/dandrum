import { Tokens } from "../theme.slint";
// Reusable 270° arc. Angles use the same geometry at 28/36/48/64 logical px.
export component RotaryArc inherits Path {
    in property <float> from;
    in property <float> to: 1;
    in property <length> radius: Tokens.editor-control-rotary-arc-radius;
    in property <color> tint;
    in property <length> thickness: Tokens.editor-control-rotary-arc-thickness;
    private property <float> a: min(root.from, root.to).clamp(0, 1);
    private property <float> b: max(root.from, root.to).clamp(0, 1);
    viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
    stroke: root.tint; stroke-width: root.thickness; stroke-line-cap: round;
    visible: root.b - root.a > Tokens.editor-control-rotary-arc-epsilon;
    MoveTo { x: root.width / 2px + root.radius / 1px * cos((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.a) * 1deg); y: root.height / 2px + root.radius / 1px * sin((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.a) * 1deg); }
    ArcTo {
        x: root.width / 2px + root.radius / 1px * cos((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.b) * 1deg);
        y: root.height / 2px + root.radius / 1px * sin((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.b) * 1deg);
        radius-x: root.radius / 1px; radius-y: root.radius / 1px;
        large-arc: root.b - root.a > Tokens.editor-control-rotary-large-arc-threshold; sweep: true;
    }
}
