import { Tokens } from "../theme.slint";
import { ViewportMetrics } from "../foundation/ViewportMetrics.slint";
import { FocusRing } from "../foundation/FocusRing.slint";
import { ModAssignment } from "../modulation/types.slint";
import { ModulationState } from "../modulation/ModulationState.slint";
import { ClipTag } from "../modulation/ClipTag.slint";
import { RangeControl } from "RangeControl.slint";
import { RangeGesture } from "RangeGesture.slint";
import { ControlLabel } from "ControlLabel.slint";
import { RotaryFace } from "RotaryFace.slint";
import { ValuePopup } from "ValuePopup.slint";

export component Knob inherits RangeControl {
    in property <length> size: Tokens.knob-md;
    in property <bool> bipolar;
    in property <bool> assigning;
    in property <int> active-slot: -1;
    in property <[ModAssignment]> modulations;
    in property <bool> show-peak-trough: true;
    in property <bool> show-label: true;
    in property <bool> value-display-always;
    in property <bool> popup-open;
    out property <bool> popup-visible;
    private property <bool> popup-suppressed;
    out property <float> effective-value: root.minimum + modulation.effective.clamp(0, 1) * (root.maximum - root.minimum);
    out property <float> peak-value: root.minimum + modulation.peak * (root.maximum - root.minimum);
    out property <float> trough-value: root.minimum + modulation.trough * (root.maximum - root.minimum);
    out property <bool> clipped: root.enabled && (modulation.clip-low || modulation.clip-high);
    out property <bool> live-clipped: root.enabled && (modulation.live-clip-low || modulation.live-clip-high);
    private property <bool> fine;
    private property <bool> popup-hovered;
    private property <bool> want-popup: root.interactive && !root.popup-suppressed && !root.value-display-always && (root.popup-open || touch.has-hover || root.has-focus || root.gesture-active || root.editing || root.nudged || root.popup-hovered);
    private property <length> label-height: root.show-label && root.label != "" ? 17px : 0px;
    callback peaks-reset();
    width: max(40px, root.size + 12px);
    height: root.label-height + root.size + 19px;
    z: root.popup-visible ? 100 : 0;
    public function show-popup() { root.popup-visible = true; close-timer.stop(); }
    public function hide-popup() { root.popup-visible = false; }
    public function reset-peaks() { modulation.reset-peaks(); root.peaks-reset(); }
    edit-requested => { root.popup-suppressed = false; root.show-popup(); }
    dismiss-requested => { root.popup-suppressed = true; root.hide-popup(); }
    init => { if root.popup-open { root.show-popup(); } }
    edit-closed => { if root.interactive { root.focus(); } }
    standard-menu-requested => { if root.interactive { parameter-menu.show({x: parameter-menu.width / 2, y: parameter-menu.height}); } }
    capture-key-pressed(event) => { root.fine = event.modifiers.shift || event.text == Key.Shift; return reject; }
    capture-key-released(event) => { root.fine = event.modifiers.shift; return reject; }
    changed want-popup => {
        if root.want-popup { root.show-popup(); }
        else { close-timer.restart(); }
    }
    close-timer := Timer { interval: 250ms; running: false; triggered => { self.stop(); if !root.want-popup { root.hide-popup(); } } }
    modulation := ModulationState { assignments: root.modulations; base: root.normalized-value; }
    Rectangle { background: root.assigning && root.interactive ? Tokens.dd-mod-wash : transparent; border-radius: Tokens.radius-2; }
    FocusRing { active: root.interactive && (root.has-focus || root.focused || root.editing); }
    HorizontalLayout {
        x: 3px; y: 0; width: parent.width - 6px; height: root.label-height;
        spacing: 3px; alignment: center;
        ControlLabel { visible: root.show-label; label: root.label; enabled: root.enabled; compact: root.size <= 36px; horizontal-alignment: center; }
        if root.modulations.length > 2 : Text { text: "+\{root.modulations.length - 2}"; font-family: Tokens.font-value; font-size: 11px; color: Tokens.text-primary; }
    }
    face := RotaryFace {
        x: (parent.width - self.width) / 2; y: root.label-height; size: root.size; value: root.normalized-value; bipolar: root.bipolar;
        enabled: root.enabled; hovered: touch.has-hover && root.interactive; active: root.gesture-active || root.nudged;
        host-automated: root.host-active; assigning: root.assigning && !root.read-only; active-slot: root.active-slot; modulations: root.modulations;
        range-low: modulation.low; range-high: modulation.high; effective: modulation.effective;
        any-live: modulation.any-live; peak: modulation.peak; trough: modulation.trough; show-peaks: root.show-peak-trough;
        clip-low: modulation.clip-low; clip-high: modulation.clip-high; live-clip-low: modulation.live-clip-low; live-clip-high: modulation.live-clip-high;
    }
    if root.clipped : ClipTag { x: (parent.width - self.width) / 2; y: root.label-height + root.size + 3px; live: root.live-clipped; }
    if root.value-display-always && !root.clipped : Text {
        x: 0; y: root.label-height + root.size + 3px; width: parent.width; height: 14px;
        text: root.value-text + (root.unit != "" && root.unit != "pan" ? " " + root.unit : ""); font-family: Tokens.font-value; font-size: root.size >= 60px ? 15px : root.size <= 36px ? 11px : 13px;
        color: !root.enabled ? Tokens.text-disabled : root.host-active ? Tokens.dd-host : Tokens.text-primary; horizontal-alignment: center;
    }
    parameter-menu := ContextMenuArea {
            enabled: root.interactive;
        Menu { title: "Parameter";
            MenuItem { title: "Reset to default"; enabled: root.interactive; activated => { root.reset-value(); } }
            MenuItem { title: "Type value…"; enabled: root.interactive; activated => { root.begin-edit(); } }
            MenuItem { title: "Modulation…"; enabled: root.interactive; activated => { root.request-context-menu(); } }
        }
        touch := RangeGesture {
            enabled: root.interactive; value: root.value; minimum: root.minimum; maximum: root.maximum; fine <=> root.fine;
            started => { root.popup-suppressed = false; root.focus(); root.begin-gesture(); }
            updated(v) => { root.update-gesture(v); }
            ended => { root.end-gesture(); }
            reset-requested => { root.reset-value(); }
            changed has-hover => { if !self.has-hover { root.popup-suppressed = false; } }
            wheeled(direction, precise) => { root.wheel(direction, precise); }
                context-requested(x, y) => { parameter-menu.show({x: x, y: y}); }
        }
    }
    popup := Rectangle {
        visible: root.popup-visible;
        z: 100;
        x: ViewportMetrics.clamp-x(root.absolute-position.x + (root.width - self.width) / 2, self.width, 8px) - root.absolute-position.x;
        y: ViewportMetrics.place-y(root.absolute-position.y, root.height, self.height, 4px, 8px) - root.absolute-position.y;
        width: max(174px, root.size + 32px);
        height: 36px + ((root.show-peak-trough && modulation.count > 0) || root.clipped ? 23px : 0px) + (root.modulations.length > 0 ? 6px + root.modulations.length * 23px : 0px) + (root.host-active ? 30px : 0px);
        ValuePopup {
            above: popup.y < 0px;
            anchor-x: root.width / 2 - popup.x;
            label: root.label; value-text: root.value-text; unit: root.unit; editing: root.editing; invalid: root.edit-invalid;
            host-automated: root.host-active; show-peaks: root.show-peak-trough && modulation.count > 0;
            peak: root.peak-value; trough: root.trough-value; clipped: root.clipped; live-clipped: root.live-clipped; modulations: root.modulations;
            edit-requested => { root.begin-edit(); }
            submitted(text) => { root.commit-text(text); }
            cancelled => { root.cancel-edit(); }
            reset-peaks => { root.reset-peaks(); }
            hover-changed(hovered) => { root.popup-hovered = hovered; }
        }
    }
}
