import { Tokens } from "../theme.slint";
export component TrackSegment inherits Rectangle {
    in property <bool> vertical;
    in property <float> from;
    in property <float> to: 1;
    in property <length> thickness: Tokens.editor-control-slider-track-thickness;
    in property <length> offset;
    in property <color> tint;
    private property <length> track-length: root.vertical ? root.height : root.width;
    private property <length> low: Tokens.editor-control-gesture-track-inset + min(root.from, root.to).clamp(0, 1) * max(0px, root.track-length - 2*Tokens.editor-control-gesture-track-inset);
    private property <length> high: Tokens.editor-control-gesture-track-inset + max(root.from, root.to).clamp(0, 1) * max(0px, root.track-length - 2*Tokens.editor-control-gesture-track-inset);
    Rectangle {
        x: root.vertical ? (parent.width - root.thickness) / 2 + root.offset : root.low;
        y: root.vertical ? parent.height - root.high : (parent.height - root.thickness) / 2 + root.offset;
        width: root.vertical ? root.thickness : root.high - root.low;
        height: root.vertical ? root.high - root.low : root.thickness;
        background: root.tint; border-radius: Tokens.editor-control-stroke-width;
    }
}
