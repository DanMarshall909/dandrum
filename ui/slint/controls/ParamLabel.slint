import { ParameterStrings } from "../editor/ParameterConstants.slint";
import { Tokens } from "../theme.slint";
import { ControlLabel } from "ControlLabel.slint";
import { ValueReadout } from "ValueReadout.slint";

// Stacked, noninteractive label and value, as defined by the guide.
export component ParamLabel inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <string> align: ParameterStrings.align-left;
    in property <string> size: root.compact ? ParameterStrings.size-small : ParameterStrings.size-medium;
    in property <bool> compact;
    in property <bool> enabled: true;
    in property <bool> host-automated;
    in property <bool> show-value: root.value != "" || root.unit != "";
    out property <color> value-color: !root.enabled ? Tokens.text-disabled : root.host-automated ? Tokens.dd-host : Tokens.text-primary;
    out property <length> value-font-size: root.size == ParameterStrings.size-large ? Tokens.type-value-lg : root.size == ParameterStrings.size-small ? Tokens.type-micro : Tokens.type-value;
    height: Tokens.editor-control-field-label-height + (root.show-value ? Tokens.editor-control-readout-value-gap + root.value-font-size * Tokens.editor-control-readout-line-height : 0px);
    preferred-width: max(caption.preferred-width, readout.preferred-width);
    accessible-role: text;
    accessible-label: root.label + (root.show-value ? ParameterStrings.label-value-separator + root.value + ParameterStrings.value-unit-separator + root.unit : "");
    caption := ControlLabel {
        x: 0px; y: 0px; width: parent.width; height: Tokens.editor-control-field-label-height;
        label: root.label; compact: root.size == ParameterStrings.size-small; enabled: root.enabled;
        horizontal-alignment: root.align == ParameterStrings.align-center ? center : root.align == ParameterStrings.align-right ? right : left;
    }
    readout := ValueReadout {
        x: 0px; y: Tokens.editor-control-field-label-height+Tokens.editor-control-readout-value-gap; width: parent.width; visible: root.show-value;
        value: root.value; unit: root.unit; align: root.align;
        font-size: root.value-font-size; foreground: root.value-color;
    }
}
