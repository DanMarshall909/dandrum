import { Tokens } from "../theme.slint";
export component SliderThumb inherits Rectangle {
    in property <float> value;
    in property <bool> vertical;
    in property <bool> enabled: true;
    in property <bool> hovered;
    in property <bool> pressed;
    Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : root.value.clamp(0, 1) * max(0px, parent.width - self.width);
        y: root.vertical ? (1 - root.value.clamp(0, 1)) * max(0px, parent.height - self.height) : (parent.height - self.height) / 2;
        width: root.vertical ? Tokens.editor-control-slider-thumb-length : Tokens.editor-control-slider-thumb-thickness; height: root.vertical ? Tokens.editor-control-slider-thumb-thickness : Tokens.editor-control-slider-thumb-length;
        background: !root.enabled ? Tokens.dd-ink-4 : root.pressed ? Tokens.dd-ink-6 : root.hovered ? Tokens.dd-cap-hover : Tokens.dd-ink-5;
        border-radius: Tokens.radius-1; border-width: Tokens.editor-control-stroke-width; border-color: Tokens.border-strong;
        drop-shadow-color: Tokens.editor-control-rotary-shadow; drop-shadow-blur: Tokens.editor-control-slider-thumb-shadow-blur; drop-shadow-offset-y: Tokens.editor-control-slider-thumb-shadow-offset;
        Rectangle { x: Tokens.editor-control-stroke-width; y: Tokens.editor-control-stroke-width; width: parent.width - 2*Tokens.editor-control-stroke-width; height: Tokens.editor-control-stroke-width; background: Tokens.editor-control-slider-thumb-highlight; }
        Rectangle { width: root.vertical ? Tokens.editor-control-slider-thumb-notch-length : Tokens.editor-control-slider-thumb-notch-thickness; height: root.vertical ? Tokens.editor-control-slider-thumb-notch-thickness : Tokens.editor-control-slider-thumb-notch-length; background: root.enabled ? Tokens.dd-paper-1 : Tokens.text-disabled; border-radius: Tokens.editor-control-stroke-width; }
    }
}
