import { Tokens } from "../theme.slint";
export component RotaryTick inherits Path {
    in property <float> value;
    in property <length> radius: Tokens.editor-control-rotary-arc-radius;
    in property <length> tick-length: Tokens.editor-control-rotary-zero-tick-large;
    in property <color> tint;
    in property <length> thickness: Tokens.editor-control-rotary-tick-thickness;
    viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
    stroke: root.tint; stroke-width: root.thickness; stroke-line-cap: round;
    MoveTo { x: root.width / 2px + root.radius / 1px * cos((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.value.clamp(0, 1)) * 1deg); y: root.height / 2px + root.radius / 1px * sin((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.value.clamp(0, 1)) * 1deg); }
    LineTo { x: root.width / 2px + (root.radius + root.tick-length) / 1px * cos((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.value.clamp(0, 1)) * 1deg); y: root.height / 2px + (root.radius + root.tick-length) / 1px * sin((Tokens.editor-control-rotary-arc-start-degrees + Tokens.editor-control-rotary-arc-sweep-degrees * root.value.clamp(0, 1)) * 1deg); }
}
