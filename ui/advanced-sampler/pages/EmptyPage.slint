import { SamplerCommands } from "../domain/Commands.slint";
import { Tokens } from "../../slint/theme.slint";
import { ReadOnlyKeyMap } from "ReadOnlyKeyMap.slint";
import { Session } from "../Session.slint";
import { DragState } from "../chrome/DragState.slint";
import { EmptyState } from "../../slint/editor/EmptyState.slint";
export component EmptyPage inherits EmptyState {
    in property <bool> expanded;
    canvas-height: root.expanded ? Tokens.editor-empty-expanded-canvas-height : root.height;
    center-offset: root.expanded ? Tokens.editor-chrome-gap-small : Tokens.editor-chrome-gap-tight;
    title: "Drop samples here";
    description: "One file becomes a sound across the keyboard. Several files ask how to map them.";
    footer: "WAV · AIFF · FLAC · MP3 · OGG";
    primary-text: "Browse samples…";
    primary-label: "Browse samples";
    secondary-icon: Tokens.editor-icon-layers;
    secondary-label: "Load multiple samples";
    callback browse(string);
    primary-activated => { root.browse(SamplerCommands.asset-import); }
    secondary-activated => { root.browse(SamplerCommands.asset-import-many); }
    window-deactivated => { Session.release-notes(); DragState.cancel(); }
    if root.expanded: ReadOnlyKeyMap {
        y: root.canvas-height + Tokens.editor-chrome-gap-small;
        width: parent.width;
    }
}
