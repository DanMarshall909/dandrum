import { Session } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { AppIcon } from "../controls/AppIcon.slint";
import { DashedBorder } from "../../slint/foundation/DashedBorder.slint";

export component EmptyPage inherits Rectangle {
    callback browse(string);
    background: SamplerTheme.surface-well;
    border-radius: 6px;
    if SamplerTheme.soft : Rectangle { border-radius: 6px; background: SamplerTheme.well-overlay; }
    // Native dashed outline retains the reference's six-pixel cadence.
    for i in ceil(root.width / 12px) : Rectangle { x: i * 12px; y: 0px; width: min(6px, parent.width - self.x); height: 1px; background: SamplerTheme.line-3; }
    for i in ceil(root.width / 12px) : Rectangle { x: i * 12px; y: parent.height - 1px; width: min(6px, parent.width - self.x); height: 1px; background: SamplerTheme.line-3; }
    for i in ceil(root.height / 12px) : Rectangle { x: 0px; y: i * 12px; width: 1px; height: min(6px, parent.height - self.y); background: SamplerTheme.line-3; }
    for i in ceil(root.height / 12px) : Rectangle { x: parent.width - 1px; y: i * 12px; width: 1px; height: min(6px, parent.height - self.y); background: SamplerTheme.line-3; }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(parent.width - 24px, 330px); height: 216px;
        Rectangle { width: parent.width; height: 136px; border-radius: 2px;
            DashedBorder { tint: SamplerTheme.line-2; }
            AppIcon { x: (parent.width - 20px) / 2; y: 24px; size: 20px; name: "plus"; tint: SamplerTheme.paper-3; }
            Text { y: 52px; width: parent.width; height: 18px; text: "Drop samples here"; font-family: SamplerTheme.font-ui; font-size: 13px; font-weight: 600; color: SamplerTheme.paper-2; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 24px; y: 78px; width: parent.width - 48px; height: 34px; text: "One file becomes a sound across the keyboard. Several files ask how to map them."; font-family: SamplerTheme.font-ui; font-size: 12px; color: SamplerTheme.paper-3; horizontal-alignment: center; wrap: word-wrap; }
        }
        ActionButton { x: (parent.width - 176px) / 2; y: 152px; width: 140px; height: 28px; text: "Browse samples…"; label: "Browse samples"; icon: "folder"; primary: true; clicked => { root.browse("asset.import"); } }
        ActionButton { x: (parent.width - 176px) / 2 + 148px; y: 152px; width: 28px; height: 28px; icon: "layers"; label: "Load multiple samples"; clicked => { root.browse("asset.import-many"); } }
        Text { y: 196px; width: parent.width; height: 20px; text: "WAV · AIFF · FLAC · MP3 · OGG"; font-family: SamplerTheme.font-ui; font-size: 12px; color: SamplerTheme.paper-3; horizontal-alignment: center; }
    }
}
