import { GesturePhases } from "../../slint/editor/ParameterConstants.slint";
import { SamplerCommands } from "../domain/Commands.slint";
import { CurveKinds } from "../../slint/editor/CurveConstants.slint";
import { EditorProcessorPlot } from "../../slint/editor/ProcessorPlot.slint";
import { ReadOnlyKeyMap } from "ReadOnlyKeyMap.slint";
import { ScrollView } from "std-widgets.slint";
import { Session, ProcessorChainInfo } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { NumericField } from "../controls/NumericField.slint";
import { ParamKnob } from "../controls/ParamKnob.slint";
import { DragTarget } from "../chrome/DragState.slint";
import { LayerParameter } from "../domain/types.slint";
import { PageSection, SectionText } from "PageSection.slint";
component ProcessorGraph inherits EditorProcessorPlot {
 in property <string> processor-name;
 in property <[LayerParameter]> parameters;
 private property <LayerParameter> primary: root.parameters.length > 0 ? root.parameters[0] : { minimum: 0, maximum: 1 };
 value: root.primary.value; minimum: root.primary.minimum; maximum: root.primary.maximum;
 ratio: root.parameters.length > 1 ? root.parameters[1].value : 1;
 enabled: root.parameters.length > 0;
 label: "Processor graph "+root.processor-name;
 kind: root.processor-name == "Compressor" ? CurveKinds.compressor : root.processor-name == "Parametric EQ" ? CurveKinds.eq
  : root.processor-name == "Filter" ? CurveKinds.filter : root.processor-name == "Saturate" ? CurveKinds.saturate
  : root.processor-name == "Bitcrush" ? CurveKinds.bitcrush : CurveKinds.decay;
 gesture(phase,value) => { return Session.parameter-gesture(root.primary.id,phase,value); }
}

component EffectsChainRow inherits Rectangle {
 in property <ProcessorChainInfo> chain;
 // Match the reference's flex-wrap: a 190 px source tile, 88 px processors and 8 px wires.
 private property <length> span: max(190px,root.width - 252px);
 private property <int> first-line: max(0,floor((root.span - 190px)/96px));
 private property <int> columns: max(1,floor(root.span/96px));
 pure function tile-x(i:int)->length { return i < root.first-line ? 190px+i*96px : mod(i - root.first-line,root.columns)*96px; }
 pure function tile-y(i:int)->length { return i < root.first-line ? 0px : (1+floor((i - root.first-line)/root.columns))*42px; }
 private property <length> last-x: root.chain.processors.length > 0 ? root.tile-x(root.chain.processors.length - 1)+96px : 190px;
 private property <length> last-y: root.chain.processors.length > 0 ? root.tile-y(root.chain.processors.length - 1) : 0px;
 private property <length> add-x: root.last-x+38px <= root.span ? root.last-x : 0px;
 private property <length> add-y: root.last-x+38px <= root.span ? root.last-y : root.last-y+42px;
 out property <length> row-height: root.add-y+52px;
 height: root.row-height;
 background: root.chain.id == "drums" ? SamplerTheme.ink-4 : SamplerTheme.ink-3;
 border-width: 1px; border-color: root.chain.id == "drums" ? SamplerTheme.accent : SamplerTheme.line-1; border-radius: 4px;
 Rectangle { x: 6px; y: 7px; width: 190px; height: 38px; background: SamplerTheme.ink-2; border-width: 1px; border-color: SamplerTheme.line-2; border-radius: 4px;
  SectionText { x: 8px; y: 2px; width: parent.width - 16px; height: 18px; text: root.chain.name; color: SamplerTheme.paper-1; font-weight: 600; }
  SectionText { x: 8px; y: 20px; width: parent.width - 16px; height: 15px; text: root.chain.kind == "group" ? "Group · "+root.chain.processors.length+" processors" : "FX bus · sends"; font-family: SamplerTheme.font-value; font-size: 10px; }
 }
 for processor[i] in root.chain.processors : Rectangle { x: 6px+root.tile-x(i)+8px; y: 7px+root.tile-y(i); width: 88px; height: 38px; border-radius: 3px; border-width: 1px; border-color: processor.selected ? SamplerTheme.accent : SamplerTheme.line-3; background: SamplerTheme.surface-control;
  if SamplerTheme.soft : Rectangle { border-radius: 3px; background: SamplerTheme.raised-overlay; }
  ActionButton { x: 3px; y: 1px; width: parent.width - 6px; height: 19px; text: processor.name == "Parametric EQ" ? "EQ" : processor.name == "Compressor" ? "Comp" : processor.name; label: "Select effect "+root.chain.name+" "+processor.name; compact: true; ghost: true; selected: processor.selected; clicked => { Session.command(SamplerCommands.selection-set,processor.id,"",0); } }
  SectionText { x: 6px; y: 20px; width: parent.width - 22px; height: 15px; text: processor.parameters.length > 0 ? round(processor.parameters[0].value*(processor.parameters[0].unit == "%" ? 100 : 1)*10)/10+" "+processor.parameters[0].unit : ""; font-family: SamplerTheme.font-value; font-size: 10px; color: processor.bypassed ? SamplerTheme.paper-4 : SamplerTheme.paper-2; }
  ActionButton { x: parent.width - 18px; y: 19px; width: 16px; height: 16px; text: "·"; label: "Bypass effect "+processor.name; selected: !processor.bypassed; compact: true; ghost: true; clicked => { Session.command(SamplerCommands.fx-bypass,processor.id,"",0); } }
 }
 ActionButton { x: 6px+root.add-x+8px; y: 7px+root.add-y; width: 30px; height: 38px; text: "+"; label: "Add effect to "+root.chain.name; compact: true; ghost: true; clicked => { Session.command(SamplerCommands.fx-add,root.chain.id,root.chain.kind == "bus" ? "Reverb" : "Parametric EQ",0); } }
 ActionButton { x: parent.width - 228px; y: (parent.height - 24px)/2; width: 124px; text: root.chain.output == "inherit" ? "Inherit" : root.chain.output; label: "Chain output "+root.chain.name; compact: true; clicked => { output-menu.show(); } }
 output-menu := PopupWindow { x: parent.width - 228px; y: parent.height; width: 150px; height: 30px+Session.buses.length*26px;
  Rectangle { background: SamplerTheme.surface-menu; border-width: 1px; border-color: SamplerTheme.line-3;
   VerticalLayout { padding: 3px; spacing: 2px; alignment: start;
    ActionButton { text: "Inherit"; compact: true; ghost: true; clicked => { Session.command(SamplerCommands.chain-output,root.chain.id,"inherit",0); output-menu.close(); } }
    for bus in Session.buses : ActionButton { text: bus.name; label: "Set chain "+root.chain.name+" output "+bus.name; compact: true; ghost: true; clicked => { Session.command(SamplerCommands.chain-output,root.chain.id,bus.name,0); output-menu.close(); } }
   }
  }
 }
 NumericField { x: parent.width - 96px; y: (parent.height - 24px)/2; width: 56px; show-label: false; ghost: true; label: "Chain gain "+root.chain.name; unit: "dB"; minimum: -60; maximum: 12; model-value: root.chain.gain; value: root.chain.gain; step: 0.1;
  gesture-began => { Session.parameter-gesture("chain:"+root.chain.id+":gain",GesturePhases.begin,self.value); }
  changed(v) => { Session.parameter-gesture("chain:"+root.chain.id+":gain",GesturePhases.update,v); }
  gesture-ended => { Session.parameter-gesture("chain:"+root.chain.id+":gain",GesturePhases.commit,self.value); }
 }
 ActionButton { x: parent.width - 32px; y: (parent.height - 24px)/2; width: 24px; text: "M"; label: "Mute chain "+root.chain.name; compact: true; ghost: true; selected: root.chain.muted; clicked => { Session.command(SamplerCommands.chain-mute,root.chain.id,"",0); } }
}
component EffectsChains inherits Rectangle {
 in property <string> kind;
 in property <string> title;
 in property <string> subtitle;
 height: contents.preferred-height+22px;
 SectionText { x: 0px; y: 0px; width: 94px; height: 18px; text: root.title.to-uppercase(); accessible-label: root.title; font-size: 10px; font-weight: 600; }
 SectionText { x: 100px; y: 0px; width: parent.width - 100px; height: 18px; text: root.subtitle; color: SamplerTheme.paper-1; font-size: 12px; font-weight: 600; }
 contents := VerticalLayout { y: 22px; width: parent.width; height: self.preferred-height; spacing: 0px; padding: 0px;
  for chain in Session.fx-chains : Rectangle { visible: chain.kind == root.kind; height: self.visible ? row.row-height+4px : 0px;
   row := EffectsChainRow { x: 0px; y: 0px; chain: chain; }
  }
 }
}

export component EffectsPage inherits Rectangle {
 in property <bool> compact;
 in property <bool> expanded;
 callback context-action(string,string);
 public function add-effect(name:string) { Session.command(SamplerCommands.fx-add,"main",name,0); }
 ScrollView { VerticalLayout { padding: 0px; spacing: 4px; alignment: start;
  EffectsChains { kind: "group"; title: "Group inserts"; subtitle: "Processed left to right before the output bus"; }
  EffectsChains { kind: "bus"; title: "FX busses"; subtitle: "Fed by sends on the Routing page"; }
  if root.expanded : ReadOnlyKeyMap { }
  for effect in Session.effect-modules : PageSection { title: effect.name; subtitle: effect.bypassed ? "Bypassed" : "Active"; height: root.compact ? 190px : 224px;
   ActionButton { x: parent.width - 100px; y: 5px; text: effect.bypassed ? "Off" : "On"; label: "Bypass effect "+effect.name; selected: !effect.bypassed; compact: true; clicked => { Session.command(SamplerCommands.fx-bypass,effect.id,"",0); } }
   ActionButton { x: parent.width - 54px; y: 5px; text: "↑"; label: "Move effect up"; compact: true; clicked => { Session.command(SamplerCommands.fx-move,effect.id,"",-1); } }
   ActionButton { x: parent.width - 29px; y: 5px; text: "×"; label: "Delete effect"; compact: true; clicked => { Session.command(SamplerCommands.fx-delete,effect.id,"",0); } }
   ProcessorGraph { x: 12px; y: 46px; width: parent.width - 24px; height: 56px; processor-name: effect.name; parameters: effect.parameters; }

   HorizontalLayout { x: 12px; y: 112px; width: parent.width - 24px; height: 90px; spacing: 16px; alignment: start;
    for parameter in effect.parameters : ParamKnob { parameter-id: parameter.id; context-action(action) => { root.context-action(action,parameter.id); } size: root.compact ? 32px : 44px; private property <float> scale: parameter.unit == "%" && parameter.maximum <= 1 ? 100 : 1; label: parameter.label; model-value: parameter.value*self.scale; value: parameter.value*self.scale; minimum: parameter.minimum*self.scale; maximum: parameter.maximum*self.scale; default-value: parameter.default-value*self.scale; unit: parameter.unit; value-display-always: true; gesture-began => { Session.parameter-gesture(parameter.id,GesturePhases.begin,self.value/self.scale); } changed(v) => { Session.parameter-gesture(parameter.id,GesturePhases.update,v/self.scale); } gesture-ended => { Session.parameter-gesture(parameter.id,GesturePhases.commit,self.value/self.scale); } }

   }
  }
  HorizontalLayout { height: 28px; spacing: 4px; alignment: start; ActionButton { text: "+ EQ"; clicked => { root.add-effect("Parametric EQ"); } } ActionButton { text: "+ Delay"; clicked => { root.add-effect("Delay"); } } ActionButton { text: "+ Compressor"; clicked => { root.add-effect("Compressor"); } } }
 } }
}
