import { GesturePhases } from "../../slint/editor/ParameterConstants.slint";
import { SamplerCommands } from "../domain/Commands.slint";
import { GraphMetrics } from "../../slint/editor/DisplayConstants.slint";
import { Tokens } from "../../slint/theme.slint";
import { EditorFilterPlot } from "../../slint/editor/FilterPlot.slint";
import { EditorEnvelopePlot } from "../../slint/editor/EnvelopePlot.slint";
import { ReadOnlyKeyMap } from "ReadOnlyKeyMap.slint";
import { ScrollView } from "std-widgets.slint";
import { Session, ParameterInfo, ModuleInfo } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { OptionStrip } from "../controls/OptionStrip.slint";
import { NumericField } from "../controls/NumericField.slint";
import { ParamKnob } from "../controls/ParamKnob.slint";
import { PageSection, DomainKnob, SectionText } from "PageSection.slint";
import { VoiceRenderDialog } from "VoiceRenderDialog.slint";
export { VoiceRenderDialog }
component VoiceFilterPlot inherits EditorFilterPlot {
    in property <[ParameterInfo]> parameters;
    cutoff: root.parameters.length > 0 ? root.parameters[0].value : GraphMetrics.default-cutoff;
    resonance: root.parameters.length > 1 ? root.parameters[1].value : GraphMetrics.default-resonance;
    mode: Session.filter-mode;
    gesture(phase, value) => { return Session.parameter-gesture("cutoff",phase,value); }
    resonance-preview(value) => { Session.command(SamplerCommands.parameter-preview,"resonance","",value); }
}

component VoiceEnvelopePlot inherits EditorEnvelopePlot {
    in property <[ParameterInfo]> domain-parameters;
    private property <string> captured-id;
    parameters: [
        {
            value:root.domain-parameters[0].value,
            minimum:root.domain-parameters[0].minimum,
            maximum:root.domain-parameters[0].maximum,
            step:root.domain-parameters[0].step
        },
        {
            value:root.domain-parameters[1].value,
            minimum:root.domain-parameters[1].minimum,
            maximum:root.domain-parameters[1].maximum,
            step:root.domain-parameters[1].step
        },
        {
            value:root.domain-parameters[2].value,
            minimum:root.domain-parameters[2].minimum,
            maximum:root.domain-parameters[2].maximum,
            step:root.domain-parameters[2].step
        },
        {
            value:root.domain-parameters[3].value,
            minimum:root.domain-parameters[3].minimum,
            maximum:root.domain-parameters[3].maximum,
            step:root.domain-parameters[3].step
        }
    ];
    gesture(index, phase, value) => {
        if phase == GesturePhases.begin { root.captured-id = root.domain-parameters[index].id; }
        let accepted = Session.parameter-gesture(root.captured-id,phase,value);
        if phase == GesturePhases.commit || phase == GesturePhases.cancel || (phase == GesturePhases.begin && !accepted) { root.captured-id = ""; }
        return accepted;
    }
    related-preview(index, value) => { Session.command(SamplerCommands.parameter-preview,root.domain-parameters[index].id,"",value); }
}

component VoiceSourceCard inherits PageSection {
    in property <ModuleInfo> source;
    in property <bool> editable: true;
    callback context-action(string, string);
    private property <int> columns: max(1,floor((root.width - 10px) / 58px));
    title: "Audio source";
    subtitle: root.source.name;
    header-height: 24px;
    height: 68px + ceil(root.source.parameters.length / root.columns) * 60px;
    OptionStrip {
        x: 12px;
        y: 31px;
        width: min(250px,parent.width - 24px);
        label: root.source.name + " mode";
        value: root.source.mode;
        enabled: root.editable;
        options: root.source.kind == "noise" ? [{ id:"white", label:"White" }, { id:"pink", label:"Pink" }] :
            root.source.kind == "oscillator" ? [
            { id:"sine", label:"Sine" },
            { id:"saw", label:"Saw" },
            { id:"square", label:"Square" }
        ] :
            root.source.kind == "sampler" ? [
            { id:"once", label:"Once" },
            { id:"gated", label:"Gated" },
            { id:"loop", label:"Loop" }
        ] :
            [{ id:"notes", label:"Follows notes" }, { id:"drone", label:"Drone" }];
        selected(v) => { Session.command(SamplerCommands.module-mode,root.source.id,v,0); }
    }

    for p[i] in root.source.parameters: ParamKnob {
        private property <float> scale: p.unit == "%" ? 100 : 1;
        x: 12px + mod(i,root.columns) * 58px;
        y: 62px + floor(i / root.columns) * 60px;
        width: 56px;
        label: p.label;
        accessible-label: root.source.name + " " + p.label;
        parameter-id: p.id;
        size: 28px;
        value-display-always: false;
        model-value: p.value * self.scale;
        value: p.value * self.scale;
        minimum: p.minimum * self.scale;
        maximum: p.maximum * self.scale;
        step: p.step * self.scale;
        default-value: p.default-value * self.scale;
        unit: p.unit;
        bipolar: p.bipolar;
        enabled: root.editable && p.available;
        gesture-began => { Session.parameter-gesture(p.id,GesturePhases.begin,self.value / self.scale); }
        changed(v) => { Session.parameter-gesture(p.id,GesturePhases.update,v / self.scale); }
        gesture-ended => { Session.parameter-gesture(p.id,GesturePhases.commit,self.value / self.scale); }
        context-action(a) => { root.context-action(a,p.id); }
    }
}

component VoiceParameterCard inherits PageSection {
    in property <[ParameterInfo]> parameters;
    in property <string> mode;
    in property <string> mode-kind;
    in property <bool> editable: true;
    callback context-action(string, string);
    header-height: 24px;
    private property <int> columns: max(1,floor((root.width - 10px) / 44px));
    OptionStrip {
        visible: root.mode-kind != "";
        x: 5px;
        y: 29px;
        width: parent.width - 10px;
        label: root.mode-kind == "filter" ? "Filter type" : "Source playback";
        value: root.mode;
        enabled: root.editable;
        options: root.mode-kind == "filter" ? [
            { id:"lp", label:"LP" },
            { id:"bp", label:"BP" },
            { id:"hp", label:"HP" },
            { id:"notch", label:"Notch" }
        ] : [
            { id:"once", label:"Once" },
            { id:"gated", label:"Gated" },
            { id:"loop", label:"Loop" }
        ];
        selected(v) => { Session.command(root.mode-kind == "filter" ? SamplerCommands.filter-mode : SamplerCommands.sample-mode,"",v,0); }
    }

    for p[i] in root.parameters: DomainKnob {
        x: 5px + mod(i,root.columns) * (parent.width - 10px) / root.columns;
        y: (root.mode-kind == "" ? 34px : 59px) + floor(i / root.columns) * 68px;
        width: (parent.width - 10px) / root.columns;
        size: 36px;
        parameter: p;
        accessible-label: p.label;
        value-display-always: false;
        label: p.id == "pitch" ? "Tune" : p.id == "start-offset" ? "Start" : p.id == "resonance" ? "Reso" : p.id == "filter-key-track" ? "Key trk" : p.id == "filter-env-amount" ? "Env amt" : p.id == "velocity" ? "Vel sens" : p.label;
        enabled: root.editable && p.available;
        context(a, id) => { root.context-action(a,id); }
    }
}


export component VoicePage inherits FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;
    capture-key-pressed(event) => { if modal.mode != "" && event.text == Key.Escape { modal.close(); return accept; } return reject; }
    in property <bool> compact;
    in property <bool> expanded;
    in property <bool> dialogs-in-page: true;
    callback context-action(string, string);
    public function add-module() { Session.command(SamplerCommands.module-add,"voice","Waveshaper",0); }
    ScrollView {
        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            alignment: start;
            Rectangle {
                height: (root.expanded ? 40px : 70px) + 4px;
                Rectangle {
                    height: root.expanded ? 40px : 70px;
                    background: SamplerTheme.ink-2;
                    border-width: 1px;
                    border-color: SamplerTheme.line-1;
                    border-radius: 6px;
                    x: 0px;
                    y: 0px;
                    SectionText {
                        x: 12px;
                        y: 7px;
                        width: 82px;
                        height: 24px;
                        text: "VOICE";
                        color: SamplerTheme.secondary;
                        font-weight: 700;
                    }

                    Flickable {
                        x: 96px;
                        y: 7px;
                        width: parent.width - 136px;
                        height: 26px;
                        content-width: max(self.width,Session.voice-modules.length * 87px);
                        content-height: self.height;
                        for module[i] in Session.voice-modules: ActionButton {
                            x: i * 87px;
                            width: 83px;
                            height: 24px;
                            text: module.name;
                            selected: module.id == Session.selected-id;
                            compact: true;
                            clicked => { Session.command(SamplerCommands.selection-set,module.id,"",0); }
                        }
                    }

                    add-module := ActionButton {
                        x: parent.width - 32px;
                        y: 7px;
                        width: 24px;
                        text: "+";
                        label: "Add voice module";
                        compact: true;
                        clicked => { root.add-module(); }
                    }

                    HorizontalLayout {
                        x: root.expanded ? parent.width - 165px : 12px;
                        y: root.expanded ? 7px : 38px;
                        width: root.expanded ? 128px : parent.width - 24px;
                        height: 24px;
                        spacing: 4px;
                        alignment: start;
                        ActionButton {
                            text: root.expanded ? "" : "Edit source";
                            label: "Edit source";
                            icon: "chevron-right";
                            compact: true;
                            ghost: true;
                            clicked => { Session.command(SamplerCommands.page-select,"sample","",0); }
                        }

                        ActionButton {
                            label: "Sample patch…";
                            icon: "variation";
                            compact: true;
                            ghost: true;
                            clicked => { modal.open("auto"); }
                        }

                        ActionButton {
                            label: "Add source…";
                            icon: "plus";
                            compact: true;
                            ghost: true;
                            clicked => { modal.open("source"); }
                        }

                        ActionButton {
                            label: "Freeze…";
                            icon: "lock";
                            compact: true;
                            ghost: true;
                            enabled: !Session.voice-frozen && Session.freeze-state != "running";
                            clicked => { modal.open("freeze"); }
                        }

                        if Session.voice-frozen: ActionButton {
                            icon: "reset";
                            label: "Unfreeze · restore original source";
                            compact: true;
                            clicked => { Session.command(SamplerCommands.sample-unfreeze,Session.selected-source,"",0); }
                        }
                    }
                }
            }

            Rectangle {
                private property <int> columns: root.compact ? 2 : root.expanded ? 5 : 3;
                private property <length> row-height: root.compact ? 136px : 205px;
                height: (self.columns == 3 ? 313px : self.columns == 2 ? 276px : 205px) + 4px;
                for card[i] in ["Audio source", "Pitch", "Filter", "Amplitude"]: VoiceParameterCard {
                    x: mod(i,parent.columns) * (parent.width + 4px) / parent.columns;
                    y: floor(i / parent.columns) * (parent.row-height + 4px);
                    width: (parent.width - (parent.columns - 1) * 4px) / parent.columns;
                    height: i == 3 && parent.columns == 3 ? 104px : parent.row-height;
                    title: card;
                    subtitle: i == 0 ? "Sampler · Sample player" : i == 2 ? "Ladder 24 dB" : "";
                    parameters: i == 0 ? Session.source-parameters : i == 1 ? Session.pitch-parameters : i == 2 ? Session.filter-parameters : Session.amp-parameters;
                    mode-kind: i == 0 ? "source" : i == 2 ? "filter" : "";
                    mode: i == 0 ? Session.play-mode : Session.filter-mode;
                    editable: !Session.voice-frozen;
                    border-color: i == 2 ? SamplerTheme.accent : SamplerTheme.line-1;
                    context-action(a, id) => { root.context-action(a,id); }
                }
            }

            for source in Session.voice-modules: Rectangle {
                visible: source.id != "source" && source.kind != "processor";
                height: self.visible ? card.height + 4px : 0px;
                card := VoiceSourceCard {
                    x: 0px;
                    y: 0px;
                    height: 68px + ceil(source.parameters.length / max(1,floor((self.width - 24px) / 52px))) * 60px;
                    source: source;
                    editable: !Session.voice-frozen;
                    context-action(a, id) => { root.context-action(a,id); }
                }
            }
            Rectangle {
                height: panel.height + 4px;
                panel := PageSection {
                    x: 0px;
                    y: 0px;
                    title: "Filter response";
                    subtitle: "Ladder " + Session.filter-mode.to-uppercase() + " 24 dB · drag cutoff and resonance";
                    height: 39px + (root.compact ? 64px : root.expanded ? 110px : 84px);
                    header-height: 24px;
                    filter-plot := VoiceFilterPlot {
                        x: 12px;
                        y: 31px;
                        width: parent.width - 24px;
                        height: root.compact ? 64px : root.expanded ? 110px : 84px;
                        parameters: Session.filter-parameters;
                        enabled: !Session.voice-frozen;
                        accessible-enabled: !Session.voice-frozen;
                    }
                }
            }

            Rectangle {
                height: (root.compact ? 545px : 243px) + 4px;
                private property <length> envelope-width: root.compact ? self.width : (self.width - 208px) / 2;
                for group[i] in ["Amp envelope", "Filter envelope"]: PageSection {
                    x: root.compact ? 0px : i * (parent.envelope-width + 4px);
                    y: root.compact ? i * 151px : 0px;
                    width: parent.envelope-width;
                    title: group;
                    height: root.compact ? 147px : 243px;
                    header-height: root.compact || root.expanded ? 30px : 78px;
                    for modulator in Session.modulators: OptionStrip {
                        visible: modulator.id == (i == 0 ? "amp-env" : "filter-env");
                        x: root.compact || root.expanded ? parent.width - 180px : 12px;
                        y: root.compact || root.expanded ? 4px : parent.header-height - 26px;
                        width: 170px;
                        label: "Voice envelope shape " + group;
                        enabled: !Session.voice-frozen;
                        value: modulator.shape == "sine" ? "adsr" : modulator.shape;
                        options: [
                            { id:"adsr", label:"ADSR" },
                            { id:"ahdsr", label:"AHDSR" },
                            { id:"multi", label:"Multi" }
                        ];
                        selected(v) => { Session.command(SamplerCommands.modulator-shape,modulator.id,v,0); }
                    }
                    envelope-plot := VoiceEnvelopePlot {
                        x: 12px;
                        y: parent.header-height + 10px;
                        width: parent.width - 24px;
                        height: root.compact ? 44px : root.expanded ? 72px : 56px;
                        title: group;
                        domain-parameters: i == 0 ? Session.amp-envelope-parameters : Session.filter-envelope-parameters;
                        enabled: !Session.voice-frozen;
                    }

                    for p[j] in i == 0 ? Session.amp-envelope-parameters : Session.filter-envelope-parameters: NumericField {
                        private property <float> scale: p.unit == "%" ? 100 : 1;
                        x: 12px + j * (parent.width - 24px) / 4;
                        y: envelope-plot.y + envelope-plot.height + 8px;
                        width: (parent.width - 24px) / 4 - 4px;
                        label: p.label;
                        ghost: true;
                        parameter-id: p.id;
                        enabled: !Session.voice-frozen && p.available;
                        model-value: p.value * self.scale;
                        value: p.value * self.scale;
                        minimum: p.minimum * self.scale;
                        maximum: p.maximum * self.scale;
                        step: p.step * self.scale;
                        default-value: p.default-value * self.scale;
                        unit: p.unit;
                        gesture-began => { Session.parameter-gesture(p.id,GesturePhases.begin,self.value / self.scale); }
                        changed(v) => { Session.parameter-gesture(p.id,GesturePhases.update,v / self.scale); }
                        gesture-ended => { Session.parameter-gesture(p.id,GesturePhases.commit,self.value / self.scale); }
                        context-action(a) => { root.context-action(a,p.id); }
                    }
                }
                PageSection {
                    x: root.compact ? 0px : parent.width - 200px;
                    y: root.compact ? 302px : 0px;
                    width: root.compact ? parent.width : 200px;
                    title: "Voices";
                    secondary: true;
                    header-height: 30px;
                    height: 243px;
                    OptionStrip {
                        x: 12px;
                        y: 40px;
                        width: parent.width - 24px;
                        label: "Voice policy";
                        enabled: !Session.voice-frozen;
                        value: Session.voice-policy;
                        options: [
                            { id:"poly", label:"Poly" },
                            { id:"mono", label:"Mono" },
                            { id:"legato", label:"Legato" }
                        ];
                        selected(v) => { Session.command(SamplerCommands.voice-policy,"",v,0); }
                    }

                    SectionText {
                        x: 12px;
                        y: 70px;
                        width: 85px;
                        height: 24px;
                        text: "Voice limit";
                    }

                    NumericField {
                        x: parent.width - 82px;
                        y: 70px;
                        width: 70px;
                        show-label: false;
                        ghost: true;
                        label: "Voice limit";
                        enabled: !Session.voice-frozen;
                        model-value: Session.voice-limit;
                        value: Session.voice-limit;
                        minimum: 1;
                        maximum: 128;
                        step: 1;
                        changed(v) => { Session.command(SamplerCommands.voice-limit,"","",v); }
                    }

                    SectionText {
                        x: 12px;
                        y: 100px;
                        height: 18px;
                        text: "Steal";
                    }

                    OptionStrip {
                        x: 12px;
                        y: 120px;
                        width: parent.width - 24px;
                        label: "Steal policy";
                        enabled: !Session.voice-frozen;
                        value: Session.voice-steal;
                        options: [
                            { id:"oldest-released", label:"Oldest released" },
                            { id:"oldest", label:"Oldest" },
                            { id:"quietest", label:"Quietest" },
                            { id:"none", label:"No steal" }
                        ];
                        selected(v) => { Session.command(SamplerCommands.voice-steal,"",v,0); }
                    }

                    SectionText {
                        x: 12px;
                        y: 153px;
                        width: 85px;
                        height: 24px;
                        text: "Same note";
                    }

                    ActionButton {
                        x: parent.width - 90px;
                        y: 153px;
                        width: 78px;
                        text: "Retrigger";
                        enabled: !Session.voice-frozen;
                        compact: true;
                        ghost: true;
                        clicked => { Session.command(SamplerCommands.voice-same-note,"","retrigger",0); }
                    }
                }
            }

            if root.expanded: ReadOnlyKeyMap { }
        }
    }

    private property <bool> freeze-confirm: Session.freeze-state == "confirm";
    init => { if root.freeze-confirm { modal.open("freeze"); } }
    changed freeze-confirm => { if root.freeze-confirm { modal.open("freeze"); } }
    modal := VoiceRenderDialog {
        visible: root.dialogs-in-page && self.mode != "";
    }
}
