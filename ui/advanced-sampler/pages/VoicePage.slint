import { ScrollView } from "std-widgets.slint";
import { Session, ParameterInfo, ModuleInfo } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { OptionStrip } from "../controls/OptionStrip.slint";
import { NumericField } from "../controls/NumericField.slint";
import { ParamKnob } from "../controls/ParamKnob.slint";
import { PageSection, DomainKnob, SectionText } from "PageSection.slint";
import { VoiceDialogState } from "VoiceDialogState.slint";

component VoiceFilterPlot inherits FocusScope {
 in property <[ParameterInfo]> parameters;
 private property <float> cutoff: root.parameters.length > 0 ? root.parameters[0].value : 2400;
 private property <float> resonance: root.parameters.length > 1 ? root.parameters[1].value : 0.22;
 private property <bool> dragging;
 focus-on-tab-navigation: true;
 accessible-role: slider; accessible-label: "Filter response";
 accessible-value: round(root.cutoff) + " Hz";
 accessible-value-minimum: 20; accessible-value-maximum: 20000;
 pure function response(t:float) -> float {
  let ratio = 20 * pow(1000,t) / max(20,root.cutoff);
  let base = Session.filter-mode == "hp" ? -10 * log(1 + pow(1/ratio,8),10) :
   Session.filter-mode == "bp" ? -10 * log(1 + pow(abs(ratio - 1/ratio),4),10) :
   Session.filter-mode == "notch" ? -10 * log(1 + pow(1/max(0.000001,abs(ratio - 1/ratio)),4),10) :
   -10 * log(1 + pow(ratio,8),10);
  let db = base + (Session.filter-mode == "notch" ? 0 : root.resonance * 14 * pow(2.7182818,-pow(log(ratio,2.7182818)/0.18,2)));
  return ((22 - db * 1.5).clamp(2,98))/100;
 }
 public function update(x:float,y:float) {
  Session.parameter-gesture("cutoff",1,20*pow(1000,x.clamp(0,1)));
  Session.command("parameter.preview","resonance","",((0.6 - y)/0.6).clamp(0,1));
 }
 public function finish(cancel:bool) {
  if root.dragging { root.dragging=false; Session.parameter-gesture("cutoff",cancel ? 3 : 2,root.cutoff); }
 }
 focus-lost(reason) => { if reason == FocusReason.window-activation { root.finish(true); } }
 key-pressed(event) => {
  if event.text == Key.Escape { root.finish(true); return accept; }
  if event.text == Key.LeftArrow || event.text == Key.RightArrow {
   Session.parameter-gesture("cutoff",0,root.cutoff);
   Session.parameter-gesture("cutoff",1,(root.cutoff * (event.text == Key.LeftArrow ? 0.9 : 1.1)).clamp(20,20000));
   Session.parameter-gesture("cutoff",2,root.cutoff); return accept;
  }
  return reject;
 }
 Rectangle { background: SamplerTheme.ink-0; border-width: 1px; border-color: SamplerTheme.line-1; border-radius: 2px;
  Rectangle { x: 8px; y: 4px+(parent.height - 8px)*0.22; width: parent.width - 16px; height: 1px; background: SamplerTheme.line-2; }
  for i in 120 : Path {
   x: 8px; y: 4px; width: parent.width - 16px; height: parent.height - 8px;
   viewbox-x: 0; viewbox-y: 0; viewbox-width: self.width/1px; viewbox-height: self.height/1px;
   fill: SamplerTheme.paper-1.with-alpha(0.07);
   MoveTo { x: i/120*parent.width/1px; y: parent.height/1px; }
   LineTo { x: i/120*parent.width/1px; y: root.response(i/120)*parent.height/1px; }
   LineTo { x: (i+1)/120*parent.width/1px; y: root.response((i+1)/120)*parent.height/1px; }
   LineTo { x: (i+1)/120*parent.width/1px; y: parent.height/1px; }
   Close { }
  }
  for i in 120 : Path {
   x: 8px; y: 4px; width: parent.width - 16px; height: parent.height - 8px;
   viewbox-x: 0; viewbox-y: 0; viewbox-width: self.width/1px; viewbox-height: self.height/1px;
   fill: transparent; stroke: SamplerTheme.paper-1; stroke-width: 1.75px;
   MoveTo { x: i/120*parent.width/1px; y: root.response(i/120)*parent.height/1px; }
   LineTo { x: (i+1)/120*parent.width/1px; y: root.response((i+1)/120)*parent.height/1px; }
  }
  Rectangle { x: 8px+log(root.cutoff/20,1000).clamp(0,1)*(parent.width - 16px); y: 4px; height: parent.height - 8px; width: 1px; background: SamplerTheme.accent; }
  Rectangle { x: 8px+log(root.cutoff/20,1000).clamp(0,1)*(parent.width - 16px) - 5px; y: 4px+root.response(log(root.cutoff/20,1000).clamp(0,1))*(parent.height - 8px) - 5px; width: 10px; height: 10px; border-radius: 5px; background: SamplerTheme.accent; border-width: 1px; border-color: SamplerTheme.ink-0; }
  SectionText { x: 10px; y: 3px; text: "0 dB"; font-family: SamplerTheme.font-value; font-size: 11px; }
  SectionText { x: 10px; y: parent.height - 17px; text: "20 Hz"; font-family: SamplerTheme.font-value; font-size: 11px; }
  SectionText { x: parent.width - self.preferred-width - 10px; y: parent.height - 17px; text: "20 kHz"; font-family: SamplerTheme.font-value; font-size: 11px; }
 }
 TouchArea { mouse-cursor: crosshair;
  pointer-event(event) => {
   if event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.enabled {
    root.focus(); root.dragging=Session.parameter-gesture("cutoff",0,root.cutoff);
    if root.dragging { root.update((self.mouse-x - 8px)/max(1px,root.width - 16px),(self.mouse-y - 4px)/max(1px,root.height - 8px)); }
   }
   if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.finish(false); }
   if event.kind == PointerEventKind.cancel { root.finish(true); }
  }
  moved => { if root.dragging { root.update((self.mouse-x - 8px)/max(1px,root.width - 16px),(self.mouse-y - 4px)/max(1px,root.height - 8px)); } }
 }
}

component VoiceEnvelopePlot inherits Rectangle {
 in property <bool> enabled: true;
 in property <[ParameterInfo]> parameters;
 in property <string> title;
 private property <float> attack: root.parameters[0].value/600;
 private property <float> decay: root.parameters[1].value/2111;
 private property <float> sustain: root.parameters[2].value;
 private property <float> release: root.parameters[3].value/4500;
 private property <float> off: 220/300;
 private property <string> active;
 private property <bool> modified;
 background: SamplerTheme.ink-0; border-width: 1px; border-color: SamplerTheme.line-1; border-radius: 2px;
 pure function handle-x(index:int) -> float { return index == 0 ? root.attack : index == 1 ? min(root.off - 0.02,root.attack+root.decay) : index == 2 ? root.off : min(1,root.off+root.release); }
 pure function handle-y(index:int) -> float { return index == 0 ? 0 : index == 3 ? 1 : 1 - root.sustain; }
 pure function primary(index:int) -> string { return root.parameters[index].id; }
 public function start(index:int) { root.active=root.primary(index); root.modified=false; Session.parameter-gesture(root.active,0,root.parameters[index].value); }
 public function update(index:int,x:float,y:float) {
  if root.active != root.primary(index) { return; }
  root.modified=true;
  if index == 0 { Session.parameter-gesture(root.active,1,x.clamp(0.002,0.5)*600); }
  else if index == 1 {
   Session.parameter-gesture(root.active,1,(x - root.attack).clamp(0.01,max(0.01,root.off - 0.02 - root.attack))*2111);
   Session.command("parameter.preview",root.parameters[2].id,"",(1 - y).clamp(0,1));
  } else if index == 2 { Session.parameter-gesture(root.active,1,(1 - y).clamp(0,1)); }
  else { Session.parameter-gesture(root.active,1,(x - root.off).clamp(0.01,1 - root.off)*4500); }
 }
 public function finish(index:int,cancel:bool) {
  if root.active == root.primary(index) { let id=root.active; root.active=""; Session.parameter-gesture(id,cancel || !root.modified ? 3 : 2,root.parameters[index].value); }
 }
 Path { x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px; fill: SamplerTheme.paper-1.with-alpha(0.07);
  viewbox-x: 0; viewbox-y: 0; viewbox-width: self.width/1px; viewbox-height: self.height/1px;
  MoveTo { x: 0; y: parent.height/1px; }
  LineTo { x: root.handle-x(0)*parent.width/1px; y: 0; }
  LineTo { x: root.handle-x(1)*parent.width/1px; y: root.handle-y(1)*parent.height/1px; }
  LineTo { x: root.off*parent.width/1px; y: root.handle-y(2)*parent.height/1px; }
  LineTo { x: root.handle-x(3)*parent.width/1px; y: parent.height/1px; }
  Close { }
 }
 Path { x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px; fill: transparent; stroke: SamplerTheme.paper-1; stroke-width: 1.5px;
  viewbox-x: 0; viewbox-y: 0; viewbox-width: self.width/1px; viewbox-height: self.height/1px;
  MoveTo { x: 0; y: parent.height/1px; }
  LineTo { x: root.handle-x(0)*parent.width/1px; y: 0; }
  LineTo { x: root.handle-x(1)*parent.width/1px; y: root.handle-y(1)*parent.height/1px; }
  LineTo { x: root.off*parent.width/1px; y: root.handle-y(2)*parent.height/1px; }
  LineTo { x: root.handle-x(3)*parent.width/1px; y: parent.height/1px; }
 }
 Rectangle { x: 8px+root.off*(parent.width - 16px); y: 6px; width: 1px; height: parent.height - 12px; background: SamplerTheme.line-3; }
 for name[i] in ["attack","decay","sustain","release"] : FocusScope {
  x: 8px+root.handle-x(i)*(parent.width - 16px) - 5.5px; y: 6px+root.handle-y(i)*(parent.height - 12px) - 5.5px; width: 11px; height: 11px;
  enabled: root.enabled; focus-on-tab-navigation: root.enabled; accessible-enabled: root.enabled; accessible-role: slider; accessible-label: root.title+" "+name+" handle";
  accessible-value: root.parameters[i].value; accessible-value-minimum: root.parameters[i].minimum; accessible-value-maximum: root.parameters[i].maximum;
  focus-lost(reason) => { if reason == FocusReason.window-activation { root.finish(i,true); } }
  key-pressed(event) => {
   if event.text == Key.Escape { root.finish(i,true); return accept; }
   if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow {
    root.start(i); root.modified=true; let p=root.parameters[i];
    Session.parameter-gesture(p.id,1,(p.value+((event.text == Key.UpArrow || event.text == Key.RightArrow) ? p.step : -p.step)).clamp(p.minimum,p.maximum));
    root.finish(i,false); return accept;
   }
   return reject;
  }
  Rectangle { border-radius: 6px; background: SamplerTheme.ink-5; border-width: 1px; border-color: parent.has-focus ? SamplerTheme.accent : SamplerTheme.paper-1; }
  TouchArea { mouse-cursor: grab; enabled: root.enabled;
   pointer-event(event) => {
    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.enabled { parent.focus(); root.start(i); }
    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.finish(i,false); }
    if event.kind == PointerEventKind.cancel { root.finish(i,true); }
   }
   moved => { if self.pressed { root.update(i,(parent.x+self.mouse-x - 8px)/max(1px,root.width - 16px),(parent.y+self.mouse-y - 6px)/max(1px,root.height - 12px)); } }
  }
 }
}

component VoiceSourceCard inherits PageSection {
 in property <ModuleInfo> source;
 in property <bool> editable: true;
 callback context-action(string,string);
 private property <int> columns: max(1,floor((root.width - 24px)/52px));
 title: "Audio source"; subtitle: root.source.name; header-height: 24px;
 height: 68px+ceil(root.source.parameters.length/root.columns)*60px;
 OptionStrip { x: 12px; y: 31px; width: min(250px,parent.width - 24px); label: root.source.name+" mode"; value: root.source.mode; enabled: root.editable;
  options: root.source.kind == "noise" ? [{id:"white",label:"White"},{id:"pink",label:"Pink"}] :
   root.source.kind == "oscillator" ? [{id:"sine",label:"Sine"},{id:"saw",label:"Saw"},{id:"square",label:"Square"}] :
   root.source.kind == "sampler" ? [{id:"once",label:"Once"},{id:"gated",label:"Gated"},{id:"loop",label:"Loop"}] :
   [{id:"notes",label:"Follows notes"},{id:"drone",label:"Drone"}];
  selected(v) => { Session.command("module.mode",root.source.id,v,0); }
 }
 for p[i] in root.source.parameters : ParamKnob {
  private property <float> scale: p.unit == "%" ? 100 : 1;
  x: 12px+mod(i,root.columns)*52px; y: 62px+floor(i/root.columns)*60px; width: 48px;
  label: p.label; accessible-label: root.source.name+" "+p.label; parameter-id: p.id; size: 28px; value-display-always: true;
  model-value: p.value*self.scale; value: p.value*self.scale; minimum: p.minimum*self.scale; maximum: p.maximum*self.scale; step: p.step*self.scale; default-value: p.default-value*self.scale; unit: p.unit; bipolar: p.bipolar; enabled: root.editable && p.available;
  gesture-began => { Session.parameter-gesture(p.id,0,self.value/self.scale); }
  changed(v) => { Session.parameter-gesture(p.id,1,v/self.scale); }
  gesture-ended => { Session.parameter-gesture(p.id,2,self.value/self.scale); }
  context-action(a) => { root.context-action(a,p.id); }
 }
}

component VoiceRenderDialog inherits FocusScope {
 in-out property <string> mode <=> VoiceDialogState.mode;
 init => { if root.mode != "" { root.focus(); Session.release-notes(); } }
 changed mode => { if root.mode != "" { root.focus(); Session.release-notes(); } }
 private property <int> field-columns: max(1,min(5,floor((panel.width - 16px)/88px)));
 private property <bool> busy: Session.freeze-state == "running";
 private property <bool> restore-cancel-focus;
 Timer { interval: 0ms; running: root.restore-cancel-focus; triggered => { root.restore-cancel-focus=false; cancel-render.focus(); } }
 private property <int> notes: Session.autosampler-parameters.length < 6 ? 0 : floor((Session.autosampler-parameters[1].value - Session.autosampler-parameters[0].value)/max(1,Session.autosampler-parameters[2].value))+1;
 private property <int> renders: root.notes * (Session.autosampler-parameters.length < 6 ? 0 : Session.autosampler-parameters[3].value * Session.autosampler-parameters[5].value);
 visible: root.mode != "";
 public function open(mode:string) { root.mode=mode; root.focus(); Session.release-notes(); }
 public function close() {
  if root.busy && root.mode != "source" { Session.command(root.mode == "auto" ? "autosampler.cancel" : "freeze.cancel","","",0); }
  root.mode="";
  root.restore-cancel-focus=false;
 }
 key-pressed(event) => { if event.text == Key.Escape { root.close(); return accept; } return reject; }
 Rectangle { background: SamplerTheme.scrim; }
 TouchArea { clicked => { root.close(); } }
 panel := Rectangle {
  x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
  width: min(480px,parent.width*0.92); height: min(parent.height*0.86,root.mode == "source" ? 240px : root.mode == "auto" ? 352px : 296px);
  background: SamplerTheme.ink-2; border-width: 1px; border-color: SamplerTheme.line-3; border-radius: 6px;
  TouchArea { }
  Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 34px; background: SamplerTheme.ink-3; border-radius: 5px;
   Text { x: 11px; height: parent.height; width: parent.width - 50px; text: root.mode == "source" ? "ADD AUDIO SOURCE" : root.mode == "auto" ? "SAMPLE THIS PATCH" : "FREEZE SOURCE"; font-family: SamplerTheme.font-ui; font-size: 13px; font-weight: 700; letter-spacing: 1.3px; color: SamplerTheme.paper-2; vertical-alignment: center; }
   ActionButton { x: parent.width - 30px; y: 5px; width: 24px; icon: "close"; label: "Close render dialog"; compact: true; ghost: true; clicked => { root.close(); } }
  }
  ScrollView { x: 1px; y: 35px; width: parent.width - 2px; height: max(1px,parent.height - 80px);
   Rectangle { width: parent.width; height: root.mode == "source" ? 160px : root.mode == "auto" ? 244px+(root.field-columns < 5 ? 52px : 0px) : 212px;
    if root.mode == "source" : VerticalLayout { padding: 12px; spacing: 4px; alignment: start;
     for kind in ["Sampler","Synth patch","Oscillator","Noise"] : ActionButton { text: kind; height: 28px; compact: true; clicked => { Session.command("module.add","voice",kind,0); root.close(); } }
    }
    if root.mode == "auto" : Rectangle {
     x: 12px; width: parent.width - 24px;
     SectionText { y: 6px; text: "Source"; width: 80px; }
     SectionText { x: 88px; y: 6px; width: parent.width - 88px; text: Session.patch-name; color: SamplerTheme.paper-1; }
     SectionText { y: 30px; text: "Renders"; width: 80px; }
     SectionText { x: 88px; y: 30px; width: parent.width - 88px; text: root.renders+" · "+root.notes+" notes × "+Session.autosampler-parameters[5].value+" layers × "+Session.autosampler-parameters[3].value+" takes"; color: SamplerTheme.paper-1; }
     SectionText { y: 54px; text: "Estimate"; width: 80px; }
     SectionText { x: 88px; y: 54px; width: parent.width - 88px; text: "~"+max(1,round(root.renders*6/60))+" min offline · simulated"; color: SamplerTheme.paper-1; }
     fields := Rectangle { y: 84px; width: parent.width; height: ceil(5/self.columns)*52px;
      in property <int> columns: root.field-columns;
      for field[i] in ["lo","hi","step","rr","tail"] : NumericField {
       x: mod(i,parent.columns)*88px; y: floor(i/parent.columns)*52px; width: 80px;
       label: Session.autosampler-parameters[i].label; model-value: Session.autosampler-parameters[i].value; value: Session.autosampler-parameters[i].value;
       minimum: Session.autosampler-parameters[i].minimum; maximum: Session.autosampler-parameters[i].maximum; step: 1; unit: Session.autosampler-parameters[i].unit; enabled: !root.busy;
       changed(v) => { Session.command("autosampler.configure","",field,v); }
      }
     }
     OptionStrip { y: fields.y+fields.height+4px; width: 240px; label: "Velocity layers"; value: ""+Session.autosampler-parameters[5].value; enabled: !root.busy; options: [{id:"1",label:"1 layer"},{id:"2",label:"2 layers"},{id:"3",label:"3 layers"}]; selected(v) => { Session.command("autosampler.configure","","layers",v.to-float()); } }
     Text { y: fields.y+fields.height+34px; width: parent.width; text: "Silent mock render. Each cached sample retains source, root note, velocity layer, take and tail provenance."; font-family: SamplerTheme.font-ui; font-size: 12px; color: SamplerTheme.paper-3; wrap: word-wrap; }
    }
    if root.mode == "freeze" : Rectangle { x: 12px; width: parent.width - 24px;
     SectionText { y: 6px; width: 80px; text: "Source"; }
     SectionText { x: 88px; y: 6px; width: parent.width - 88px; text: Session.selected-source; color: SamplerTheme.paper-1; }
     SectionText { y: 30px; width: 80px; text: "Includes"; }
     SectionText { x: 88px; y: 30px; width: parent.width - 88px; text: Session.freeze-mode == "src" ? "Audio source only" : "Source, voice and inserts"; color: SamplerTheme.paper-1; }
     SectionText { y: 54px; width: 80px; text: "Stored as"; }
     SectionText { x: 88px; y: 54px; width: parent.width - 88px; text: "Frozen silent mock source"; color: SamplerTheme.paper-1; }
     OptionStrip { y: 84px; width: min(280px,parent.width - 80px); label: "Freeze includes"; value: Session.freeze-mode; enabled: !root.busy; options: [{id:"src",label:"Source only"},{id:"chain",label:"Source + voice + inserts"}]; selected(v) => { Session.command("freeze.configure",v,"mode",0); } }
     NumericField { x: parent.width - 72px; y: 84px; width: 72px; label: "Tail"; unit: "s"; model-value: Session.freeze-tail; value: Session.freeze-tail; minimum: 0; maximum: 30; step: 1; enabled: !root.busy; changed(v) => { Session.command("freeze.configure","","tail",v); } }
     Text { y: 142px; width: parent.width; text: "Silent mock render; no audio is captured. Freeze locks voice controls. Unfreeze restores the original source."; font-family: SamplerTheme.font-ui; font-size: 12px; color: SamplerTheme.paper-3; wrap: word-wrap; }
    }
   }
  }
  Rectangle { x: 1px; y: parent.height - 45px; width: parent.width - 2px; height: 44px; background: SamplerTheme.ink-2;
   Rectangle { height: 1px; background: SamplerTheme.line-1; }
   if root.busy : Text { x: 12px; y: 8px; width: max(0px,parent.width - 198px); text: "Rendering silent mock · "+round(Session.render-progress*100)+"%"; font-family: SamplerTheme.font-ui; font-size: 11px; color: SamplerTheme.paper-3; }
   if root.busy : Rectangle { x: 12px; y: 28px; width: max(0px,parent.width - 198px); height: 4px; background: SamplerTheme.ink-4; border-radius: 2px; Rectangle { width: parent.width*Session.render-progress.clamp(0,1); background: SamplerTheme.paper-2; border-radius: 2px; } }
   if !root.busy && Session.freeze-state == "failed" : Text { x: 12px; y: 8px; width: max(0px,parent.width - 190px); text: Session.error; font-family: SamplerTheme.font-ui; font-size: 11px; color: SamplerTheme.error; wrap: word-wrap; }
   cancel-render := ActionButton { x: parent.width - 178px; y: 8px; width: 70px; text: "Cancel"; label: "Cancel render dialog"; ghost: true; compact: true; clicked => { root.close(); } }
   if root.mode != "source" : ActionButton { x: parent.width - 100px; y: 8px; width: 88px; text: root.mode == "auto" ? "Render" : "Freeze"; primary: true; compact: true; enabled: !root.busy && (root.mode != "auto" || root.renders <= 4096); clicked => { Session.command(root.mode == "auto" ? "autosampler.start" : "freeze.start",Session.selected-source,"",0); root.restore-cancel-focus=true; } }
  }
 }
}

export component VoicePage inherits FocusScope {
 focus-on-click: false;
 focus-on-tab-navigation: false;
 capture-key-pressed(event) => { if modal.mode != "" && event.text == Key.Escape { modal.close(); return accept; } return reject; }
 in property <bool> compact;
 in property <bool> expanded;
 callback context-action(string,string);
 public function add-module() { Session.command("module.add","voice","Waveshaper",0); }
 ScrollView { VerticalLayout { padding: 0px; spacing: 4px; alignment: start;
  PageSection { title: "Voice"; subtitle: "Sound template"; height: 126px;
   HorizontalLayout { x: 12px; y: 45px; width: parent.width - 24px; height: 34px; spacing: 4px; alignment: start;
    for module in Session.voice-modules : ActionButton { text: module.name+"  →"; selected: module.id == Session.selected-id; compact: root.compact; clicked => { Session.command("selection.set",module.id,"",0); } }
    add-module := ActionButton { text: "+"; label: "Add voice module"; clicked => { root.add-module(); } }
   }
   HorizontalLayout { x: 12px; y: 85px; width: parent.width - 24px; height: 26px; spacing: 4px; alignment: start;
    ActionButton { text: "Edit source"; icon: "chevron-right"; compact: true; clicked => { Session.command("page.select","sample","",0); } }
    ActionButton { text: "Sample patch…"; icon: "variation"; compact: true; clicked => { modal.open("auto"); } }
    ActionButton { text: "Add source…"; icon: "plus"; compact: true; clicked => { modal.open("source"); } }
    ActionButton { text: "Freeze…"; icon: "lock"; compact: true; enabled: !Session.voice-frozen && Session.freeze-state != "running"; clicked => { modal.open("freeze"); } }
    if Session.voice-frozen : ActionButton { icon: "reset"; label: "Unfreeze · restore original source"; compact: true; clicked => { Session.command("sample.unfreeze",Session.selected-source,"",0); } }
   }
  }
  PageSection { title: "Audio source"; subtitle: "Sampler · Sample player"; header-height: 24px; height: 126px;
   OptionStrip { x: 12px; y: 31px; width: min(230px,parent.width - 24px); label: "Source playback"; value: Session.play-mode; enabled: !Session.voice-frozen; options: [{id:"once",label:"Once"},{id:"gated",label:"Gated"},{id:"loop",label:"Loop"}]; selected(v) => { Session.command("sample.mode","",v,0); } }
   HorizontalLayout { x: 12px; y: 62px; width: parent.width - 24px; height: 60px; alignment: start; spacing: 4px; for p in Session.source-parameters : DomainKnob { parameter: p; enabled: !Session.voice-frozen && p.available; size: 28px; value-display-always: true; context(a,id) => { root.context-action(a,id); } } }
  }
  for source in Session.voice-modules : VoiceSourceCard { visible: source.id != "source" && source.kind != "processor"; height: self.visible ? 68px+ceil(source.parameters.length/max(1,floor((self.width - 24px)/52px)))*60px : 0px; source: source; editable: !Session.voice-frozen; context-action(a,id) => { root.context-action(a,id); } }
  HorizontalLayout { height: root.compact ? 158px : 192px; spacing: 4px;
   PageSection { title: "Pitch"; horizontal-stretch: 1; HorizontalLayout { x: 12px; y: 50px; width: parent.width - 24px; height: 68px; alignment: start; spacing: 10px; for p in Session.pitch-parameters : DomainKnob { parameter: p; enabled: !Session.voice-frozen && p.available; size: root.compact ? 32px : 40px; context(a,id) => { root.context-action(a,id); } } } }
   PageSection { title: "Amplifier"; horizontal-stretch: 1; HorizontalLayout { x: 12px; y: 50px; width: parent.width - 24px; height: 68px; alignment: start; spacing: 10px; for p in Session.amp-parameters : DomainKnob { parameter: p; enabled: !Session.voice-frozen && p.available; size: root.compact ? 32px : 40px; context(a,id) => { root.context-action(a,id); } } } }
  }
  PageSection { title: "Filter response"; subtitle: "Ladder "+Session.filter-mode.to-uppercase()+" 24 dB · drag cutoff and resonance"; height: 73px+(root.compact ? 64px : root.expanded ? 110px : 84px)+80px; header-height: 24px;
   OptionStrip { x: 12px; y: 31px; width: min(260px,parent.width - 24px); label: "Filter type"; value: Session.filter-mode; enabled: !Session.voice-frozen; options: [{id:"lp",label:"LP"},{id:"bp",label:"BP"},{id:"hp",label:"HP"},{id:"notch",label:"Notch"}]; selected(v) => { Session.command("filter.mode","",v,0); } }
   filter-plot := VoiceFilterPlot { x: 12px; y: 61px; width: parent.width - 24px; height: root.compact ? 64px : root.expanded ? 110px : 84px; parameters: Session.filter-parameters; enabled: !Session.voice-frozen; accessible-enabled: !Session.voice-frozen; }
   HorizontalLayout { x: 12px; y: filter-plot.y+filter-plot.height+8px; width: parent.width - 24px; height: 68px; spacing: 8px; alignment: start; for p in Session.filter-parameters : DomainKnob { parameter: p; enabled: !Session.voice-frozen && p.available; size: 28px; context(a,id) => { root.context-action(a,id); } } }
  }
  Rectangle { height: root.compact ? 2*(153px+44px)+4px : 153px+(root.expanded ? 72px : 56px);
   for group[i] in ["Amp envelope","Filter envelope"] : PageSection { x: root.compact ? 0px : i*(parent.width+4px)/2; y: root.compact ? i*(197px+4px) : 0px; width: root.compact ? parent.width : (parent.width - 4px)/2; title: group; height: 153px+(root.compact ? 44px : root.expanded ? 72px : 56px); header-height: 30px;
    envelope-plot := VoiceEnvelopePlot { x: 12px; y: 41px; width: parent.width - 24px; height: root.compact ? 44px : root.expanded ? 72px : 56px; title: group; parameters: group == "Amp envelope" ? Session.amp-envelope-parameters : Session.filter-envelope-parameters; enabled: !Session.voice-frozen; }
    HorizontalLayout { x: 12px; y: envelope-plot.y+envelope-plot.height+8px; width: parent.width - 24px; height: 78px; spacing: 2px; alignment: start; for p in group == "Amp envelope" ? Session.amp-envelope-parameters : Session.filter-envelope-parameters : DomainKnob { parameter: p; enabled: !Session.voice-frozen && p.available; size: 28px; value-display-always: true; context(a,id) => { root.context-action(a,id); } } }
   }
  }
  PageSection { title: "Voice policy"; secondary: true; height: 138px;
   OptionStrip { x: 12px; y: 45px; width: 180px; label: "Voice policy"; enabled: !Session.voice-frozen; value: Session.voice-policy; options: [{id:"poly",label:"Poly"},{id:"mono",label:"Mono"},{id:"legato",label:"Legato"}]; selected(v) => { Session.command("voice.policy","",v,0); } }
   NumericField { x: 206px; y: 45px; label: "Voice limit"; enabled: !Session.voice-frozen; model-value: Session.voice-limit; value: Session.voice-limit; minimum: 1; maximum: 128; step: 1; changed(v) => { Session.command("voice.limit","","",v); } }
   OptionStrip { x: 12px; y: 92px; width: 220px; label: "Steal policy"; enabled: !Session.voice-frozen; value: Session.voice-steal; options: [{id:"oldest",label:"Oldest"},{id:"quietest",label:"Quietest"},{id:"none",label:"No steal"}]; selected(v) => { Session.command("voice.steal","",v,0); } }
   ActionButton { x: 244px; y: 92px; text: "Retrigger"; enabled: !Session.voice-frozen; clicked => { Session.command("voice.same-note","","retrigger",0); } }
  }
 } }
 modal := VoiceRenderDialog { }
}
