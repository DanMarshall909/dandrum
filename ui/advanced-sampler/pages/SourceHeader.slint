import { Session } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";

export component SourceHeader inherits Rectangle {
    height: 28px;
    HorizontalLayout { padding-left: 4px; spacing: 4px; alignment: start;
        ActionButton { width: 24px; compact: true; ghost: true; icon: "chevron-left"; label: "Back to Voice"; clicked => { Session.command("page.select", "", "voice", 0); } }
        Text { width: 36px; text: "Voice"; font-family: SamplerTheme.font-ui; font-size: 13px; color: SamplerTheme.paper-3; vertical-alignment: center; }
        Text { width: 12px; text: "›"; font-family: SamplerTheme.font-ui; font-size: 13px; color: SamplerTheme.paper-4; vertical-alignment: center; }
        Text { width: 172px; text: "Audio source · Sampler"; font-family: SamplerTheme.font-ui; font-size: 13px; font-weight: 600; color: SamplerTheme.paper-1; vertical-alignment: center; }
        Rectangle { width: 1px; y: 5px; height: 18px; background: SamplerTheme.line-2; }
        ActionButton { width: 58px; text: "SAMPLE"; label: "Sample source editor"; compact: true; ghost: true; selected: Session.page == "sample"; clicked => { Session.command("page.select", "", "sample", 0); } }
        ActionButton { width: 58px; text: "SLICES"; label: "Slices source editor"; compact: true; ghost: true; selected: Session.page == "slices"; clicked => { Session.command("page.select", "", "slices", 0); } }
    }
}
