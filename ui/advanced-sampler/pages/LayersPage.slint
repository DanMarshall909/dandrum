import { ScrollView } from "std-widgets.slint";
import { Session } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { OptionStrip } from "../controls/OptionStrip.slint";
import { DragTarget } from "../chrome/DragState.slint";
import { NumericField } from "../controls/NumericField.slint";
import { PageSection, SectionText } from "PageSection.slint";
component VelocityRangeHandle inherits FocusScope {
 in property <string> zone-id;
 in property <string> edge;
 in property <string> name;
 in property <float> model-value;
 in property <length> graph-width;
 private property <length> origin;
 private property <float> initial;
 private property <float> latest;
 private property <bool> captured;
 accessible-role: button; accessible-label: "Velocity range "+(root.edge == "vel-hi" ? "high " : "low ")+root.name;
 public function finish(cancel:bool) { if root.captured { Session.parameter-gesture("zone:"+root.zone-id+":"+root.edge,cancel ? 3 : 2,root.latest); root.captured=false; } }
 focus-lost(reason) => { if reason == FocusReason.window-activation { root.finish(true); } }
 key-pressed(e) => { if e.text == Key.Escape { root.finish(true); return accept; } return reject; }
 Rectangle { x: 3px; width: 2px; height: parent.height; background: SamplerTheme.accent; }
 Rectangle { y: parent.height - 10px; width: 8px; height: 10px; background: SamplerTheme.accent; border-radius: 2px; }
 TouchArea { mouse-cursor: ew-resize;
  pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.focus(); Session.command("zone.select",root.zone-id,"",0); root.origin=self.absolute-position.x+self.mouse-x;root.initial=root.model-value;root.latest=root.model-value;root.captured=Session.parameter-gesture("zone:"+root.zone-id+":"+root.edge,0,root.model-value); } if e.kind == PointerEventKind.up { root.finish(false); } if e.kind == PointerEventKind.cancel { root.finish(true); } }
  moved => { if root.captured && self.pressed { root.latest=root.initial+round((self.absolute-position.x+self.mouse-x - root.origin)/root.graph-width*127);Session.parameter-gesture("zone:"+root.zone-id+":"+root.edge,1,root.latest); } }
 }
}
export component LayersPage inherits Rectangle {
 in property <bool> compact;
 in property <bool> expanded;
 callback context-action(string,string);
 pure function gain(t:float,low:float,high:float) -> float {
  let width = max(1,Session.crossfade-width);
  let f = (low <= 1 ? (high + 1 - t*127)/width : (t*127 - low + 1)/width).clamp(0,1);
  return Session.crossfade-curve == "none" ? (t*127 >= low - 1 && t*127 <= high ? 1 : 0) : Session.crossfade-curve == "linear" ? f : sin(f*90deg);
 }
 public function set-mode(mode:string) { Session.command("selector.mode","",mode,0); }
 public function add-layer() { Session.command("layer.add",Session.selected-source,"New layer",Session.root-note); }
 ScrollView { VerticalLayout { padding: 0px; spacing: 4px; alignment: start;
  PageSection { title: "Selector"; subtitle: "Snare · velocity and alternates"; height: 148px;
   selector-modes := OptionStrip { x: 12px; y: 45px; width: parent.width - 24px; value: Session.selector-mode; label: "Selection policy"; options: [{id:"stack",label:"Stack"},{id:"velocity",label:"Velocity"},{id:"round-robin",label:"Round robin"},{id:"alternate",label:"Alternate"},{id:"random",label:"Random"},{id:"weighted",label:"Weighted"}]; selected(mode) => { root.set-mode(mode); } }
   SectionText { x: 12px; y: 75px; width: parent.width - 24px; height: 26px; text: Session.selector-mode == "stack" ? "All samples play on every hit." : Session.selector-mode == "velocity" ? "Choose by velocity. Overlapping ranges crossfade." : Session.selector-mode == "round-robin" ? "Each note keeps its own position in the cycle." : Session.selector-mode == "alternate" ? "Alternate the candidates on every hit." : Session.selector-mode == "random" ? (Session.no-immediate-repeat ? "Random selection; never the same candidate twice." : "Random selection; immediate repeats allowed.") : "Choose in proportion to candidate weight."; }
   ActionButton { x: 12px; y: 108px; text: "Restart cycle"; clicked => { Session.command("selector.reset","","",0); } }
   add-layer := ActionButton { x: 126px; y: 108px; text: "+ Layer"; clicked => { root.add-layer(); } }
  }
  if Session.selector-mode == "velocity" : PageSection { title: "Blend axis"; height: Session.selector-axis == "macro" || Session.selector-axis == "mod" ? 126px : 82px;
   OptionStrip { x: 12px; y: 43px; width: parent.width - 24px; label: "Blend axis"; value: Session.selector-axis; options: [{id:"vel",label:"Velocity"},{id:"macro",label:"Macro"},{id:"mod",label:"Modulator"},{id:"key",label:"Key"}]; selected(axis) => { Session.command("selector.axis","",axis,0); } }
   if Session.selector-axis == "macro" : Flickable { x: 12px; y: 76px; width: parent.width - 24px; height: 25px; content-width: Session.macros.length*90px; content-height: self.height;
    for macro[i] in Session.macros : ActionButton { x: i*90px; width: 88px; height: 24px; text: macro.name; label: "Blend macro "+macro.name; selected: Session.selector-source == macro.id; compact: true; clicked => { Session.command("selector.source",macro.id,"",0); } }
   }
   if Session.selector-axis == "mod" : Flickable { x: 12px; y: 76px; width: parent.width - 24px; height: 25px; content-width: Session.modulators.length*112px; content-height: self.height;
    for mod[i] in Session.modulators : ActionButton { x: i*112px; width: 108px; height: 24px; text: mod.name; label: "Blend modulator "+mod.name; selected: Session.selector-source == mod.id; compact: true; clicked => { Session.command("selector.source",mod.id,"",0); } }
   }
  }
  if Session.selector-mode == "velocity" : PageSection { title: "Velocity crossfade"; height: root.compact ? 160px : 196px;
   graph := Rectangle { x: 12px; y: 43px; width: parent.width - 24px; height: parent.height - 82px; background: SamplerTheme.ink-0; border-width: 1px; border-color: SamplerTheme.line-2;
    for i in 5 : Rectangle { x: i*parent.width/4; width: 1px; height: parent.height; background: SamplerTheme.line-1; }
    for z in Session.candidates : Rectangle { x: (z.vel-low - 1)/127*parent.width; width: (z.vel-high - z.vel-low+1)/127*parent.width; height: parent.height; background: z.id == Session.selected-zone ? SamplerTheme.accent.with-alpha(0.15) : SamplerTheme.secondary.with-alpha(0.12); border-width: 1px; border-color: z.id == Session.selected-zone ? SamplerTheme.accent : SamplerTheme.secondary;
     Text { x: 5px; y: 5px; text: z.name; color: SamplerTheme.paper-2; font-family: SamplerTheme.font-ui; font-size: 11px; }
     TouchArea { clicked => { Session.command("zone.select",z.id,"",0); } }
    }
    for z in Session.candidates : Rectangle { width: parent.width; height: parent.height;
     for i in 100 : Path { width: parent.width; height: parent.height; viewbox-x: 0; viewbox-y: 0; viewbox-width: self.width/1px; viewbox-height: self.height/1px;fill: transparent;stroke: z.vel-low <= 1 ? SamplerTheme.secondary : SamplerTheme.accent;stroke-width: 1.5px;
      MoveTo { x: i/100*parent.width/1px; y: (0.95 - root.gain(i/100,z.vel-low,z.vel-high)*min(1,pow(10,z.gain/20))*0.85)*parent.height/1px; }
      LineTo { x: (i+1)/100*parent.width/1px; y: (0.95 - root.gain((i+1)/100,z.vel-low,z.vel-high)*min(1,pow(10,z.gain/20))*0.85)*parent.height/1px; }
     }
     VelocityRangeHandle { visible: z.vel-high < 127; x: z.vel-high/127*parent.width - 4px; width: 8px; height: parent.height; zone-id: z.id; edge: "vel-hi"; name: z.name; model-value: z.vel-high; graph-width: parent.width; }
     VelocityRangeHandle { visible: z.vel-low > 1; x: (z.vel-low - 1)/127*parent.width - 4px; width: 8px; height: parent.height; zone-id: z.id; edge: "vel-lo"; name: z.name; model-value: z.vel-low; graph-width: parent.width; }
    }

   }
   NumericField { x: parent.width - 134px; y: parent.height - 32px; width: 120px; label: "Crossfade width"; model-value: Session.crossfade-width; value: Session.crossfade-width; minimum: 0; maximum: 64; step: 1; gesture-began => { Session.parameter-gesture("crossfade-width",0,self.value); } changed(v) => { Session.parameter-gesture("crossfade-width",1,v); } gesture-ended => { Session.parameter-gesture("crossfade-width",2,self.value); } }
   OptionStrip { x: 12px; y: parent.height - 31px; width: 232px; label: "Crossfade curve"; value: Session.crossfade-curve; options: [{id:"equal-power",label:"Equal power"},{id:"linear",label:"Linear"},{id:"none",label:"No crossfade"}]; selected(curve) => { Session.command("selector.crossfade","",curve,curve == "none" ? 0 : Session.crossfade-width); } }
  }
  if Session.selector-mode == "round-robin" || Session.selector-mode == "alternate" || Session.selector-mode == "random" || Session.selector-mode == "weighted" : PageSection { title: "Take policy"; height: root.compact ? 108px : 82px;
   ActionButton { x: 12px; y: 43px; text: "Lock takes across mics and layers"; selected: Session.take-lock; clicked => { Session.command("selector.lock","","",Session.take-lock ? 0 : 1); } }
   ActionButton { x: root.compact ? 12px : 266px; y: root.compact ? 74px : 43px; text: "No immediate repeat"; selected: Session.no-immediate-repeat; clicked => { Session.command("selector.no-repeat","","",Session.no-immediate-repeat ? 0 : 1); } }
  }
  Rectangle { height: 30px; background: SamplerTheme.ink-3; SectionText { text: "Drop a sample or slice here to add a candidate"; } DragTarget { accepted-kind: "source"; dropped(id) => { return Session.command("layer.add",id,"New layer",Session.root-note); } } }
  PageSection { title: "Candidates"; secondary: true; height: 70px + Session.candidates.length * 88px;
   for layer[i] in Session.candidates : Rectangle { x: 8px; y: 40px+i*88px; width: parent.width - 16px; height: 86px; background: layer.id == Session.selected-zone ? SamplerTheme.accent-wash : mod(i,2) == 0 ? SamplerTheme.ink-3 : transparent; border-width: layer.id == Session.selected-zone ? 1px : 0px; border-color: SamplerTheme.accent;
    ActionButton { x: 4px; y: 7px; width: root.compact ? 100px : 158px; text: (i+1)+"  "+layer.name; ghost: true; compact: true; clicked => { Session.command("zone.select",layer.id,"",0); } }
    SectionText { x: root.compact ? 108px : 168px; width: 110px; height: 38px; text: "velocity "+layer.vel-low+"–"+layer.vel-high; font-family: SamplerTheme.font-value; font-size: 10px; }
    NumericField { x: root.compact ? 215px : 284px; y: 8px; width: 68px; label: "Weight"; model-value: layer.weight; value: layer.weight; minimum: 0; maximum: 1000; step: 0.1; gesture-began => { Session.parameter-gesture("layer:"+layer.id+":weight",0,self.value); } changed(v) => { Session.parameter-gesture("layer:"+layer.id+":weight",1,v); } gesture-ended => { Session.parameter-gesture("layer:"+layer.id+":weight",2,self.value); } }
    NumericField { x: 8px+0*(root.compact ? 90px : 108px); y: 48px; width: root.compact ? 84px : 100px; label: "Gain "+layer.name; value: layer.gain; model-value: layer.gain; minimum: -60; maximum: 12; unit: "dB"; step: 0.1; gesture-began => { Session.parameter-gesture("layer:"+layer.id+":gain",0,self.value); } changed(v) => { Session.parameter-gesture("layer:"+layer.id+":gain",1,v); } gesture-ended => { Session.parameter-gesture("layer:"+layer.id+":gain",2,self.value); } }
    NumericField { x: 8px+1*(root.compact ? 90px : 108px); y: 48px; width: root.compact ? 84px : 100px; label: "Pan "+layer.name; value: layer.pan; model-value: layer.pan; minimum: -1; maximum: 1; unit: ""; step: 0.01; gesture-began => { Session.parameter-gesture("layer:"+layer.id+":pan",0,self.value); } changed(v) => { Session.parameter-gesture("layer:"+layer.id+":pan",1,v); } gesture-ended => { Session.parameter-gesture("layer:"+layer.id+":pan",2,self.value); } }
    NumericField { x: 8px+2*(root.compact ? 90px : 108px); y: 48px; width: root.compact ? 84px : 100px; label: "Pitch "+layer.name; value: layer.pitch; model-value: layer.pitch; minimum: -48; maximum: 48; unit: "st"; step: 0.1; gesture-began => { Session.parameter-gesture("layer:"+layer.id+":pitch",0,self.value); } changed(v) => { Session.parameter-gesture("layer:"+layer.id+":pitch",1,v); } gesture-ended => { Session.parameter-gesture("layer:"+layer.id+":pitch",2,self.value); } }
    ActionButton { x: parent.width - 98px; y: 49px; width: 94px; text: layer.output == "" || layer.output == "inherit" ? "Inherit" : layer.output; label: "Output "+layer.name; compact: true; clicked => { Session.command("layer.output",layer.id,layer.output == "Main 1/2" ? "inherit" : "Main 1/2",0); } }
    ActionButton { x: parent.width - 105px; y: 8px; text: "M"; label: "Mute " + layer.name; selected: layer.muted; compact: true; clicked => { Session.command("layer.mute",layer.id,"",0); } }
    ActionButton { x: parent.width - 80px; y: 8px; text: "S"; label: "Solo " + layer.name; selected: layer.solo; compact: true; clicked => { Session.command("layer.solo",layer.id,"",0); } }
    ActionButton { x: parent.width - 55px; y: 8px; text: "↑"; label: "Move layer up"; compact: true; clicked => { Session.command("layer.move",layer.id,"",-1); } }
    ActionButton { x: parent.width - 30px; y: 8px; text: "×"; label: "Remove " + layer.name; compact: true; clicked => { Session.command("layer.delete",layer.id,"",0); } }
   }
  }
 } }
}
