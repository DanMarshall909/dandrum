import { ReadOnlyKeyMap } from "ReadOnlyKeyMap.slint";
import { ScrollView } from "std-widgets.slint";
import { Session, OutputBus } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { NumericField } from "../controls/NumericField.slint";
import { ValueCodec } from "../../slint/controls/ValueCodec.slint";
import { PageSection, SectionText } from "PageSection.slint";

component RoutingSend inherits Rectangle {
 in property <string> node-id;
 in property <string> node-name;
 in property <string> bus;
 in property <float> amount;
 NumericField { y: 0px; width: parent.width; show-label: false; ghost: true; label: root.bus+" send "+root.node-name; unit: "dB"; value-text: root.amount <= 0 ? "−∞" : ValueCodec.format(self.value,"dB");
  model-value: root.amount > 0 ? 20*log(root.amount,10) : -60;
  value: root.amount > 0 ? 20*log(root.amount,10) : -60;
  minimum: -60; maximum: 0; step: 0.1;
  gesture-began => { Session.parameter-gesture("send:"+root.node-id+":"+root.bus,0,root.amount); }
  changed(v) => { Session.parameter-gesture("send:"+root.node-id+":"+root.bus,1,v <= -60 ? 0 : pow(10,v/20)); }
  gesture-ended => { Session.parameter-gesture("send:"+root.node-id+":"+root.bus,2,root.amount); }
 }
 Rectangle { y: 25px; height: 4px; background: SamplerTheme.ink-0; border-radius: 2px;
  Rectangle { width: parent.width*root.amount; background: SamplerTheme.paper-2; border-radius: 2px; }
 }
}
component RoutingBusList inherits PageSection {
 title: "Output buses"; header-height: 34px;
 height: 62px+Session.routing-buses.length*34px;
 Rectangle { x: 12px; y: 35px; width: parent.width - 24px; height: 26px;
  SectionText { x: 0px; width: parent.width*0.4; height: parent.height; text: "BUS"; font-size: 10px; }
  SectionText { x: parent.width*0.4; width: parent.width*0.28; height: parent.height; text: "PLUGIN OUTPUT"; font-size: 10px; }
  SectionText { x: parent.width*0.7; width: parent.width*0.3; height: parent.height; text: "METER"; font-size: 10px; }
 }
 for bus[i] in Session.routing-buses : Rectangle { x: 12px; y: 62px+i*34px; width: parent.width - 24px; height: 34px;
  SectionText { x: 0px; y: 0px; width: parent.width*0.4 - 4px; height: 18px; text: bus.name; color: SamplerTheme.paper-1; font-weight: 600; }
  SectionText { x: 0px; y: 18px; width: parent.width*0.4 - 4px; height: 14px; text: bus.feeds.length == 0 ? "—" : bus.feeds[0] + (bus.feeds.length > 1 ? " · " + bus.feeds[1] : "") + (bus.feeds.length > 2 ? " · " + bus.feeds[2] : "") + (bus.feeds.length > 3 ? " +" + (bus.feeds.length - 3) : ""); font-size: 10px; }
  SectionText { x: parent.width*0.4; y: 6px; width: parent.width*0.28; height: 22px; text: bus.channel-summary; font-family: SamplerTheme.font-value; font-size: 11px; }
  for channel[j] in bus.channels : Rectangle { x: parent.width*0.7; y: 8px+j*10px; width: max(16px,parent.width*0.3); height: 7px; background: SamplerTheme.ink-0; border-width: 1px; border-color: SamplerTheme.line-1;
   Rectangle { x: 0px; y: 0px; width: parent.width*channel.peak.clamp(0,1); background: channel.clipped ? SamplerTheme.error : SamplerTheme.ok; }
  }
 }
}
export component RoutingPage inherits Rectangle {
 in property <bool> compact;
 in property <bool> expanded;
 callback context-action(string,string);
 private property <bool> graph;
 public function inherit-output() { Session.command("routing.inherit",Session.selected-id,"",0); }
 ScrollView { VerticalLayout { padding: 0px; spacing: 4px; alignment: start;
  Rectangle { height: max(assignments.height,root.expanded ? buses.height : 0px);
   assignments := PageSection { x: 0px; y: 0px; title: "Routing"; width: root.expanded ? parent.width - 604px : parent.width; height: 64px+Session.tree.length*35px;
    ActionButton { x: parent.width - 96px; y: 6px; text: root.graph ? "Hide graph" : "Show graph"; compact: true; ghost: true; selected: root.graph; clicked => { root.graph=!root.graph; } }
    Rectangle { x: 12px; y: 35px; width: parent.width - 24px; height: 26px;
     SectionText { x: 0px; width: parent.width*0.35; height: parent.height; text: "SOURCE"; font-size: 10px; }
     SectionText { x: parent.width*0.35; width: parent.width*0.28; height: parent.height; text: "OUTPUT BUS"; font-size: 10px; }
     SectionText { x: parent.width*0.64; width: parent.width*0.17; height: parent.height; text: "REVERB"; font-size: 10px; }
     SectionText { x: parent.width*0.82; width: parent.width*0.17; height: parent.height; text: "DELAY"; font-size: 10px; }
    }
    for node[i] in Session.tree : Rectangle { x: 12px; y: 62px+i*35px; width: parent.width - 24px; height: 35px; background: node.selected ? SamplerTheme.accent-wash : transparent;
     ActionButton { x: node.depth*8px; y: 4px; width: max(42px,parent.width*0.35 - node.depth*8px - 4px); label: node.name; compact: true; ghost: true; clicked => { Session.command("selection.set",node.id,"",0); } }
     SectionText { x: node.depth*8px; y: 0px; width: max(42px,parent.width*0.35 - node.depth*8px - 4px); height: 18px; text: node.name; color: SamplerTheme.paper-1; }
     SectionText { x: node.depth*8px; y: 18px; width: max(42px,parent.width*0.35 - node.depth*8px - 4px); height: 14px; text: node.kind; font-size: 10px; }
     ActionButton { x: parent.width*0.35; y: 4px; width: parent.width*0.28; text: node.output == "inherit" ? "Inherit" : node.output; label: "Output bus "+node.name; compact: true; clicked => { outputs.show(); } }
     outputs := PopupWindow { x: parent.width*0.35; y: 30px; width: 150px; height: 30px+Session.buses.length*26px;
      Rectangle { background: SamplerTheme.surface-menu; border-width: 1px; border-color: SamplerTheme.line-3;
       VerticalLayout { padding: 3px; spacing: 2px; alignment: start;
        ActionButton { text: "Inherit"; label: "Inherit output "+node.name; compact: true; ghost: true; clicked => { Session.command("routing.inherit",node.id,"",0); outputs.close(); } }
        for bus in Session.buses : ActionButton { text: bus.name; label: "Set "+node.name+" output "+bus.name; compact: true; ghost: true; clicked => { Session.command("routing.output",node.id,bus.name,0); outputs.close(); } }
       }
      }
     }
     RoutingSend { x: parent.width*0.64; y: 1px; width: parent.width*0.17; height: 31px; node-id: node.id; node-name: node.name; bus: "Reverb"; amount: node.send-a; }
     RoutingSend { x: parent.width*0.82; y: 1px; width: parent.width*0.17; height: 31px; node-id: node.id; node-name: node.name; bus: "Delay"; amount: node.send-b; }
    }
   }
   buses := RoutingBusList { visible: root.expanded; x: assignments.width+4px; y: 0px; width: max(1px,parent.width - self.x); }
  }
  if !root.expanded : RoutingBusList { }
  if root.expanded : ReadOnlyKeyMap { }
  if root.graph : PageSection { title: "Output graph"; height: 104px;
   HorizontalLayout { x: 12px; y: 45px; width: parent.width - 24px; height: 28px; alignment: start; spacing: 16px;
    ActionButton { text: Session.selected-name; clicked => { Session.command("selection.set",Session.selected-id,"",0); } }
    SectionText { text: "→"; }
    ActionButton { text: Session.resolved-output; clicked => { Session.command("routing.output",Session.selected-id,"Main 1/2",0); } }
    SectionText { text: "→"; }
    ActionButton { text: "Output"; clicked => { Session.command("page.select","fx","",0); } }
   }
  }
 } }
}
