import { WaveBucket, WaveSlice } from "../domain/types.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { Session } from "../Session.slint";
export global WaveCoordinates {
    public pure function normalized(position: length, width: length) -> float { return width > 0px ? (position / width).clamp(0, 1) : 0; }
}
component WaveHandle inherits FocusScope {
    in property <string> field;
    in property <string> label;
    in property <float> position;
    in property <length> plot-width;
    in property <length> plot-height;
    in property <color> tint: SamplerTheme.accent;
    in property <bool> top;
    private property <float> initial;
    private property <length> anchor;
    private property <bool> dragging;
    callback gesture(string, int, float);
    width: 12px; height: root.top ? root.plot-height : 14px; y: root.top ? 0px : root.plot-height - 14px;
    accessible-role: slider; accessible-label: root.label; accessible-value: root.position; accessible-value-minimum: 0; accessible-value-maximum: 1;
    focus-on-tab-navigation: true; focus-on-click: true;
    focus-lost(reason) => { root.finish(true); }
    function finish(cancel: bool) { if root.dragging { root.dragging = false; root.gesture(root.field, cancel ? 3 : 2, cancel ? root.initial : root.position); } }
    key-pressed(event) => {
        if event.text == Key.Escape { root.finish(true); return accept; }
        if event.text == Key.LeftArrow || event.text == Key.RightArrow {
            root.gesture(root.field, 0, root.position);
            root.gesture(root.field, 1, (root.position + (event.text == Key.LeftArrow ? -0.001 : 0.001)).clamp(0,1));
            root.gesture(root.field, 2, root.position); return accept;
        }
        return reject;
    }
    Rectangle { x: 5px; width: 1px; height: parent.height; background: root.tint; }
    Rectangle { x: 2px; y: root.top ? 0px : parent.height - 10px; width: 8px; height: 10px; border-radius: 1px; background: root.tint; }
    touch := TouchArea { y: root.top ? 0px : parent.height - 14px; height: root.top ? parent.height : 14px; mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.focus(); root.initial = root.position; root.anchor = self.absolute-position.x + self.mouse-x; root.dragging = true; root.gesture(root.field, 0, root.position); }
            else if event.kind == PointerEventKind.up { root.finish(false); }
            else if event.kind == PointerEventKind.cancel { root.finish(true); }
        }
        moved => { if root.dragging && abs(root.plot-width) > 0px { root.gesture(root.field, 1, (root.initial + (self.absolute-position.x + self.mouse-x - root.anchor) / root.plot-width).clamp(0,1)); } }
    }
}
export component WaveView inherits Rectangle {
    in property <[WaveBucket]> peaks;
    in property <[WaveSlice]> slices;
    in property <string> selected-slice;
    in property <string> state: "empty";
    in property <string> label;
    in property <string> metadata;
    in property <float> region-start;
    in property <float> region-end: 1;
    in property <float> fade-in;
    in property <float> fade-out;
    in property <float> loop-start;
    in property <float> loop-end: 1;
    in property <float> crossfade;
    in property <bool> loop-enabled;
    in property <float> playhead;
    in property <float> zoom: 1;
    in property <float> duration: 1;
    in property <bool> reversed;
    in property <image> spectral-data: Session.spectral-preview(root.peaks, root.reversed, root.region-start, root.region-end, SamplerTheme.ink-0, SamplerTheme.ink-5, SamplerTheme.accent-lo, SamplerTheme.accent, SamplerTheme.paper-1);
    in property <float> viewport-start;
    in property <float> viewport-end: 1;
    private property <float> viewport-span: max(0.000001, root.viewport-end - root.viewport-start);
    private property <string> display-mode: "wave";
    private property <bool> overview: root.height < 60px;
    callback gesture(string, int, float);
    callback slice-selected(string);
    callback seek(float);
    background: SamplerTheme.ink-0; border-radius: 2px; clip: true;
    Rectangle { visible: !root.overview; x: 0px; y: 0px; height: 18px; background: SamplerTheme.ink-1;
        for i in 9 : Text { x: i / 8 * (parent.width - 32px) + 8px; width: 32px; text: round((root.viewport-start + i / 8 * root.viewport-span) * root.duration * 100) / 100 + "s"; font-family: SamplerTheme.font-value; font-size: 10px; color: SamplerTheme.paper-4; }
    }
    Flickable { x: 0px; y: root.overview ? 0px : 18px; width: parent.width; height: root.overview ? parent.height : parent.height - 36px; content-width: self.width * root.zoom; content-height: self.height;
        plot := Rectangle { x: 0px; y: 0px; width: parent.width * root.zoom; height: parent.height;
            Rectangle { x: 0px; y: parent.height / 2; width: parent.width; height: 1px; background: SamplerTheme.line-1; }
            Image { visible: root.display-mode == "spectral"; x: -root.viewport-start / root.viewport-span * plot.width; width: plot.width / root.viewport-span; height: plot.height; source: root.spectral-data; image-fit: fill; }
            for bucket[i] in root.peaks : Rectangle {
                private property <int> shown-index: root.reversed ? root.peaks.length - 1 - i : i;
                visible: root.display-mode == "wave";
                x: (self.shown-index / max(1, root.peaks.length) - root.viewport-start) / root.viewport-span * plot.width;
                y: (1 - bucket.maximum.clamp(-1,1)) * plot.height / 2;
                width: max(1px, plot.width / max(1, root.peaks.length) / root.viewport-span);
                height: max(1px, (bucket.maximum.clamp(-1,1) - bucket.minimum.clamp(-1,1)) * plot.height / 2);
                background: (self.shown-index + 0.5) / max(1, root.peaks.length) >= root.region-start && (self.shown-index + 0.5) / max(1, root.peaks.length) <= root.region-end ? SamplerTheme.waveform-region : SamplerTheme.waveform.with-alpha(0.28);
            }
            TouchArea { clicked => { root.seek(root.viewport-start + WaveCoordinates.normalized(self.mouse-x, plot.width) * root.viewport-span); } }
            if !root.overview && root.fade-in > 0 : Path {
                width: plot.width; height: plot.height; viewbox-width: plot.width / 1px; viewbox-height: plot.height / 1px;
                fill: SamplerTheme.secondary.with-alpha(0.06); stroke: SamplerTheme.paper-2; stroke-width: 1px;
                MoveTo { x: root.region-start * plot.width / 1px; y: plot.height / 1px; }
                LineTo { x: (root.region-start + root.fade-in) * plot.width / 1px; y: 0; }
                LineTo { x: root.region-start * plot.width / 1px; y: 0; }
                Close { }
            }
            if !root.overview && root.fade-out > 0 : Path {
                width: plot.width; height: plot.height; viewbox-width: plot.width / 1px; viewbox-height: plot.height / 1px;
                fill: SamplerTheme.secondary.with-alpha(0.06); stroke: SamplerTheme.paper-2; stroke-width: 1px;
                MoveTo { x: (root.region-end - root.fade-out) * plot.width / 1px; y: 0; }
                LineTo { x: root.region-end * plot.width / 1px; y: plot.height / 1px; }
                LineTo { x: root.region-end * plot.width / 1px; y: 0; }
                Close { }
            }
            if root.loop-enabled : Rectangle { x: root.loop-start * plot.width; width: max(0px, (root.loop-end - root.loop-start) * plot.width); height: parent.height; background: SamplerTheme.mod-b.with-alpha(0.08); border-width: 1px; border-color: SamplerTheme.mod-b.with-alpha(0.4); }
            if root.loop-enabled && root.crossfade > 0 : Rectangle { x: max(root.loop-start, root.loop-end - root.crossfade) * plot.width; width: min(root.crossfade, max(0, root.loop-end - root.loop-start)) * plot.width; height: plot.height; background: SamplerTheme.mod-b.with-alpha(0.18); }
            for slice in root.slices : Rectangle { x: slice.start * plot.width; width: max(1px, (slice.end - slice.start) * plot.width); height: plot.height;
                background: slice.id == root.selected-slice ? SamplerTheme.accent-wash : transparent;
                Rectangle { x: 0px; y: 0px; width: 1px; background: SamplerTheme.secondary; }
                Text { x: 4px; y: 3px; width: parent.width - 8px; text: slice.name; color: SamplerTheme.paper-3; font-family: SamplerTheme.font-value; font-size: 10px; overflow: elide; }
                TouchArea { clicked => { root.slice-selected(slice.id); } }
            }
            if !root.overview && root.slices.length == 0 && root.peaks.length > 0 : Rectangle { x: 0px; y: 0px;
                start-handle := WaveHandle { x: root.region-start * plot.width - 5px; field: "region-start"; label: "Region start"; position: root.region-start; plot-width: plot.width; plot-height: plot.height; top: true; gesture(id,p,v) => { root.gesture(id,p,v); } }
                end-handle := WaveHandle { x: root.region-end * plot.width - 6px; field: "region-end"; label: "Region end"; position: root.region-end; plot-width: plot.width; plot-height: plot.height; top: true; gesture(id,p,v) => { root.gesture(id,p,v); } }
                fade-in-handle := WaveHandle { x: (root.region-start + root.fade-in) * plot.width - 5px; field: "fade-in"; label: "Fade in"; position: root.fade-in; plot-width: plot.width; plot-height: plot.height; tint: SamplerTheme.secondary; gesture(id,p,v) => { root.gesture(id,p,v); } }
                fade-out-handle := WaveHandle { x: (root.region-end - root.fade-out) * plot.width - 5px; field: "fade-out"; label: "Fade out"; position: root.fade-out; plot-width: -plot.width; plot-height: plot.height; tint: SamplerTheme.secondary; gesture(id,p,v) => { root.gesture(id,p,v); } }
                if root.loop-enabled : Rectangle {
                    WaveHandle { x: root.loop-start * plot.width - 5px; field: "loop-start"; label: "Loop start"; position: root.loop-start; plot-width: plot.width; plot-height: plot.height; tint: SamplerTheme.mod-b; top: true; gesture(id,p,v) => { root.gesture(id,p,v); } }
                    WaveHandle { x: root.loop-end * plot.width - 5px; field: "loop-end"; label: "Loop end"; position: root.loop-end; plot-width: plot.width; plot-height: plot.height; tint: SamplerTheme.mod-b; top: true; gesture(id,p,v) => { root.gesture(id,p,v); } }
                    WaveHandle { x: (root.loop-end - root.crossfade) * plot.width - 5px; field: "loop-crossfade"; label: "Loop crossfade"; position: root.crossfade; plot-width: -plot.width; plot-height: plot.height; tint: SamplerTheme.mod-b; gesture(id,p,v) => { root.gesture(id,p,v); } }
                }
            }
            if root.playhead > 0 : Rectangle { x: root.playhead * plot.width; width: 1px; background: SamplerTheme.paper-1; }
            if root.peaks.length == 0 : Text { text: root.state == "loading" ? "Loading sample…" : root.state == "missing" ? "Sample unavailable · Relink or replace" : root.state == "unsupported" ? "Unsupported sample format" : "Drop or browse a sample"; color: SamplerTheme.paper-3; font-family: SamplerTheme.font-ui; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    Text { visible: !root.overview; x: 8px; y: parent.height - 18px; height: 18px; width: parent.width - 16px; text: root.metadata; color: SamplerTheme.paper-3; font-family: SamplerTheme.font-value; font-size: 11px; vertical-alignment: center; overflow: elide; }
    if !root.overview && root.state != "missing" && root.peaks.length > 0 : Rectangle {
        x: parent.width - 106px; y: parent.height - 23px; width: 100px; height: 18px; background: SamplerTheme.ink-0; border-radius: 3px; border-width: 1px; border-color: SamplerTheme.line-1;
        ActionButton { x: 2px; y: 2px; width: 40px; height: 14px; text: "WAVE"; label: "Display Wave"; compact: true; ghost: true; selected: root.display-mode == "wave"; clicked => { root.display-mode = "wave"; } }
        ActionButton { x: 43px; y: 2px; width: 55px; height: 14px; text: "SPECTRAL"; label: "Display Spectral"; compact: true; ghost: true; selected: root.display-mode == "spectral"; clicked => { root.display-mode = "spectral"; } }
    }
}
