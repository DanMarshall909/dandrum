import { Session } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { MaterialSurface } from "../theme/Material.slint";
import { ActionButton } from "../controls/ActionButton.slint";

component ColumnHeading inherits Text {
    color: SamplerTheme.paper-3; font-family: SamplerTheme.font-ui; font-size: 11px;
    font-weight: 600; letter-spacing: 0.66px; vertical-alignment: center;
}
export component OverviewPage inherits Rectangle {
    in property <bool> compact;
    // CSS grid minmax(120,1fr) minmax(110,1fr) 84 minmax(120,1.2fr) 56.
    private property <length> table-width: max(root.width, 546px);
    private property <length> flexible-space: root.table-width - 198px;
    private property <length> fraction: root.flexible-space >= 384px ? root.flexible-space / 3.2 : (root.flexible-space - 120px) / 2.2;
    private property <length> property-width: max(120px, root.fraction);
    private property <length> value-width: max(110px, root.fraction);
    private property <length> from-width: root.flexible-space - root.property-width - root.value-width;
    private property <length> value-x: 12px + root.property-width + 8px;
    private property <length> state-x: root.value-x + root.value-width + 8px;
    private property <length> from-x: root.state-x + 84px + 8px;
    private property <length> reset-x: root.from-x + root.from-width + 8px;
    // The effective-property model contains the guide's four section headings.
    private property <length> rows-height: max(0px, Session.overview.length * 28px - 20px);
    public function reset-row(index: int) {
        if index >= 0 && index < Session.overview.length && Session.overview[index].can-reset {
            Session.command(Session.overview[index].reset-action, Session.overview[index].reset-target, Session.overview[index].reset-field, 0);
        }
    }
    Flickable {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        content-width: root.table-width; content-height: max(self.height, 71px + root.rows-height + 12px);
        MaterialSurface {
            x: 0px; y: 0px; width: parent.content-width; height: parent.content-height; raised: false;
            Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 43px; background: SamplerTheme.surface-panel-header; border-radius: 5px;
                title := Text { x: 12px; y: 0px; width: self.preferred-width; height: parent.height - 1px; text: "OVERVIEW"; color: SamplerTheme.paper-2; font-family: SamplerTheme.font-ui; font-size: 13px; font-weight: 700; letter-spacing: 1.3px; vertical-alignment: center; }
                Text { x: title.x + title.width + 8px; y: 0px; width: max(0px, parent.width - self.x - 8px); height: parent.height; text: Session.selected-name; color: SamplerTheme.paper-3; font-family: SamplerTheme.font-value; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: SamplerTheme.line-1; }
            }
            Rectangle { x: 1px; y: 44px; width: parent.width - 2px; height: 27px;
                ColumnHeading { x: 12px; y: 0px; width: root.property-width; height: parent.height; text: "PROPERTY"; }
                ColumnHeading { x: root.value-x; y: 0px; width: root.value-width; height: parent.height; text: "VALUE"; }
                ColumnHeading { x: root.state-x; y: 0px; width: 84px; height: parent.height; text: "STATE"; }
                ColumnHeading { x: root.from-x; y: 0px; width: root.from-width; height: parent.height; text: "FROM"; }
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: SamplerTheme.line-1; }
            }
            VerticalLayout { x: 1px; y: 71px; width: parent.width - 2px; height: root.rows-height; spacing: 0px;
                for row[i] in Session.overview : Rectangle {
                    height: row.head ? 23px : 28px;
                    if row.head : Text { x: 12px; y: 8px; width: parent.width - 24px; height: 13px; text: row.label.to-uppercase(); color: SamplerTheme.paper-3; font-family: SamplerTheme.font-ui; font-size: 11px; font-weight: 600; letter-spacing: 0.66px; vertical-alignment: center; }
                    if !row.head : Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height;
                        Text { x: 12px; y: 0px; width: root.property-width; height: parent.height; text: row.label; color: SamplerTheme.paper-1; font-family: SamplerTheme.font-ui; font-size: 13px; font-weight: 500; vertical-alignment: center; overflow: elide; }
                        Text { x: root.value-x; y: 0px; width: root.value-width; height: parent.height; text: row.value-text; accessible-label: row.label + ": " + row.value-text; color: SamplerTheme.paper-1; font-family: SamplerTheme.font-value; font-size: 12px; font-weight: 500; vertical-alignment: center; overflow: elide; }
                        Rectangle { x: root.state-x; y: 7px; width: min(84px, state-label.preferred-width + 12px); height: 14px; border-radius: 2px; border-width: 1px;
                            border-color: row.state == "local" ? SamplerTheme.accent : row.state == "mixed" ? SamplerTheme.warn : SamplerTheme.line-2;
                            state-label := Text { x: 5px; y: 0px; width: parent.width - 10px; height: parent.height; text: row.state.to-uppercase(); color: row.state == "local" ? SamplerTheme.accent : row.state == "mixed" ? SamplerTheme.warn : SamplerTheme.paper-3; font-family: SamplerTheme.font-ui; font-size: 10px; font-weight: 600; letter-spacing: 0.6px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { x: root.from-x; y: 0px; width: root.from-width; height: parent.height; text: row.from; color: SamplerTheme.paper-3; font-family: SamplerTheme.font-ui; font-size: 12px; font-weight: 500; vertical-alignment: center; overflow: elide; }
                        if row.can-reset : ActionButton { x: root.reset-x; y: 3px; width: 52px; height: 22px; text: "Reset"; label: "Reset " + row.label; compact: true; ghost: true; clicked => { root.reset-row(i); } }
                    }
                }
            }
        }
    }
}
