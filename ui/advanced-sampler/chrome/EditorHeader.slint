import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
export component EditorHeader inherits Rectangle {
    in property <string> patch-name;
    in property <string> status;
    in property <bool> compact;
    in property <bool> perform;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <int> voices;
    in property <int> voice-limit: 32;
    in property <float> level;
    in property <int> size-mode: 1;
    callback command(string);
    background: SamplerTheme.ink-0;
    Rectangle { y: parent.height - 1px; height: 1px; background: SamplerTheme.line-1; }
    HorizontalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        padding-left: 12px; padding-right: 12px; spacing: root.compact ? 4px : 12px; alignment: stretch;
        HorizontalLayout {
            spacing: 8px; alignment: center; horizontal-stretch: 0;
            Text { text: "dandrum"; font-family: SamplerTheme.font-display; font-size: 20px; font-weight: 700; color: SamplerTheme.paper-1; }
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: SamplerTheme.accent; }
            if !root.compact : Text { text: "TRIGGER"; font-family: SamplerTheme.font-ui; font-size: 13px; font-weight: 700; letter-spacing: 1.3px; color: SamplerTheme.paper-2; }
        }
        Rectangle { width: 1px; height: 20px; background: SamplerTheme.line-1; }
        HorizontalLayout { spacing: 2px; alignment: center; horizontal-stretch: 0;
            undo-button := ActionButton { icon: "reset"; label: "Undo"; compact: true; ghost: true; enabled: root.can-undo; clicked => { root.command("undo"); } }
            redo-button := ActionButton { icon: "reload"; label: "Redo"; compact: true; ghost: true; enabled: root.can-redo; clicked => { root.command("redo"); } }
        }
        patch-button := ActionButton { text: root.patch-name + "  ▾"; label: "Browse patches"; width: root.compact ? 152px : 200px; horizontal-stretch: 0; clicked => { root.command("patch.browse"); } }
        Text { min-width: 72px; horizontal-stretch: 1; text: root.status; overflow: elide; font-family: SamplerTheme.font-ui; font-size: 12px; color: SamplerTheme.paper-3; vertical-alignment: center; }
        Text { text: root.voices + " / " + root.voice-limit; font-family: SamplerTheme.font-value; font-size: 12px; color: SamplerTheme.paper-3; vertical-alignment: center; }
        diagnostics-button := ActionButton { icon: "settings"; label: "Why did this play?"; ghost: true; compact: true; clicked => { root.command("diagnostics"); } }
        ActionButton { icon: "list"; label: "Event log"; ghost: true; compact: true; clicked => { root.command("eventlog"); } }
        if !root.perform : Rectangle { width: root.compact ? 106px : 172px; height: 28px; horizontal-stretch: 0; background: SamplerTheme.surface-well; border-radius: 4px; border-width: 1px; border-color: SamplerTheme.border-hairline;
            HorizontalLayout { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; spacing: 2px;
                for size-label[i] in ["Min", root.compact ? "Def" : "Default", root.compact ? "Exp" : "Expanded"] : ActionButton {
                    text: size-label; label: i == 2 ? "Exp" : size-label; selected: i == root.size-mode; compact: true; ghost: true; neutral-selection: true; caps: true;
                    width: root.compact ? 32px : i == 0 ? 34px : i == 1 ? 59px : 69px; height: 22px;
                    clicked => { root.command(i == 0 ? "size.min" : i == 1 ? "size.default" : "size.expanded"); }
                }
            }
        }
        perform-button := ActionButton { text: root.perform ? "Edit" : "Perform"; icon: root.perform ? "edit" : "tap"; label: root.perform ? "Return to editor" : "Perform"; clicked => { root.command("perform.toggle"); } }
        appearance-button := ActionButton { icon: "settings"; label: "Appearance and settings"; ghost: true; compact: true; clicked => { root.command("appearance"); } }
        Rectangle { width: 30px; height: 12px;
            for row in 2 : Rectangle { y: row * 7px; height: 4px; width: parent.width; background: SamplerTheme.ink-4;
                Rectangle { height: parent.height; width: parent.width * root.level.clamp(0, 1); background: root.level > 0.95 ? SamplerTheme.error : SamplerTheme.ok; }
            }
        }
    }
}
