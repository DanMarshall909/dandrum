import { DragKinds } from "../../slint/editor/Drag.slint";
import { SamplerCommands } from "../domain/Commands.slint";
import { Tokens } from "../../slint/theme.slint";
import { ItemRow } from "../../slint/editor/ItemRow.slint";
import { EditorTextField } from "../../slint/editor/TextField.slint";
import { LevelMeter } from "../../slint/editor/LevelMeter.slint";
import { ScrollView } from "std-widgets.slint";
import { Session } from "../Session.slint";
import { ModulatorInfo } from "../domain/types.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { DragSource, DragState } from "DragState.slint";
export component ModulatorTree inherits ScrollView {
    in property <[ModulatorInfo]> modulators;
    private property <bool> envelopes-open;
    private property <bool> lfos-open: true;
    private property <bool> performance-open;
    private property <bool> macros-open;
    private property <string> rename-id;
    public function select(id: string) { Session.command(SamplerCommands.modulator-select, id, "", 0); }
    public function assign(source: string, destination: string) -> bool { return Session.command(SamplerCommands.route-add, source, destination, 0.25); }
    public pure function expanded(kind: string) -> bool { return kind == "envelope" ? root.envelopes-open : kind == "lfo" ? root.lfos-open : kind == "macro" ? root.macros-open : root.performance-open; }
    public function toggle(kind: string) { if kind == "envelope" { root.envelopes-open = !root.envelopes-open; } else if kind == "lfo" { root.lfos-open = !root.lfos-open; } else if kind == "macro" { root.macros-open = !root.macros-open; } else { root.performance-open = !root.performance-open; } }
    VerticalLayout {
        width: max(Tokens.editor-border-width, root.width - Tokens.editor-chrome-content-inset);
        alignment: start;
        spacing: 0px;
        for source[index] in root.modulators: VerticalLayout {
            spacing: 0px;
            if index == 0 || root.modulators[index - 1].kind != source.kind: ActionButton {
                width: parent.width;
                height: Tokens.editor-item-height;
                text: source.kind == "envelope" ? "ENVELOPES" : source.kind == "lfo" ? "LFOS" : source.kind == "macro" ? "MACROS" : "PERFORMANCE";
                label: "Toggle " + source.kind + " modulators";
                compact: true;
                ghost: true;
                icon: root.expanded(source.kind) ? "chevron-down" : "chevron-right";
                clicked => { root.toggle(source.kind); }
            }
            if root.expanded(source.kind): Rectangle {
                height: Tokens.editor-item-height;
                mod-menu := PopupWindow {
                    y: Tokens.editor-item-height;
                    width: Tokens.editor-tree-menu-width;
                    height: Tokens.editor-modulator-menu-height;
                    Rectangle {
                        background: SamplerTheme.surface-menu;
                        border-width: Tokens.editor-border-width;
                        border-color: SamplerTheme.line-3;
                        border-radius: Tokens.editor-radius-item;
                        VerticalLayout {
                            padding: Tokens.editor-chrome-gap-tight;
                            spacing: 0px;
                            ActionButton {
                                text: "Edit";
                                label: "Edit " + source.name;
                                ghost: true;
                                clicked => { mod-menu.close(); root.select(source.id); }
                            }

                            ActionButton {
                                text: "Add destination…";
                                label: "Add destination to " + source.name;
                                ghost: true;
                                clicked => { mod-menu.close(); destination-menu.show(); }
                            }

                            ActionButton {
                                text: "Show routes";
                                label: "Show routes for " + source.name;
                                ghost: true;
                                clicked => { mod-menu.close(); root.select(source.id); }
                            }

                            ActionButton {
                                text: "Rename…";
                                label: "Rename " + source.name;
                                ghost: true;
                                clicked => { mod-menu.close(); root.rename-id = source.id; }
                            }

                            ActionButton {
                                text: source.enabled ? "Disable" : "Enable";
                                label: (source.enabled ? "Disable " : "Enable ") + source.name;
                                ghost: true;
                                clicked => { mod-menu.close(); Session.command(SamplerCommands.modulator-set, source.id, "enabled", source.enabled ? 0 : 1); }
                            }

                            ActionButton {
                                text: "Delete modulator";
                                label: "Delete " + source.name;
                                enabled: source.id != "amp-env";
                                ghost: true;
                                clicked => { mod-menu.close(); Session.command(SamplerCommands.modulator-delete, source.id, "", 0); }
                            }
                        }
                    }
                }

                destination-menu := PopupWindow {
                    y: Tokens.editor-item-height;
                    width: Tokens.editor-modulator-destination-menu-width;
                    height: min(Tokens.editor-modulator-destination-menu-max-height, Session.parameter-catalog.length * Tokens.editor-item-height + Tokens.editor-chrome-gap-small);
                    Rectangle {
                        background: SamplerTheme.surface-menu;
                        border-width: Tokens.editor-border-width;
                        border-color: SamplerTheme.line-3;
                        border-radius: Tokens.editor-radius-item;
                        ScrollView {
                            VerticalLayout {
                                padding: Tokens.editor-chrome-gap-tight;
                                spacing: 0px;
                                for p in Session.parameter-catalog: ActionButton {
                                    height: Tokens.editor-item-height;
                                    text: p.label + " · " + p.group;
                                    label: "Route " + source.name + " to " + p.label;
                                    enabled: p.available;
                                    ghost: true;
                                    clicked => { root.assign(source.id, p.id); destination-menu.close(); }
                                }
                            }
                        }
                    }
                }

                row-focus := ItemRow {
                    label: "Select " + source.name + " modulator";
                    text: source.name;
                    selected: source.selected;
                    external-pointer: true;
                    external-hovered: drag.has-hover;
                    text-x: Tokens.editor-modulator-text-left;
                    text-width: self.content-width - Tokens.editor-modulator-text-reserve;
                    text-color: source.enabled ? SamplerTheme.paper-2 : SamplerTheme.text-disabled;
                    window-deactivated => { Session.release-notes(); DragState.cancel(); }
                    activated => { root.select(source.id); }
                    Rectangle {
                        x: Tokens.editor-modulator-symbol-left;
                        y: source.slot <= 0 ? Tokens.editor-chrome-content-inset : Tokens.editor-modulator-symbol-top;
                        width: Tokens.editor-chrome-gap;
                        height: source.slot <= 0 ? Tokens.editor-chrome-gap-tight : Tokens.editor-chrome-gap;
                        border-radius: source.slot == 1 ? Tokens.editor-radius-group : 0px;
                        background: SamplerTheme.mod-color(source.slot);
                    }

                    LevelMeter {
                        x: parent.width - Tokens.editor-modulator-meter-right;
                        y: Tokens.editor-chrome-content-inset;
                        width: Tokens.editor-modulator-meter-width;
                        height: Tokens.editor-chrome-inset-cap;
                        border-radius: Tokens.editor-radius-control;
                        track-color: SamplerTheme.ink-4;
                        level: abs(source.live);
                        centered: true;
                    }

                    if root.rename-id == source.id: EditorTextField {
                        x: Tokens.editor-modulator-rename-left;
                        width: parent.width - Tokens.editor-modulator-rename-reserve;
                        text: source.name;
                        accessible-label: "Rename modulator " + source.name;
                        cancel-on-escape: true;
                        focus-left => { Session.release-notes(); DragState.cancel(); }
                        accepted => { Session.command(SamplerCommands.modulator-rename, source.id, self.text, 0); root.rename-id = ""; }
                        cancelled => { root.rename-id = ""; }
                    }
                    drag := DragSource {
                        kind: DragKinds.modulator;
                        payload: source.id;
                        enabled: root.rename-id != source.id;
                        activate => { row-focus.activate(); }
                        context-requested => { mod-menu.show(); }
                    }
                }
            }
        }
    }
}
