import { EditorDragTarget, DragKinds } from "../../slint/editor/Drag.slint";
export { EditorDragState as DragState, EditorDragSource as DragSource } from "../../slint/editor/Drag.slint";

// Slice acceptance is a sampler policy; the drag mechanics belong to the library.
export component DragTarget inherits EditorDragTarget {
    in property <bool> accept-slices;
    additional-kind: root.accept-slices ? DragKinds.slice : "";
}
