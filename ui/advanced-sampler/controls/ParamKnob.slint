import { DragKinds } from "../../slint/editor/Drag.slint";
import { SamplerCommands } from "../domain/Commands.slint";
import { ParameterActions } from "../../slint/editor/ParameterConstants.slint";
import { Tokens } from "../../slint/tokens.slint";
import { ParameterKnob } from "../../slint/editor/ParameterKnob.slint";
import { DragTarget, DragState } from "../chrome/DragState.slint";
import { Session } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";

export component ParamKnob inherits ParameterKnob {
    in property <string> parameter-id;
    label-font-size: Tokens.editor-control-dense-label-size;
    in property <string> macro-id;
    context-mode: root.macro-id != "" ? ParameterActions.macro : "";
    // Preserve a separate native projection after local user writes replace value bindings.
    in property <float> model-value: root.value;
    changed model-value => { if abs(root.model-value - root.value) > Tokens.editor-control-value-epsilon { root.value = root.model-value; } }
    assignment-enabled: root.parameter-id != "";
    gesture-cancelled => { Session.command(SamplerCommands.gesture-cancel, "", "", 0); }
    interaction-lost => { Session.release-notes(); DragState.cancel(); }
    DragTarget { accepted-kind: DragKinds.modulator; enabled: root.enabled && root.parameter-id != ""; border-width: self.drag-over ? 1px : 0px; border-color: SamplerTheme.accent; border-radius: Tokens.editor-control-radius-focus;
        dropped(source) => { return Session.command(SamplerCommands.route-add, source, root.parameter-id, Tokens.editor-control-default-route-depth); }
    }
}
