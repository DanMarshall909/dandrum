import { EditorButton } from "../../slint/editor/Button.slint";
import { SamplerIconNames } from "AppIcon.slint";
import { Session } from "../Session.slint";
import { DragState } from "../chrome/DragState.slint";
export component ActionButton inherits EditorButton {
    resolved-icon: SamplerIconNames.resolve(root.icon);
    window-deactivated => { Session.release-notes(); DragState.cancel(); }
}
