import { Tokens } from "../../slint/theme.slint";
import { EditorRollout } from "../../slint/editor/Rollout.slint";
import { Session } from "../Session.slint";
import { DragState } from "../chrome/DragState.slint";
export component Rollout inherits EditorRollout {
    small-font-size: Tokens.editor-type-legacy-small;
    window-deactivated => { Session.release-notes(); DragState.cancel(); }
}
