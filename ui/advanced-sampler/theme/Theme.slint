// Complete v3 semantic theme. Native ThemeBinding updates all roles as one palette.
import "../../design-system/fonts/Barlow/Barlow-Medium.ttf";
import "../../design-system/fonts/Barlow/Barlow-SemiBold.ttf";
import "../../design-system/fonts/Barlow/Barlow-Bold.ttf";
import "../../design-system/fonts/BarlowSemiCondensed/BarlowSemiCondensed-Medium.ttf";
import "../../design-system/fonts/BarlowSemiCondensed/BarlowSemiCondensed-SemiBold.ttf";
import "../../design-system/fonts/BarlowSemiCondensed/BarlowSemiCondensed-Bold.ttf";
import "../../design-system/fonts/JetBrainsMono/JetBrainsMono-Medium.ttf";
import "../../design-system/fonts/JetBrainsMono/JetBrainsMono-SemiBold.ttf";

export global SamplerTheme {
    in-out property <image> window-lighting;
    in-out property <bool> soft: true;
    in-out property <bool> light: false;
    in-out property <bool> brushed: false;
    in-out property <color> accent: #E8C47A;
    in-out property <color> accent-hi: #edd197;
    in-out property <color> accent-lo: #ae935c;
    in-out property <color> accent-wash: #3d382e;
    in-out property <color> secondary: #8C8F95;
    in-out property <color> secondary-wash: #2c2d30;
    in-out property <color> host: #5B9DFF;
    in-out property <color> host-wash: #252f3e;
    in-out property <color> mod-a: #3FD0C9;
    in-out property <color> mod-b: #A98BFF;
    in-out property <color> mod-c: #8EDB5A;
    in-out property <color> mod-d: #FF85BE;
    in-out property <color> mod-wash: #203233;
    in-out property <color> ok: #5FD38A;
    in-out property <color> warn: #E9C15A;
    in-out property <color> error: #F0545E;
    in-out property <color> ok-wash: #232f2a;
    in-out property <color> warn-wash: #312d25;
    in-out property <color> error-wash: #312325;
    in-out property <color> cap: #494b4e;
    in-out property <color> cap-hover: #54565a;
    in-out property <color> cap-press: #3b3d40;
    in-out property <color> pad: #393b3e;
    in-out property <color> pad-hover: #424447;
    in-out property <color> text-on-accent: #1E1209;
    in-out property <color> scrim: rgba(0,0,0,0.45);
    in-out property <color> waveform: #8d8880;
    in-out property <color> waveform-region: #e0dcd4;
    in-out property <color> surface-window: #161718;
    in-out property <color> surface-panel: #1C1D1F;
    in-out property <color> surface-panel-header: #232426;
    in-out property <color> surface-well: #0F1011;
    in-out property <color> surface-control: #2B2C2F;
    in-out property <color> surface-control-hover: #36373A;
    in-out property <color> surface-control-pressed: #45464A;
    in-out property <color> surface-menu: #232426;
    in-out property <color> surface-prepared: #1C1D1F;
    in-out property <color> text-primary: #EDE9E1;
    in-out property <color> text-secondary: #C3BEB4;
    in-out property <color> text-tertiary: #99948B;
    in-out property <color> text-disabled: #67635D;
    in-out property <color> border-hairline: #2A2B2E;
    in-out property <color> border-control: #3A3B3F;
    in-out property <color> border-strong: #535459;
    in-out property <color> color-selected: #E8C47A;
    in-out property <color> color-action: #E8C47A;
    in-out property <color> color-focus: #EDE9E1;
    in-out property <color> color-value: #ebcb8a;
    in-out property <color> color-track: #45464A;
    in-out property <color> color-cursor: #EDE9E1;
    in-out property <color> ink-0: #0F1011;
    in-out property <color> ink-1: #161718;
    in-out property <color> ink-2: #1C1D1F;
    in-out property <color> ink-3: #232426;
    in-out property <color> ink-4: #2B2C2F;
    in-out property <color> ink-5: #36373A;
    in-out property <color> ink-6: #45464A;
    in-out property <color> line-1: #2A2B2E;
    in-out property <color> line-2: #3A3B3F;
    in-out property <color> line-3: #535459;
    in-out property <color> paper-1: #EDE9E1;
    in-out property <color> paper-2: #C3BEB4;
    in-out property <color> paper-3: #99948B;
    in-out property <color> paper-4: #67635D;
    out property <color> value: SamplerTheme.color-value;
    out property <color> color-waveform: SamplerTheme.waveform;
    out property <color> color-waveform-region: SamplerTheme.waveform-region;
    out property <string> font-ui: "Barlow Semi Condensed";
    out property <string> font-display: "Barlow";
    out property <string> font-value: "JetBrains Mono";
    out property <brush> raised-overlay: SamplerTheme.soft ? @linear-gradient(180deg, #ffffff0d 0%, #ffffff00 50%, #0000001f 100%) : transparent;
    out property <brush> well-overlay: SamplerTheme.soft ? @linear-gradient(180deg, #00000038 0%, #00000000 35%, #ffffff04 100%) : transparent;
    out property <brush> accent-overlay: SamplerTheme.soft ? @linear-gradient(180deg, #ffffff38 0%, #0000001a 100%) : transparent;
    out property <brush> bevel: @linear-gradient(180deg, #ffffff61 0%, #ffffff0f 45%, #000000a6 100%);
    out property <brush> well-lip: @linear-gradient(180deg, #000000b3 0%, #ffffff1f 100%);
    out property <brush> brushed-light: @linear-gradient(100deg, #ffffff1a 0%, #ffffff00 35%, #0000000d 60%, #ffffff14 85%, #0000000a 100%);
}
