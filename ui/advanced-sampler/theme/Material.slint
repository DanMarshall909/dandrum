import { SamplerTheme } from "Theme.slint";

// Reusable, pointer-transparent paint for drawer bodies, key caps and panels.
// The v3 CSS applies its material image independently of outer panel shadows.
export component MaterialLayers inherits Rectangle {
    in property <bool> well: false;
    in property <bool> accent: false;
    in property <bool> wash: false;
    in property <bool> grain: true;
    in property <bool> raised: false;
    clip: true;
    border-radius: root.well ? 2px : 6px;
    if SamplerTheme.brushed && root.grain && !root.well && !root.accent && !root.wash : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height; background: SamplerTheme.brushed-light;
        // Paint the guide's three strata directly. Narrow or partially clipped key
        // caps must not ask the software renderer to slice an oversized texture.
        for stripe[i] in max(0, ceil(parent.height / 11px)) : Rectangle {
            x: 0px; y: i * 11px; width: parent.width; height: min(2px, max(0px, parent.height - self.y)); background: #ffffff0a;
        }
        for stripe[i] in max(0, ceil(parent.height / 5px)) : Rectangle {
            x: 0px; y: i * 5px; width: parent.width; height: min(1px, max(0px, parent.height - self.y)); background: #00000006;
        }
        for stripe[i] in max(0, ceil(parent.height / 3px)) : Rectangle {
            x: 0px; y: i * 3px; width: parent.width; height: min(2px, max(0px, parent.height - self.y));
            Rectangle { x: 0px; y: 0px; width: parent.width; height: min(1px, parent.height); background: #ffffff12; }
            Rectangle { x: 0px; y: 1px; width: parent.width; height: min(1px, max(0px, parent.height - 1px)); background: #00000009; }
        }
    }
    if !SamplerTheme.brushed && !root.well && !root.accent && !root.wash : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height; background: SamplerTheme.raised-overlay;
    }
    if root.well : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: SamplerTheme.brushed ? @linear-gradient(180deg, #00000024 0%, #00000000 40%) : SamplerTheme.well-overlay;
    }
    if SamplerTheme.soft && root.accent : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height; background: SamplerTheme.accent-overlay;
    }
    if SamplerTheme.soft && root.wash : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: @linear-gradient(180deg, SamplerTheme.accent.with-alpha(0.12) 0%, #0000000f 100%);
    }
    if root.raised && !root.well && (SamplerTheme.soft || SamplerTheme.brushed) : Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: 1px;
        background: SamplerTheme.brushed ? #ffffff8c : #ffffff0d;
    }
    if root.raised && !root.well && SamplerTheme.brushed : Rectangle {
        x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: #0000001f;
    }
    if root.well && SamplerTheme.brushed : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 2px;
        background: @linear-gradient(180deg, #00000040 0%, #00000000 100%);
    }
}

export component WindowMaterial inherits Rectangle {
    background: SamplerTheme.surface-window;
    if SamplerTheme.soft && !SamplerTheme.brushed : Image {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: SamplerTheme.window-lighting; image-fit: fill;
    }
    if SamplerTheme.brushed : MaterialLayers { x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: 0px; }
    @children
}

export component MaterialSurface inherits Rectangle {
    in property <color> base: SamplerTheme.surface-panel;
    in property <bool> well: false;
    // Only the design-system Panel explicitly opts into CSS surface-panel shadows.
    in property <bool> raised: false;
    in property <bool> accent: false;
    in property <bool> wash: false;
    in property <bool> edge: true;
    background: root.base;
    border-radius: root.well ? 2px : 6px;
    border-width: root.edge ? 1px : 0px;
    border-color: SamplerTheme.border-hairline;
    drop-shadow-color: root.accent && SamplerTheme.soft ? SamplerTheme.accent.with-alpha(0.5) : root.raised && !root.well ? (SamplerTheme.brushed ? #00000040 : SamplerTheme.soft ? #00000059 : transparent) : transparent;
    drop-shadow-offset-y: root.accent ? 0px : root.raised && !root.well ? (SamplerTheme.brushed ? 1px : 2px) : 0px;
    drop-shadow-blur: root.accent && SamplerTheme.soft ? 5px : root.raised && !root.well ? (SamplerTheme.brushed ? 3px : SamplerTheme.soft ? 6px : 0px) : 0px;
    MaterialLayers {
        x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: parent.border-radius;
        well: root.well; accent: root.accent; wash: root.wash; raised: root.raised;
    }
    @children
}
