import { SamplerTheme } from "Theme.slint";

export component WindowMaterial inherits Rectangle {
    background: SamplerTheme.surface-window;
    if SamplerTheme.soft && !SamplerTheme.brushed : Image {
        width: parent.width; height: parent.height;
        source: SamplerTheme.window-lighting; image-fit: fill;
    }
    if SamplerTheme.brushed : Rectangle {
        width: parent.width; height: parent.height; background: SamplerTheme.brushed-light;
        Image { width: parent.width; height: parent.height; source: @image-url("brushed-grain.svg"); image-fit: preserve; }
    }
    @children
}

// V3 material layers are explicit native overlays; the semantic base remains live.
export component MaterialSurface inherits Rectangle {
    in property <color> base: SamplerTheme.surface-panel;
    in property <bool> well: false;
    in property <bool> raised: true;
    in property <bool> accent: false;
    in property <bool> wash: false;
    in property <bool> edge: true;
    background: root.base;
    border-radius: root.well ? 2px : 6px;
    border-width: root.edge ? 1px : 0px;
    border-color: SamplerTheme.border-hairline;
    drop-shadow-color: root.accent && SamplerTheme.soft ? SamplerTheme.accent.with-alpha(0.5) : root.raised && !root.well ? (SamplerTheme.brushed ? #00000040 : SamplerTheme.soft ? #00000059 : transparent) : transparent;
    drop-shadow-offset-y: root.accent ? 0px : root.raised && !root.well ? (SamplerTheme.brushed ? 1px : 2px) : 0px;
    drop-shadow-blur: root.accent && SamplerTheme.soft ? 5px : root.raised && !root.well ? (SamplerTheme.brushed ? 3px : SamplerTheme.soft ? 6px : 0px) : 0px;
    // Clip only the material layers so the container can still host popovers.
    Rectangle {
        width: parent.width; height: parent.height; border-radius: parent.border-radius; clip: true;
        if SamplerTheme.brushed && !root.well && !root.accent && !root.wash : Rectangle {
            width: parent.width; height: parent.height; background: SamplerTheme.brushed-light;
            Image { width: parent.width; height: parent.height; source: @image-url("brushed-grain.svg"); image-fit: preserve; }
        }
        if !SamplerTheme.brushed && !root.well && !root.accent && !root.wash : Rectangle {
            width: parent.width; height: parent.height; background: SamplerTheme.raised-overlay;
        }
        if root.well : Rectangle {
            width: parent.width; height: parent.height;
            background: SamplerTheme.brushed ? @linear-gradient(180deg, #00000024 0%, #00000000 40%) : SamplerTheme.well-overlay;
        }
        if SamplerTheme.soft && root.accent : Rectangle {
            width: parent.width; height: parent.height; background: SamplerTheme.accent-overlay;
        }
        if SamplerTheme.soft && root.wash : Rectangle {
            width: parent.width; height: parent.height;
            background: @linear-gradient(180deg, SamplerTheme.accent.with-alpha(0.12) 0%, #0000000f 100%);
        }
        if root.raised && !root.well && (SamplerTheme.soft || SamplerTheme.brushed) : Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: 1px;
            background: SamplerTheme.brushed ? #ffffff8c : #ffffff0d;
        }
        if root.raised && !root.well && SamplerTheme.brushed : Rectangle {
            x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: #0000001f;
        }
        if root.well && SamplerTheme.brushed : Rectangle {
            x: 0px; y: 0px; width: parent.width; height: 2px;
            background: @linear-gradient(180deg, #00000040 0%, #00000000 100%);
        }
    }
    @children
}
