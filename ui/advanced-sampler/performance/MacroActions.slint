import { SamplerCommands } from "../domain/Commands.slint";
import { Tokens } from "../../slint/theme.slint";
import { EditorTextField } from "../../slint/editor/TextField.slint";
import { Session } from "../Session.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { ActionButton } from "../controls/ActionButton.slint";
import { DragState } from "../chrome/DragState.slint";
export component MacroActions inherits Rectangle {
    in property <string> macro-id;
    private property <bool> renaming;
    callback close-requested();
    height: root.renaming ? Tokens.editor-macro-rename-menu-height : Tokens.editor-macro-menu-height; width: Tokens.editor-macro-menu-width;
    background: SamplerTheme.surface-menu; border-width: Tokens.editor-border-width; border-color: SamplerTheme.line-3; border-radius: Tokens.editor-radius-group;
    drop-shadow-blur: Tokens.editor-browser-shadow-blur; drop-shadow-offset-y: Tokens.editor-chrome-gap; drop-shadow-color: Tokens.editor-browser-shadow;
    public function rename(name: string) -> bool { let accepted = Session.command(SamplerCommands.macro-rename, root.macro-id, name, 0); if accepted { root.close-requested(); } return accepted; }
    public function run(action: string, value: float) { Session.command(action, root.macro-id, "", value); root.close-requested(); }
    for macro in Session.macros : Rectangle { visible: macro.id == root.macro-id;
        Text { x: Tokens.editor-chrome-content-inset; y: Tokens.editor-chrome-gap; height: Tokens.editor-item-height; text: macro.name; font-family: SamplerTheme.font-ui; font-size: SamplerTheme.type-heading; font-weight: Tokens.editor-weight-semibold; color: SamplerTheme.paper-1; }
        ActionButton { x: parent.width - Tokens.editor-chrome-close-right; y: Tokens.editor-chrome-gap; compact: true; ghost: true; icon: Tokens.editor-icon-close; label: "Close macro actions"; clicked => { root.close-requested(); } }
        VerticalLayout { x: Tokens.editor-chrome-inset-small; y: Tokens.editor-macro-actions-top; width: parent.width - Tokens.editor-chrome-content-inset; spacing: Tokens.editor-chrome-gap-tight; alignment: start;
            ActionButton { text: "Rename…"; label: "Rename macro"; ghost: true; clicked => { root.renaming = true; } }
            ActionButton { text: "Reset value"; label: "Reset macro value"; ghost: true; clicked => { root.run(SamplerCommands.macro-reset, 0); } }
            ActionButton { text: "Edit destinations…"; label: "Edit macro destinations"; ghost: true; clicked => { Session.command(SamplerCommands.macro-select, root.macro-id, "", 0); Session.command(SamplerCommands.page-select, "macros", "", 0); root.close-requested(); } }
            ActionButton { text: "Clear destinations"; label: "Clear macro destinations"; enabled: macro.destinations.length > 0; ghost: true; clicked => { root.run(SamplerCommands.macro-clear, 0); } }
            ActionButton { text: "Learn MIDI CC"; label: "Learn macro MIDI CC"; ghost: true; clicked => { root.run(SamplerCommands.macro-learn, 0); } }
            ActionButton { text: "Stop MIDI learn"; label: "Stop macro MIDI learn"; enabled: Session.midi-learn == root.macro-id; ghost: true; clicked => { root.run(SamplerCommands.macro-learn-stop, 0); } }
            ActionButton { text: macro.host-automated ? "Disable host automation" : "Enable host automation"; label: macro.host-automated ? "Disable macro host automation" : "Enable macro host automation"; ghost: true; selected: macro.host-automated; clicked => { root.run(SamplerCommands.macro-host, macro.host-automated ? 0 : 1); } }
        }
        if root.renaming : Rectangle { x: Tokens.editor-chrome-gap; y: Tokens.editor-macro-rename-top; width: parent.width - Tokens.editor-chrome-gap-large; height: Tokens.editor-macro-rename-height; border-width: Tokens.editor-border-width; border-color: SamplerTheme.accent; background: SamplerTheme.surface-well;
            EditorTextField { x: Tokens.editor-chrome-inset-small; y: Tokens.editor-chrome-inset-control-top; height: Tokens.editor-button-compact-size; width: parent.width - Tokens.editor-macro-rename-text-reserve; text: macro.name; accessible-label: "Macro name";
                focus-left => { Session.release-notes(); DragState.cancel(); }
                accepted => { root.rename(self.text); }
            }
            ActionButton { x: parent.width - Tokens.editor-chrome-close-right; y: Tokens.editor-chrome-inset-control-top; compact: true; ghost: true; icon: Tokens.editor-icon-close; label: "Cancel macro rename"; clicked => { root.renaming = false; } }
        }
    }
}
