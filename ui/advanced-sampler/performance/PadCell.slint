import { DragKinds } from "../../slint/editor/Drag.slint";
import { SamplerCommands } from "../domain/Commands.slint";
import { Tokens } from "../../slint/theme.slint";
import { EditorPad } from "../../slint/editor/Pad.slint";
import { Session } from "../Session.slint";
import { DragTarget, DragState } from "../chrome/DragState.slint";
import { SamplerTheme } from "../theme/Theme.slint";
export component PadCell inherits EditorPad {
    small-font-size: Tokens.editor-display-type-v3-small;
    public function assign-source(asset: string) -> bool { return Session.command(SamplerCommands.pad-assign, "" + root.note, asset, 0); }
    window-deactivated => { Session.release-notes(); DragState.cancel(); }
    DragTarget { accepted-kind: DragKinds.source; accept-slices: true; enabled: root.enabled; border-width: self.drag-over ? 2px : 0px; border-color: SamplerTheme.accent; border-radius: 4px;
        dropped(asset) => { return root.assign-source(asset); }
    }
}
