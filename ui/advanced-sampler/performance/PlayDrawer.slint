import { Tokens } from "../../slint/theme.slint";
import { EditorLayoutMetrics } from "../../slint/editor/LayoutMetrics.slint";
import { MusicalConstants } from "../../slint/editor/DisplayConstants.slint";
import { SamplerViewport } from "../domain/UiConstants.slint";
import { MaterialLayers } from "../theme/Material.slint";
import { SamplerTheme } from "../theme/Theme.slint";
import { PadInfo, MacroInfo } from "types.slint";
import { PerformanceState } from "PerformanceState.slint";
import { PlayBar } from "PlayBar.slint";
import { MacroGrid } from "MacroGrid.slint";
import { PlayPads } from "PlayPads.slint";
import { PlayKeys } from "PlayKeys.slint";
import { ResizeHandle } from "../controls/ResizeHandle.slint";
export component PlayDrawer inherits Rectangle {
    in property <[PadInfo]> pads;
    in property <[MacroInfo]> macros;
    in property <[int]> sounding-notes;
    in property <int> mapped-low: MusicalConstants.mapped-low;
    in property <int> mapped-high: MusicalConstants.mapped-high;
    in property <int> size-mode: EditorLayoutMetrics.default-mode;
    in property <length> window-height: SamplerViewport.default-height;
    in property <string> generation;
    private property <string> empty-sections-help: "Turn on macros, pads or keyboard with the icons above.";
    private property <length> standard-height: root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-layout-drawer-compact : root.size-mode == EditorLayoutMetrics.expanded-mode ? Tokens.editor-layout-drawer-expanded : Tokens.editor-layout-drawer;
    private property <length> body-height: PerformanceState.body-height > 0px ? PerformanceState.body-height : root.standard-height;
    private property <length> minimum-body-height: root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-minimum-compact : Tokens.editor-drawer-minimum;
    private property <length> resize-start;
    private property <length> split-start;
    private property <length> pad-start;
    private property <length> macro-width: PerformanceState.show-macros ? (PerformanceState.macro-width > 0px ? PerformanceState.macro-width : root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-macro-width-compact : root.size-mode == EditorLayoutMetrics.expanded-mode ? Tokens.editor-drawer-macro-width-expanded : Tokens.editor-drawer-macro-width) : 0px;
    private property <length> pads-width: !PerformanceState.show-pads ? 0px : !PerformanceState.show-keys ? max(Tokens.editor-drawer-pad-area-minimum, root.width - root.macro-width - Tokens.editor-drawer-pad-only-reserve) : PerformanceState.pad-width > 0px ? PerformanceState.pad-width : root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-pad-width-compact : root.size-mode == EditorLayoutMetrics.expanded-mode ? Tokens.editor-drawer-pad-width-expanded : Tokens.editor-drawer-pad-width;
    callback note-on(int, int, string); callback note-off(int, string); callback selected(int);
    callback macro-gesture(string, int, float); callback context-action(string, string); callback pc-changed(bool);
    height: Tokens.editor-chrome-section-header-height + (PerformanceState.open ? root.body-height : 0px);
    border-radius: Tokens.editor-radius-panel; border-width: Tokens.editor-border-width; border-color: SamplerTheme.line-1; background: SamplerTheme.ink-2;
    MaterialLayers { x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: Tokens.editor-radius-panel; }
    PlayBar { x: Tokens.editor-border-width; y: Tokens.editor-border-width; width: parent.width - Tokens.editor-chrome-gap-tight; height: Tokens.editor-drawer-bar-height; pc-changed(on) => { root.pc-changed(on); } }
    ResizeHandle { z: Tokens.editor-drawer-resize-z; x: 0px; y: -Tokens.editor-drawer-resize-top; width: parent.width; height: Tokens.editor-drawer-resize-thickness; vertical: true;
        started => { root.resize-start = PerformanceState.open ? root.body-height : 0px; }
        moved-by(delta) => { let h = root.resize-start - delta; PerformanceState.open = h >= root.minimum-body-height / 2; PerformanceState.body-height = h.clamp(root.minimum-body-height, root.window-height - (root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-window-reserve-compact : Tokens.editor-drawer-window-reserve)); if !PerformanceState.open { PerformanceState.release-notes(); } }
        reset => { PerformanceState.body-height = 0px; PerformanceState.open = true; }
    }
    if PerformanceState.open : Rectangle { y: Tokens.editor-chrome-section-header-height; height: root.body-height; clip: true;
        if PerformanceState.show-macros : MacroGrid { x: Tokens.editor-chrome-gap; y: Tokens.editor-chrome-inset-small; width: root.macro-width; height: parent.height - Tokens.editor-chrome-content-inset; macros: root.macros; face-size: root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-macro-face-compact : root.size-mode == EditorLayoutMetrics.expanded-mode ? Tokens.editor-drawer-macro-face-expanded : Tokens.editor-drawer-macro-face; budget: root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-macro-budget-compact : root.size-mode == EditorLayoutMetrics.expanded-mode ? Tokens.editor-drawer-macro-budget-expanded : Tokens.editor-drawer-macro-budget;
            macro-gesture(id, phase, v) => { root.macro-gesture(id, phase, v); } context-action(a, id) => { root.context-action(a, id); }
        }
        if PerformanceState.show-macros && (PerformanceState.show-pads || PerformanceState.show-keys) : ResizeHandle { x: root.macro-width + Tokens.editor-chrome-inset-text; y: Tokens.editor-chrome-inset-small; width: Tokens.editor-chrome-gap; height: parent.height - Tokens.editor-chrome-content-inset;
            started => { root.split-start = root.macro-width; } moved-by(delta) => { PerformanceState.macro-width = (root.split-start + delta).clamp(Tokens.editor-drawer-macro-width-minimum, root.width / 2); } reset => { PerformanceState.macro-width = 0px; }
        }
        if PerformanceState.show-pads : PlayPads { x: PerformanceState.show-macros ? root.macro-width + Tokens.editor-drawer-pad-with-macros-offset : Tokens.editor-chrome-gap; y: Tokens.editor-chrome-inset-small; width: root.pads-width; height: parent.height - Tokens.editor-chrome-content-inset; pads: root.pads; mapped-low: root.mapped-low; mapped-high: root.mapped-high; minimum-size: root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-pad-minimum-compact : root.size-mode == EditorLayoutMetrics.expanded-mode ? Tokens.editor-drawer-pad-minimum-expanded : MusicalConstants.pad-minimum-size; maximum-size: root.size-mode == EditorLayoutMetrics.compact-mode ? Tokens.editor-drawer-pad-maximum-compact : root.size-mode == EditorLayoutMetrics.expanded-mode ? Tokens.editor-drawer-pad-maximum-expanded : MusicalConstants.pad-maximum-size; force-compact: true; generation: root.generation;
            note-on(n,v,s) => { root.note-on(n,v,s); } note-off(n,s) => { root.note-off(n,s); } selected(n) => { root.selected(n); }
        }
        if PerformanceState.show-pads && PerformanceState.show-keys : ResizeHandle { x: (PerformanceState.show-macros ? root.macro-width + Tokens.editor-drawer-pad-with-macros-offset : Tokens.editor-chrome-gap) + root.pads-width + Tokens.editor-chrome-gap; y: Tokens.editor-chrome-inset-small; width: Tokens.editor-chrome-gap; height: parent.height - Tokens.editor-chrome-content-inset;
            started => { root.pad-start = root.pads-width; } moved-by(delta) => { PerformanceState.pad-width = (root.pad-start + delta).clamp(Tokens.editor-drawer-pad-width-minimum, max(Tokens.editor-drawer-pad-width-minimum, root.width - root.macro-width - Tokens.editor-drawer-key-width-reserve)); } reset => { PerformanceState.pad-width = 0px; }
        }
        if PerformanceState.show-keys : PlayKeys { x: (PerformanceState.show-macros ? root.macro-width + Tokens.editor-drawer-pad-with-macros-offset : Tokens.editor-chrome-gap) + (PerformanceState.show-pads ? root.pads-width + Tokens.editor-chrome-content-inset-pair : 0px); y: Tokens.editor-chrome-inset-small; width: max(1px, parent.width - self.x - Tokens.editor-chrome-gap); height: parent.height - Tokens.editor-chrome-content-inset; mapped-low: root.mapped-low; mapped-high: root.mapped-high; sounding-notes: root.sounding-notes; generation: root.generation;
            note-on(n,v,s) => { root.note-on(n,v,s); } note-off(n,s) => { root.note-off(n,s); }
        }
        if !PerformanceState.show-macros && !PerformanceState.show-pads && !PerformanceState.show-keys : Text { x: Tokens.editor-chrome-gap; text: root.empty-sections-help; font-family: SamplerTheme.font-ui; font-size: SamplerTheme.type-body; color: SamplerTheme.paper-3; vertical-alignment: center; }
    }
}
