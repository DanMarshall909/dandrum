import { ModAssignment } from "../../slint/modulation/types.slint";
export struct PadInfo {
    id: string, name: string, note: int, mapped: bool, choke-group: int,
    selected: bool, level: float, sounding: bool, key-label: string,
    velocity-low: int, velocity-high: int, velocity: int,
    alternates: int, active-alternate: int, layers: int, choked: bool,
    pitch-ratio: float, gain: float, pan: float, start: float, variation: float,
    muted: bool, solo: bool, output: string, send-a: float, send-b: float,
}
export struct PatchInfo {
    id: string, name: string, category: string, origin: string,
    contents: string, favourite: bool, selected: bool,
}
export struct MacroInfo {
    id: string, name: string, value: float, default-value: float,
    minimum: float, maximum: float, unit: string, host-automated: bool,
    destinations: [string], assignments: [ModAssignment],
}
