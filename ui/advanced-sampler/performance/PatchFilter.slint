        if root.at(patches, 7, query, category) { return patches[7].id; }
        if root.at(patches, 8, query, category) { return patches[8].id; }
        if root.at(patches, 9, query, category) { return patches[9].id; }
        if root.at(patches, 10, query, category) { return patches[10].id; }
        if root.at(patches, 11, query, category) { return patches[11].id; }
        if root.at(patches, 12, query, category) { return patches[12].id; }
        if root.at(patches, 13, query, category) { return patches[13].id; }
        if root.at(patches, 14, query, category) { return patches[14].id; }
        if root.at(patches, 15, query, category) { return patches[15].id; }
        if root.at(patches, 16, query, category) { return patches[16].id; }
        if root.at(patches, 17, query, category) { return patches[17].id; }
        if root.at(patches, 18, query, category) { return patches[18].id; }
        if root.at(patches, 19, query, category) { return patches[19].id; }
        if root.at(patches, 20, query, category) { return patches[20].id; }
        if root.at(patches, 21, query, category) { return patches[21].id; }
        if root.at(patches, 22, query, category) { return patches[22].id; }
        if root.at(patches, 23, query, category) { return patches[23].id; }
        if root.at(patches, 24, query, category) { return patches[24].id; }
        if root.at(patches, 25, query, category) { return patches[25].id; }
        if root.at(patches, 26, query, category) { return patches[26].id; }
        if root.at(patches, 27, query, category) { return patches[27].id; }
        if root.at(patches, 28, query, category) { return patches[28].id; }
        if root.at(patches, 29, query, category) { return patches[29].id; }
        if root.at(patches, 30, query, category) { return patches[30].id; }
        if root.at(patches, 31, query, category) { return patches[31].id; }
        if root.at(patches, 32, query, category) { return patches[32].id; }
        if root.at(patches, 33, query, category) { return patches[33].id; }
        if root.at(patches, 34, query, category) { return patches[34].id; }
        if root.at(patches, 35, query, category) { return patches[35].id; }
        if root.at(patches, 36, query, category) { return patches[36].id; }
        if root.at(patches, 37, query, category) { return patches[37].id; }
        if root.at(patches, 38, query, category) { return patches[38].id; }
        if root.at(patches, 39, query, category) { return patches[39].id; }
        if root.at(patches, 40, query, category) { return patches[40].id; }
        if root.at(patches, 41, query, category) { return patches[41].id; }
        if root.at(patches, 42, query, category) { return patches[42].id; }
        if root.at(patches, 43, query, category) { return patches[43].id; }
        if root.at(patches, 44, query, category) { return patches[44].id; }
        if root.at(patches, 45, query, category) { return patches[45].id; }
        if root.at(patches, 46, query, category) { return patches[46].id; }
        if root.at(patches, 47, query, category) { return patches[47].id; }
        if root.at(patches, 48, query, category) { return patches[48].id; }
        if root.at(patches, 49, query, category) { return patches[49].id; }
        if root.at(patches, 50, query, category) { return patches[50].id; }
        if root.at(patches, 51, query, category) { return patches[51].id; }
        if root.at(patches, 52, query, category) { return patches[52].id; }
        if root.at(patches, 53, query, category) { return patches[53].id; }
        if root.at(patches, 54, query, category) { return patches[54].id; }
        if root.at(patches, 55, query, category) { return patches[55].id; }
        if root.at(patches, 56, query, category) { return patches[56].id; }
        if root.at(patches, 57, query, category) { return patches[57].id; }
        if root.at(patches, 58, query, category) { return patches[58].id; }
        if root.at(patches, 59, query, category) { return patches[59].id; }
        if root.at(patches, 60, query, category) { return patches[60].id; }
        if root.at(patches, 61, query, category) { return patches[61].id; }
        if root.at(patches, 62, query, category) { return patches[62].id; }
        if root.at(patches, 63, query, category) { return patches[63].id; }
        return "";
    }
}
