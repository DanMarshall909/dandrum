import { Tokens } from "../../ui/slint/theme.slint";
import { Button } from "../../ui/slint/controls/Button.slint";
import { KeyMap } from "../../ui/slint/display/KeyMap.slint";
import { LayerStack } from "../../ui/slint/display/LayerStack.slint";
import { WaveformPanel } from "../../ui/slint/display/WaveformPanel.slint";
import { KeyZone } from "../../ui/slint/display/types.slint";
import { ZoneRectangle } from "../../ui/slint/display/ZoneRectangle.slint";

export component DisplayEdges inherits Window {
    title: "Dandrum display edge contracts";
    width: 1200px; height: 1040px; background: Tokens.surface-window;
    in-out property <int> notes;
    in-out property <int> releases;
    in-out property <int> mutations;
    in-out property <int> inspections;
    in-out property <string> last-slice: "none";
    in-out property <float> binding-level: -3;
    in-out property <float> binding-send: -12;
    in-out property <bool> binding-muted;
    private property <int> level-edits;
    private property <int> send-edits;
    private property <int> mute-edits;
    private property <int> level-begins;
    private property <int> level-ends;
    private property <int> send-begins;
    private property <int> send-ends;
    private property <bool> pending;
    private property <bool> tests-ran;
    private property <bool> contract-ok;
    property <KeyZone> fixture-zone: {id:"editable",name:"Editable zone",source:"Sample",lo:48,hi:54,vel-lo:32,vel-hi:96,root-note:48,has-root:true};
    property <KeyZone> last-proposal: root.fixture-zone;
    public function exercise() {
        root.notes = 0; root.releases = 0; root.mutations = 0; root.tests-ran = false;
        map.enabled = true; map.available = true; map.can-edit = true;
        map.audition(root.fixture-zone);
        map.enabled = false;
        map.request-edit(root.fixture-zone);
        root.pending = true;
    }
    Timer {
        interval: 20ms; running: root.pending;
        triggered => {
            root.pending = false;
            root.contract-ok = root.notes == 1 && root.releases == 1 && root.mutations == 0;
            map.enabled = true;
            root.tests-ran = true;
        }
    }
    VerticalLayout {
        padding: 12px; spacing: 10px;
        HorizontalLayout {
            height: 28px; spacing: 8px;
            run-tests-button := Button { width: 110px; text: "Run tests"; clicked => { root.exercise(); } }
            report := Text { color: Tokens.text-primary; text: !root.tests-ran ? "Not run" : root.contract-ok ? "PASS: display edge behavior checks" : "FAIL: display edge behavior checks"; }
            disable-map := Button { width: 130px; text: map.enabled ? "Disable map" : "Enable map"; clicked => { map.enabled = !map.enabled; } }
            rebuild-map := Button { width: 130px; text: map.rebuilding ? "Finish rebuild" : "Rebuild map"; clicked => { map.rebuilding = !map.rebuilding; } }
            host-refresh := Button { width: 130px; text: "Host refresh"; clicked => { root.binding-level = -18; root.binding-send = -24; root.binding-muted = false; } }
        }
        event-report := Text {
            height: 24px; color: Tokens.text-primary; font-family: Tokens.font-value; font-size: 11px;
            text: "Edits: \{root.mutations}; notes: \{root.notes}; releases: \{root.releases}; zoom: \{round(map.zoom * 100)}; bounds: \{root.last-proposal.lo},\{root.last-proposal.hi},\{root.last-proposal.vel-lo},\{root.last-proposal.vel-hi}; inspections: \{root.inspections}; slice: \{root.last-slice}";
        }
        binding-report := Text {
            height: 24px; color: Tokens.text-primary; font-family: Tokens.font-value; font-size: 11px;
            text: "Bound level: \{root.binding-level}; send: \{root.binding-send}; muted: \{root.binding-muted ? 1 : 0}; edits: \{root.level-edits},\{root.send-edits},\{root.mute-edits}";
        }
        gesture-report := Text {
            height: 24px; color: Tokens.text-primary; font-family: Tokens.font-value; font-size: 11px;
            text: "Level gestures: \{root.level-begins},\{root.level-ends}; send gestures: \{root.send-begins},\{root.send-ends}";
        }
        map := KeyMap {
            height: 280px; zones: [root.fixture-zone]; low-note: 48; high-note: 71; can-edit: true;
            note-on(note,velocity) => { root.notes += 1; }
            note-off(note) => { root.releases += 1; }
            edit-zone(zone) => { root.mutations += 1; root.last-proposal = zone; }
        }
        stack := LayerStack {
            height: 340px; title: "Source and module lifecycle"; subtitle: "Repeated selection and Escape close details and restore focus.";
            layers: [{id:"sample",name:"Prepared layer",source:"Sample",detail:"source-detail.wav",parameters:[],
                modules:[{id:"filter",title:"Filter",detail:"LP12 · 2.4 kHz",bypassed:false,can-bypass:false,can-remove:false,parameters:[]}],
                sends:[],output:"Main",level:-3,muted:false,can-level:false,can-mute:false,can-add:false,can-output:false},
                {id:"binding",name:"Binding layer",source:"Sample",detail:"Acknowledged host model",parameters:[],modules:[],
                sends:[{id:"room",name:"Room",value:root.binding-send,available:true}],output:"Main",level:root.binding-level,muted:root.binding-muted,
                can-level:true,can-mute:true,can-add:false,can-output:false}];
            source-selected(id) => { root.inspections += 1; }
            module-selected(layer,id) => { root.inspections += 1; }
            level-changed(layer,value) => { if layer == "binding" { root.binding-level = value; root.level-edits += 1; } }
            level-gesture-began(layer) => { if layer == "binding" { root.level-begins += 1; } }
            level-gesture-ended(layer) => { if layer == "binding" { root.level-ends += 1; } }
            send-changed(layer,id,value) => { if layer == "binding" { root.binding-send = value; root.send-edits += 1; } }
            send-gesture-began(layer,id) => { if layer == "binding" { root.send-begins += 1; } }
            send-gesture-ended(layer,id) => { if layer == "binding" { root.send-ends += 1; } }
            mute-changed(layer,value) => { if layer == "binding" { root.binding-muted = value; root.mute-edits += 1; } }
        }
        selected-waveform := WaveformPanel {
            height: 200px; state: "ready"; selected-slice: "first"; show-display-toggle: false;
            peaks: [{minimum:-0.5,maximum:0.75},{minimum:-0.25,maximum:0.5},{minimum:-0.125,maximum:0.25}];
            slices: [{id:"first",name:"Selected slice names remain readable beyond a narrow region",start:0.1,end:0.2},
                {id:"second",name:"Second",start:0.2,end:0.4},{id:"third",name:"Third",start:0.4,end:0.8}];
            slice-selected(id) => { root.last-slice = id; }
            selected-label-probe := Rectangle { x: parent.width * 0.3; y: 2px; width: 1px; height: 1px; }
        }
    }
    Text { x: 1030px; y: 482px; text: "CORNER RESIZE"; font-family: Tokens.font-ui; font-size: 11px; color: Tokens.text-secondary; }
    corner-zone := ZoneRectangle {
        x: 1030px; y: 500px; width: 140px; height: 130px;
        zone: root.fixture-zone; low-note: 48; high-note: 71; semitone-width: 20px; grid-height: 254px; editable: true;
        edit-zone(zone) => { root.mutations += 1; root.last-proposal = zone; }
        corner-probe := Rectangle { x: 137px; y: 1px; width: 1px; height: 1px; }
    }
}
