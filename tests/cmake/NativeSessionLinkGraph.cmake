foreach(link_file IN ITEMS "${LINK_FILE}" "${STANDALONE_LINK_FILE}" "${VST3_LINK_FILE}")
    if(NOT EXISTS "${link_file}")
        message(FATAL_ERROR "Native session link command is missing: ${link_file}")
    endif()
    file(READ "${link_file}" link_command)
    string(REGEX MATCHALL "libdandrum_instrument_session\\.a" session_archives "${link_command}")
    list(LENGTH session_archives session_archive_count)
    if(NOT session_archive_count EQUAL 1)
        message(FATAL_ERROR
            "Native session target must link the combined session archive exactly once; found ${session_archive_count} in ${link_file}")
    endif()
    if(link_command MATCHES "libdandrum_engine\\.a")
        message(FATAL_ERROR "Native session target also links the standalone engine archive: ${link_file}")
    endif()
endforeach()

execute_process(
    COMMAND "${NM}" -g --defined-only "${SESSION_LIB}"
    RESULT_VARIABLE archive_result OUTPUT_VARIABLE archive_symbols ERROR_VARIABLE archive_error)
if(NOT archive_result EQUAL 0)
    message(FATAL_ERROR "Could not inspect session archive: ${archive_error}")
endif()
foreach(symbol IN ITEMS dandrum_instrument_session_create dandrum_kernel_render)
    string(REGEX MATCHALL "[ \t]${symbol}" matches "${archive_symbols}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Combined session archive defines ${symbol} ${count} times")
    endif()
endforeach()

foreach(product IN ITEMS "${CONSUMER}" "${STANDALONE}" "${VST3}")
    execute_process(
        COMMAND "${NM}" -g --defined-only "${product}"
        RESULT_VARIABLE product_result OUTPUT_VARIABLE product_symbols ERROR_VARIABLE product_error)
    if(NOT product_result EQUAL 0)
        message(FATAL_ERROR "Could not inspect native session product ${product}: ${product_error}")
    endif()
    foreach(symbol IN ITEMS dandrum_instrument_session_create dandrum_kernel_render)
        string(REGEX MATCHALL "[ \t]${symbol}" matches "${product_symbols}")
        list(LENGTH matches count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Native session product ${product} resolves ${symbol} ${count} times")
        endif()
    endforeach()
endforeach()
message(STATUS "Native proof, Standalone and VST3 each use one combined Rust archive and one engine symbol set")
