+fn session(note: u8) -> InstrumentSession {
+    let repository = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let yaml = std::fs::read_to_string(repository.join("examples/patches/advanced-drum-kit.yaml"))
