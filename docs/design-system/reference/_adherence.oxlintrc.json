{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/display/**",
              "components/feedback/**",
              "components/icons/**",
              "components/layout/**",
              "components/navigation/**",
              "tools/**",
              "ui_kits/das-sampler/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Semi Condensed|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Semi Condensed, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|selected|disabled|focused|pressed|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, selected, disabled, focused, pressed, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|shortcut|disabled|danger|checked|submenu|header|note|separator|onSelect|type|slot|source|depth|onDepth|onRemove|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: label, icon, shortcut, disabled, danger, checked, submenu, header, note, separator, onSelect, type, slot, source, depth, onDepth, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:assignment)$/]",
        "message": "<MenuItem> type must be one of 'assignment'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute[name.name='slot'] > Literal[value!=/^(?:A|B|C|D)$/]",
        "message": "<MenuItem> slot must be one of 'A' | 'B' | 'C' | 'D'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyMapZone'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|source|lo|hi|velLo|velHi|root|key|ref|className|style|children)$/]",
        "message": "<KeyMapZone> doesn't accept that prop. Declared props: id, name, source, lo, hi, velLo, velHi, root."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModAssignment'] > JSXAttribute > JSXIdentifier[name!=/^(?:slot|depth|source|live|key|ref|className|style|children)$/]",
        "message": "<ModAssignment> doesn't accept that prop. Declared props: slot, depth, source, live."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModAssignment'] > JSXAttribute[name.name='slot'] > Literal[value!=/^(?:A|B|C|D)$/]",
        "message": "<ModAssignment> slot must be one of 'A' | 'B' | 'C' | 'D'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModuleParam'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|value|min|max|default|unit|log|bipolar|options|summary|key|ref|className|style|children)$/]",
        "message": "<ModuleParam> doesn't accept that prop. Declared props: id, label, value, min, max, default, unit, log, bipolar, options, summary."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|value|icon|leading|trailing|selected|active|disabled|compact|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: label, detail, value, icon, leading, trailing, selected, active, disabled, compact, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute > JSXIdentifier[name!=/^(?:levels|peak|clip|orientation|length|thickness|compact|label|onResetClip|key|ref|className|style|children)$/]",
        "message": "<Meter> doesn't accept that prop. Declared props: levels, peak, clip, orientation, length, thickness, compact, label, onResetClip."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<Meter> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:slot|depth|source|host|active|compact|key|ref|className|style|children)$/]",
        "message": "<ModIndicator> doesn't accept that prop. Declared props: slot, depth, source, host, active, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModIndicator'] > JSXAttribute[name.name='slot'] > Literal[value!=/^(?:A|B|C|D)$/]",
        "message": "<ModIndicator> slot must be one of 'A' | 'B' | 'C' | 'D'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumericField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|defaultValue|unit|label|format|width|compact|readOnly|disabled|focused|hostAutomated|onChange|onContextMenu|key|ref|className|style|children)$/]",
        "message": "<NumericField> doesn't accept that prop. Declared props: value, min, max, step, defaultValue, unit, label, format, width, compact, readOnly, disabled, focused, hostAutomated, onChange, onContextMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutputBus'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|channels|main|feeds|levels|level|muted|key|ref|className|style|children)$/]",
        "message": "<OutputBus> doesn't accept that prop. Declared props: id, name, channels, main, feeds, levels, level, muted."
      },
      {
        "selector": "JSXOpeningElement[name.name='PadCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:note|name|mapped|selected|level|velocity|alternates|activeAlternate|layers|activeLayer|chokeGroup|choked|missing|focused|disabled|compact|size|onTrigger|onSelect|onRelease|style|key|ref|className|style|children)$/]",
        "message": "<PadCell> doesn't accept that prop. Declared props: note, name, mapped, selected, level, velocity, alternates, activeAlternate, layers, activeLayer, chokeGroup, choked, missing, focused, disabled, compact, size, onTrigger, onSelect, onRelease, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tag|prepared|actions|children|compact|padding|style|bodyStyle|tone|collapsible|collapsed|defaultCollapsed|onToggle|summary|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, tag, prepared, actions, children, compact, padding, style, bodyStyle, tone, collapsible, collapsed, defaultCollapsed, onToggle, summary."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|sunken)$/]",
        "message": "<Panel> tone must be one of 'default' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModAssignment'] > JSXAttribute > JSXIdentifier[name!=/^(?:slot|depth|source|live|key|ref|className|style|children)$/]",
        "message": "<ModAssignment> doesn't accept that prop. Declared props: slot, depth, source, live."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModAssignment'] > JSXAttribute[name.name='slot'] > Literal[value!=/^(?:A|B|C|D)$/]",
        "message": "<ModAssignment> slot must be one of 'A' | 'B' | 'C' | 'D'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|children|action|inline|compact|key|ref|className|style|children)$/]",
        "message": "<StatusMessage> doesn't accept that prop. Declared props: kind, title, children, action, inline, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMessage'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:ok|warn|error|info|busy)$/]",
        "message": "<StatusMessage> kind must be one of 'ok' | 'warn' | 'error' | 'info' | 'busy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|badge|disabled|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, icon, badge, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|disabled|focused|hostAutomated|compact|onChange|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, label, disabled, focused, hostAutomated, compact, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveformPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|peaks|height|regionStart|regionEnd|fadeIn|fadeOut|loopStart|loopEnd|crossfade|slices|selectedSlice|cursor|startOffset|startModulation|display|defaultDisplay|onDisplayChange|showDisplayToggle|reversed|hostAutomated|compact|missing|label|style|key|ref|className|style|children)$/]",
        "message": "<WaveformPanel> doesn't accept that prop. Declared props: kind, peaks, height, regionStart, regionEnd, fadeIn, fadeOut, loopStart, loopEnd, crossfade, slices, selectedSlice, cursor, startOffset, startModulation, display, defaultDisplay, onDisplayChange, showDisplayToggle, reversed, hostAutomated, compact, missing, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveformPanel'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:kick|snare|snare-soft|hat-closed|hat-open|break)$/]",
        "message": "<WaveformPanel> kind must be one of 'kick' | 'snare' | 'snare-soft' | 'hat-closed' | 'hat-open' | 'break'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveformPanel'] > JSXAttribute[name.name='display'] > Literal[value!=/^(?:wave|spectral)$/]",
        "message": "<WaveformPanel> display must be one of 'wave' | 'spectral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveformPanel'] > JSXAttribute[name.name='defaultDisplay'] > Literal[value!=/^(?:wave|spectral)$/]",
        "message": "<WaveformPanel> defaultDisplay must be one of 'wave' | 'spectral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
