#!/usr/bin/env bash
set -euo pipefail

ENGINE_DIR="$(git rev-parse --show-toplevel)/src/rust-engine"
CARGO="${DANDRUM_CARGO:-$HOME/.cargo/bin/cargo}"

echo "=== Running Rust unit tests ==="
"$CARGO" test --manifest-path "$ENGINE_DIR/Cargo.toml"

# Mutation is excluded by recorded user direction for the JUCE-free Trigger beta.
# Any later authorized mutation belongs to the separate post-session workflow,
# rather than a push hook that also runs for intermediate verified commits.
echo "mutation-policy: excluded (recorded user direction; no mutation jobs in pre-push)"
