import { Theme } from "Theme.slint";

export component MacroValue inherits Rectangle {
    in-out property <float> value;
    in-out property <bool> editing;
    in property <string> label;
    in property <bool> revealed;
    callback closed(bool);
    width: 64px; height: 16px;
    visible: root.revealed || root.editing;
    background: root.editing ? Theme.cap : transparent;
    border-radius: 2px;
    border-width: root.editing ? 1px : 0;
    border-color: Theme.cap-outline;
    function commit(restore-focus: bool) {
        if editor.text.is-float() { root.value = (editor.text.to-float() / 100).clamp(0, 1); }
        root.editing = false;
        root.closed(restore-focus);
    }
    public function begin-edit() {
        editor.text = "\{round(root.value * 100)}";
        root.editing = true;
        editor.focus();
        editor.select-all();
    }
    Text {
        visible: !root.editing;
        text: "\{round(root.value * 100)}%";
        color: Theme.value; font-family: Theme.value-font; font-size: 11px;
        horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%;
    }
    edit-scope := FocusScope {
        enabled: root.editing;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.editing = false; root.closed(true); return accept;
            }
            return reject;
        }
        editor := TextInput {
            x: 2px; width: parent.width - 4px; height: parent.height;
            enabled: root.editing; visible: root.editing;
            single-line: true;
            color: Theme.value; font-family: Theme.value-font; font-size: 11px;
            selection-background-color: Theme.value;
            selection-foreground-color: Theme.background;
            horizontal-alignment: center; vertical-alignment: center;
            accessible-label: "\{root.label} percentage";
            accepted => { root.commit(true); }
            changed has-focus => { if !self.has-focus && root.editing { root.commit(false); } }
        }
    }
    if !root.editing : TouchArea {
        clicked => { root.begin-edit(); }
        mouse-cursor: text;
    }
}
