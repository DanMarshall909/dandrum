import { DesignTokens } from "Theme.slint";
import { AboutSlint } from "std-widgets.slint";
import { FilterKnob } from "Knob.slint";
export struct BandNode { x: float, y: float }
export component FilterUi inherits Window {
    in property <length> viewport-width: 1080px;
    in property <length> viewport-height: 760px;
    width: root.viewport-width; height: root.viewport-height; background: DesignTokens.surface-window;
    default-font-family: DesignTokens.font-ui; default-font-size: DesignTokens.type-body;
    in property <string> response-command;
    in property <string> input-command;
    in property <string> output-command;
    in property <image> history;
    in property <[BandNode]> nodes;
    in property <[float]> meters;
    in property <[float]> knob-values;
    in property <[string]> knob-labels;
    in property <[string]> knob-texts;
    in property <int> selected: 1;
    in property <bool> bypassed;
    in property <bool> auditioning;
    in-out property <bool> about-open: false;
    out property <float> graph-left: graph.x / 1px;
    out property <float> graph-top: graph.y / 1px;
    out property <float> graph-width: graph.width / 1px;
    out property <float> graph-height: graph.height / 1px;
    out property <bool> frequency-value-visible: frequency-knob.value-visible;
    out property <float> frequency-knob-x: (frequency-knob.x + frequency-knob.width / 2) / 1px;
    out property <float> frequency-knob-y: (frequency-knob.y + frequency-knob.height / 2) / 1px;
    out property <float> about-button-x: (about-button.x + about-button.width / 2) / 1px;
    out property <float> about-button-y: (about-button.y + about-button.height / 2) / 1px;
    out property <float> about-close-x: root.width / 2px;
    out property <float> about-close-y: root.height / 2px + 85;
    callback node-gesture(int, int, float, float);
    callback knob-gesture(int, int, float);
    callback toggle(int);
    Text { x: 28px; y: 20px; text: "dandrum / filter lab"; color: DesignTokens.text-primary;
        font-family: DesignTokens.font-display; font-weight: 700; font-size: DesignTokens.type-brand; }
    Text { x: 28px; y: 49px; text: "STEREO FILTER  /  HIGH-PASS · BELL · LOW-PASS";
        color: DesignTokens.text-secondary; font-size: DesignTokens.type-micro; }
    for title[index] in ["Bypass", "Audition"]: Rectangle {
        private property <bool> active: (index == 0 && root.bypassed) || (index == 1 && root.auditioning);
        x: parent.width - 258px + index * 116px; y: 23px; width: 104px; height: 34px;
        border-radius: DesignTokens.radius-2; border-width: 1px; border-color: DesignTokens.border-control;
        background: self.active ? DesignTokens.color-selected : action.has-hover ? DesignTokens.surface-control-hover : DesignTokens.surface-control;
        Text { text: title; color: parent.active ? DesignTokens.surface-well : DesignTokens.text-primary; font-size: DesignTokens.type-label; horizontal-alignment: center; vertical-alignment: center; }
        action := TouchArea { clicked => { root.toggle(index); } }
    }
    graph := Rectangle {
        x: 54px; y: 93px; width: parent.width - 91px; height: parent.height - 450px;
        background: DesignTokens.surface-well; border-radius: DesignTokens.radius-1;
        border-width: 1px; border-color: DesignTokens.border-hairline;
        for row in 7: Rectangle {
            y: row * (parent.height - 1px) / 6; width: parent.width; height: 1px; background: DesignTokens.border-hairline;
        }
        for column in 11: Rectangle {
            x: column * (parent.width - 1px) / 10; width: 1px; height: parent.height; background: DesignTokens.border-hairline;
        }
        Path { width: 100%; height: 100%; viewbox-width: 1000; viewbox-height: 1000; fit: fill;
            commands: root.input-command; stroke: DesignTokens.color-waveform; stroke-width: 1px; }
        Path { width: 100%; height: 100%; viewbox-width: 1000; viewbox-height: 1000; fit: fill;
            commands: root.output-command; stroke: DesignTokens.color-waveform-region; stroke-width: 1.5px; }
        Path { width: 100%; height: 100%; viewbox-width: 1000; viewbox-height: 1000; fit: fill;
            commands: root.response-command; stroke: DesignTokens.color-value; stroke-width: DesignTokens.stroke-track; stroke-line-join: round; }
        for node[index] in root.nodes: Rectangle {
            x: node.x * parent.width - 12px; y: node.y * parent.height - 12px;
            width: 24px; height: 24px; border-radius: DesignTokens.radius-3;
            background: index == root.selected ? DesignTokens.color-selected : DesignTokens.color-value; border-width: 2px; border-color: DesignTokens.surface-well;
            Text { text: index == 0 ? "H" : index == 1 ? "B" : "L"; color: DesignTokens.surface-well;
                font-size: DesignTokens.type-micro; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.node-gesture(index, 0, node.x, node.y);
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        root.node-gesture(index, 2, node.x, node.y);
                    }
                }
                moved => { if (self.pressed) {
                    root.node-gesture(index, 1,
                        Math.clamp((self.mouse-x + parent.x + 12px) / graph.width, 0, 1),
                        Math.clamp((self.mouse-y + parent.y + 12px) / graph.height, 0, 1));
                } }
            }
        }
    }
    for text[index] in ["+18", "+9", "0", "−9", "−18", "−27", "−36"]: Text {
        x: 12px; y: 87px + index * (parent.height - 450px) / 6; width: 34px; text: text; font-family: DesignTokens.font-value; color: DesignTokens.text-secondary; font-size: DesignTokens.type-micro;
    }
    for text[index] in ["20 Hz", "63", "200", "630", "2k", "6.3k", "20k"]: Text {
        x: 54px + index * (parent.width - 120px) / 6; y: parent.height - 350px; text: text; font-family: DesignTokens.font-value; color: DesignTokens.text-secondary; font-size: DesignTokens.type-micro;
    }
    Text { x: 54px; y: parent.height - 323px; text: "OUTPUT SPECTROGRAM  /  TIME →"; color: DesignTokens.text-secondary; font-size: DesignTokens.type-micro; }
    Image { x: 54px; y: parent.height - 300px; width: parent.width - 91px; height: 65px; source: root.history; image-fit: fill; }
    frequency-knob := FilterKnob {
        x: 54px; y: parent.height - 213px; width: (parent.width - 298px) / 3; height: 183px;
        value: root.knob-values[0]; label: root.knob-labels[0]; value-text: root.knob-texts[0];
        gesture(phase, next) => { root.knob-gesture(0, phase, next); }
    }
    for index in [1, 2]: FilterKnob {
        x: 54px + index * ((parent.width - 298px) / 3 + DesignTokens.gap-control); y: parent.height - 213px;
        width: (parent.width - 298px) / 3; height: 183px;
        value: root.knob-values[index]; label: root.knob-labels[index]; value-text: root.knob-texts[index];
        gesture(phase, next) => { root.knob-gesture(index, phase, next); }
    }
    Rectangle {
        x: parent.width - 220px; y: parent.height - 213px; width: 183px; height: 183px; background: DesignTokens.surface-panel; border-radius: DesignTokens.radius-3;
        Text { y: 12px; width: parent.width; text: "IN L/R   ·   OUT L/R"; color: DesignTokens.text-secondary;
            font-size: DesignTokens.type-micro; horizontal-alignment: center; }
        for level[index] in root.meters: Rectangle {
            x: 28px + index * 34px; y: 43px; width: 19px; height: 112px; background: DesignTokens.surface-well;
            Rectangle { y: (1 - level) * parent.height; width: parent.width; height: level * parent.height;
                background: level > 0.95 ? DesignTokens.dd-error : DesignTokens.color-waveform-region; }
        }
    }
    Text { x: 54px; y: parent.height - 25px; text: "Drag a band or turn a control.";
        color: DesignTokens.text-tertiary; font-size: DesignTokens.type-micro; }
    about-button := Rectangle { x: parent.width - 157px; y: parent.height - 25px; width: 120px; height: 20px;
        Text { text: "About Slint"; color: DesignTokens.text-secondary; font-size: DesignTokens.type-micro; horizontal-alignment: center; }
        TouchArea { clicked => { root.about-open = true; } }
    }
    if root.about-open: Rectangle {
        background: DesignTokens.dd-scrim;
        Rectangle { x: (parent.width - 440px) / 2; y: (parent.height - 240px) / 2;
            width: 440px; height: 240px; background: DesignTokens.surface-control; border-radius: DesignTokens.radius-3;
            AboutSlint { x: 30px; y: 30px; width: 380px; height: 140px; }
            Rectangle { x: 170px; y: 190px; width: 100px; height: 30px; background: DesignTokens.color-selected;
                Text { text: "Close"; color: DesignTokens.text-primary; font-size: DesignTokens.type-label;
                    horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.about-open = false; } }
            }
        }
    }
}
